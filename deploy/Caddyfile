# Three names, one server. Caddy fetches and renews the certificates itself — passkeys only work in a secure context,
# so HTTPS is not optional here.
#
# The site (maia.city): the built SvelteKit site, static, from /srv/site (the deploy puts each build beside the last
# and switches a link). Hashed chunks keep their original URLs for at least 30 days, independently of the five
# rollback releases, so an open page can still navigate without losing its unlocked device. www goes to the bare name.
#
# The API (api.maia.city): the API.
#
# A header may be long (a relay's pass rides in a URL or a header): since 2.11, Caddy turns requests that long away
# (431) unless told to read more.
#
# HTTP/3 is off: it rides on UDP 443, which neither the compose file publishes nor the firewall opens. Caddy would
# still offer it in every answer (Alt-Svc), and a browser that takes the offer waits on QUIC that never answers before
# it falls back, as a page's node does on its first ask of the relay.
{
	servers {
		max_header_size 64KB
		protocols h1 h2
	}
}

# What every one of our names answers with: HTTPS only from now on, for a year, on each of these names (not on every
# subdomain, so a name we add later isn't locked out before it has a certificate; not on the browsers' preload list:
# that is a step taken by hand, and hard to undo); no file read as another type than it says;
# no full address sent on to another site.
(walls) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

{$SITE_ADDRESS:maia.city} {
	root * /srv/site/current
	encode zstd gzip
	# the page's own walls (code-architecture/security-audit.md F3): no other site may frame us (a click on Accept in a
	# frame we can't see), no file is read as another type than it says, no plugin objects, no <base> moving our links.
	# Which scripts a page may run comes in the page itself, a <meta> SvelteKit writes with each page's own hashes
	# (aven/kernel/sandbox/policy.js pageCsp): frame-ancestors can't be said in a <meta>, so it stays here.
	# Permissions-Policy turns off what no page of ours uses (the camera, the microphone, where you are, a payment, a
	# device on a port); a passkey, the clipboard, full screen and what Bunny's player is handed stay as the browser
	# has them.
	import walls
	header {
		Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=(), display-capture=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), midi=(), magnetometer=(), xr-spatial-tracking=(), idle-detection=(), local-fonts=(), otp-credentials=(), browsing-topics=()"
	}
	# hashed chunks never change; pages are looked at again
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@pages not path /_app/immutable/*
	header @pages Cache-Control "public, max-age=0, must-revalidate"
	# Only hashed build assets use the shared 30-day window. The current fallback lets this
	# config roll out before the first publisher backfills the retained assets.
	handle @immutable {
		route {
			file_server {
				root /srv/site/assets
				pass_thru
			}
			file_server
		}
	}
	handle {
		try_files {path} {path}/index.html {path}.html
		file_server
	}
	handle_errors 404 {
		# A missing chunk must not become an immutable cached error before it is available.
		header Cache-Control "no-store"
		rewrite * /404.html
		file_server
	}
}

www.{$SITE_ADDRESS:maia.city} {
	import walls
	redir https://{$SITE_ADDRESS:maia.city}{uri} permanent
}

{$API_ADDRESS} {
	import walls
	handle {
		encode zstd gzip
		reverse_proxy api:3000
	}
}

# >>> aven.maia.city
# The Aven Peer (aven/DB2/PRODUCTION.md, Part B). Its own deploy puts this block, from
# the line above to the line below, into the server's Caddyfile in place of its last copy, and leaves every other line
# as it is. The Aven Peer runs in its own compose project (/opt/aven), on this Caddy's network, its relay's HTTP port
# reachable only there:
#   /relay /ping /healthz /generate_204   iroh's relay (iroh-relay 1.4.1: the WebSocket, its latency probe, health,
#                                         the captive-portal check)
#   /aven.json                            which Aven Peer this host is in front of, for avenOS: its key and the
#                                         passkeys' RP ID, written by the deploy beside the builds
#   everything else                       avenOS's released build (@aven/os, aven-os-web-<version>.tar.gz), in
#                                         site/aven/current, unpacked by the deploy
{$AVEN_ADDRESS:aven.maia.city} {
	import walls
	@relay path /relay /ping /healthz /generate_204
	handle @relay {
		reverse_proxy aven-peer:3340
	}
	handle /aven.json {
		root * /srv/site/aven
		header Content-Type application/json
		header Cache-Control no-store
		file_server
	}
	handle {
		root * /srv/site/aven/current
		encode zstd gzip
		# Vite's hashed chunks never change; the page is looked at again
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "public, max-age=0, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}
# <<< aven.maia.city

# >>> play.maia.city (play/SPEC.md): the three sandboxes and the asset library on Postgres, one container that
# serves its site and its /api (play/docker-compose.play.yml, play-api). Added beside legacy, which it doesn't change.
{$PLAY_ADDRESS:play.maia.city} {
	import walls
	header {
		Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=()"
	}
	encode zstd gzip
	reverse_proxy play-api:3000
}
# <<< play.maia.city
