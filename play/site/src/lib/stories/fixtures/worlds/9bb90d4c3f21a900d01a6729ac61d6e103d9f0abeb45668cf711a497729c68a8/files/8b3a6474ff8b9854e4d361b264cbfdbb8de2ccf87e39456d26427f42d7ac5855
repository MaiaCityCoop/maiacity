	const gm = (g0 + g1) / 2, gh = g1 - g0;
	b.add('rubber', box(2 * W - 0.19, gh + 0.08, 0.02, [0, gm, zAt(gm) + 0.006], { rx: rake, seg: 1 }));
	b.add('glass', box(2 * W - 0.29, gh, 0.02, [0, gm, zAt(gm) + 0.014], { rx: rake, seg: 1 }));
	b.add('plastic', box(2 * W - 0.15, 0.05, 0.26, [0, g1 + 0.1, zAt(g1 + 0.1) + 0.04], { rx: 0.25, seg: 1 }));
	// the grille between the bumper and the glass
	const gr0 = o.bumper + 0.12, gr1 = g0 - 0.2;
	b.add('plastic', box(2 * W - 0.55, gr1 - gr0, 0.03, [0, (gr0 + gr1) / 2, zf], { seg: 1 }));
	const n = Math.max(2, Math.round((gr1 - gr0) / 0.14));
	for (let i = 0; i < n; i++) b.add('chassis', box(2 * W - 0.65, 0.05, 0.03, [0, gr0 + 0.08 + (i * (gr1 - gr0 - 0.16)) / (n - 1), zf + 0.018], { seg: 1 }));
	for (const s of [1, -1]) {
		const wz = Math.min(0.9, depth - 0.75);
		b.add('glass', box(0.02, gh * 0.75, wz, [s * (W + 0.002), gm + 0.04, zf - 0.23 - wz / 2], { seg: 1 }));
		b.add('chassis', box(0.012, roof - bottom - 0.4, 0.012, [s * (W + 0.004), (roof + bottom) / 2 - 0.1, zf - 1.2], { seg: 1 }));
		b.add('plastic', box(0.03, 0.04, 0.2, [s * (W + 0.01), g0 + 0.05, zf - 1.05], { seg: 1 }));
		// mirrors on their arms
		b.add('steel', rod([s * W, g1 + 0.07, zf - 0.22], [s * (W + 0.18), g1 + 0.07, zf - 0.08], 0.018, 6));
		b.add('steel', rod([s * W, g0 + 0.3, zf - 0.22], [s * (W + 0.18), g0 + 0.3, zf - 0.08], 0.018, 6));
		b.add('plastic', box(0.07, 0.52, 0.24, [s * (W + 0.2), g1 - 0.28, zf - 0.08], { seg: 1 }));
		// the steps behind the front wheel and the arch's mudguard
		const zw = zFA - wheelR - 0.03;
		b.add('plastic', span([s * (W - 0.24), 0.42, zb + 0.03], [s * (W - 0.04), 0.47, Math.min(zw, zb + 0.3)]));
		b.add('plastic', span([s * (W - 0.24), 0.78, zb + 0.03], [s * (W - 0.04), 0.83, Math.min(zw, zb + 0.3)]));
		b.add('rubber', span([s * (W - 0.4), 0.2, zw - 0.03], [s * W, bottom - 0.1, zw]));
		b.add('plastic', span([s * (W - 0.42), bottom - 0.12, zw], [s * W, bottom + 0.01, zFA + wheelR * 0.75]));
		b.lamp(s > 0 ? 'light:indicator-l' : 'light:indicator-r', box(0.02, 0.05, 0.1, [s * (W + 0.01), bottom + 0.16, zf - 0.55], { seg: 1 }));
		b.add('lensAmber', box(0.08, 0.04, 0.05, [s * (W - 0.3), roof + 0.01, zf - 0.6], { seg: 1 }));
	}
	// the bumper, its headlights and indicators in its top corners, the air dam under it
	const bt = o.bumper;
	b.add('plastic', span([-(W - 0.01), 0.42, zf - 0.4], [W - 0.01, bt, zf + 0.04]));
	b.add('chassis', span([-(W - 0.35), 0.3, zf - 0.35], [W - 0.35, 0.42, zf - 0.05]));
	pair(b, 'light:head', W - 0.42, bt - 0.16, zf + 0.045, 0.4, 0.16, 0.02);
	b.lamp('light:indicator-l', box(0.13, 0.13, 0.02, [W - 0.12, bt - 0.16, zf + 0.045], { seg: 1 }));
	b.lamp('light:indicator-r', box(0.13, 0.13, 0.02, [-(W - 0.12), bt - 0.16, zf + 0.045], { seg: 1 }));
	return zb;
}

/* ============================================================================================================
 * PART 2 · THE TIPPER — a 32 t 8×4 rigid tipper, two steered axles at its front and two driven at its back, a steel
 * body that tips backwards on a hinge over its last axle: the construction lorry of the old city, its paint faded,
 * its body scraped and dented, mud to its windows.
 *
 * Measures (EU 96/53/EC and the trade's data of 8×4 construction tippers; metres):
 *   9.30 long, 2.55 wide (2.88 over the mirrors), 3.30 high to its cab roof (the body's sides 2.85);
 *   front overhang 1.45, axles 1.95, 3.05 and 1.37 apart, rear overhang 1.48; a day cab 1.80 deep, roof 3.30;
 *   the body 6.30 long, 2.45 wide, its floor 1.55 up, its sides 1.30 high, about 20 m³, a tailgate hung from its
 *   top; a telescopic ram behind the cab; tyres 315/80 R22.5 (1.08 across), twin on the rear axles.
 *   Masses: about 12.5 t empty, 32 t laden (about 19 t of gravel at 1.6–1.8 t/m³, ~11 m³: it is full by mass long
 *   before it is full by volume).
 * Articulation: the group `tipper` pivots about x at its hinge (rotation.x > 0 lifts its front, up to about 0.85).
 * ============================================================================================================ */

const TP = {
	FO: 1.45, A: [1.95, 3.05, 1.37], RO: 1.48, CAB: 1.8,
	half: 1.225, floor: 1.55, side: 1.3, body: 6.3,
	tyre: { D: 1.076, W: 0.315, rim: 0.5715 },
};
TP.L = TP.FO + TP.A[0] + TP.A[1] + TP.A[2] + TP.RO;
TP.zF = TP.L / 2;
TP.z = [TP.zF - TP.FO];
for (const d of TP.A) TP.z.push(TP.z[TP.z.length - 1] - d);
TP.zR = -TP.L / 2;
TP.zB1 = TP.zR + 0.3; // the body's back (its tailgate)
TP.zB0 = TP.zB1 + TP.body; // its front
TP.hinge = [0, TP.floor - 0.12, TP.zB1 + 0.25];

/** a heap of what it carries: a grid over the body's floor, struck near its sides and heaped along its middle */
function heap(x0, x1, z0, z1, y, top, seed) {
	const g = new THREE.PlaneGeometry(x1 - x0, z1 - z0, 8, 16);
	g.rotateX(-Math.PI / 2);
	g.translate((x0 + x1) / 2, 0, (z0 + z1) / 2);
	const pos = g.attributes.position;
	const s = Math.floor(chance('heap', seed)() * 100);
	for (let i = 0; i < pos.count; i++) {
		const x = pos.getX(i), z = pos.getZ(i);
		const u = (x - x0) / (x1 - x0), v = (z - z0) / (z1 - z0);
		const across = Math.sin(Math.PI * u), along = Math.min(1, Math.sin(Math.PI * v) * 1.6);
		pos.setY(i, y + top * across * along + 0.06 * noise3(x * 2.5, 0, z * 2.5, s) * across);
	}
	g.computeVertexNormals();
	return g;
}

function tipper(m, seed, load) {
	const T = TP, H = T.half, R = T.tyre.D / 2, y0 = T.floor, y1 = T.floor + T.side;
	const b = new Body('tipper-truck', seed, m, {
		wear: { spray: 0.75, soot: (p) => smooth(0.7, 0.3, p.y) * smooth(0.5, 0.0, Math.hypot(p.x - 0.95, p.z - (T.z[1] - 0.9))) },
	});
	const zb = cabOver(b, { zf: T.zF, depth: T.CAB, half: 1.24, bottom: 1.08, glass: [1.82, 2.68], roof: 3.3, deflector: 0, zFA: T.z[0], wheelR: R, bumper: 1.08 });
	// the second steered axle's mudguards and flaps
	for (const s of [1, -1]) {
		b.add('plastic', span([s * 0.8, 1.14, T.z[1] - R * 0.75], [s * 1.24, 1.19, T.z[1] + R * 0.75]));
		b.add('rubber', span([s * 0.85, 0.28, T.z[1] - R - 0.06], [s * 1.22, 1.14, T.z[1] - R - 0.03]));
	}
	// a stone guard over the lamps, a builder's lorry's
	for (const s of [1, -1]) b.add('chassis', box(0.48, 0.02, 0.02, [s * 0.82, 0.98, T.zF + 0.07], { seg: 1 }));

	// the chassis: two deep rails, four axles, the drive axles' differentials, the propshafts
	for (const s of [1, -1]) b.add('chassis', span([s * 0.36, 0.75, T.zR + 0.15], [s * 0.46, 1.12, T.zF - 0.38]));
	T.z.forEach((z, i) => {
		b.add('chassis', rod([-0.98, R, z], [0.98, R, z], i < 2 ? 0.07 : 0.09, 8));
		if (i >= 2) b.add('chassis', box(0.42, 0.42, 0.38, [0, R + 0.02, z], { seg: 1 }));
	});
	b.add('chassis', rod([0, 0.62, T.z[2] + 0.2], [0, 0.78, T.z[0] - 0.9], 0.05, 6));
	b.add('chassis', rod([0, 0.6, T.z[3] + 0.2], [0, 0.6, T.z[2] - 0.2], 0.05, 6));
	b.add('chassis', span([-0.5, 0.62, T.z[1] + 0.6], [0.5, 1.05, zb + 0.15]));
	// the rear bogie's leaf springs, the subframe under the body, the ram behind the cab
	for (const s of [1, -1]) b.add('chassis', span([s * 0.4, 0.62, T.z[3] - 0.7], [s * 0.52, 0.78, T.z[2] + 0.7]));
	for (const s of [1, -1]) b.add('chassis', span([s * 0.4, 1.12, T.zB1 + 0.2], [s * 0.5, y0 - 0.12, T.zB0 - 0.1]));
	b.add('steel', rod([0, 1.15, T.zB0 + 0.22], [0, y0 + 0.4, T.zB0 + 0.22], 0.11, 10));
	// tanks, the silencer and its tailpipe pointing up behind the cab (so the dust is not blown up)
	b.add('steel', span([-1.15, 0.5, T.z[2] + 0.75], [-0.55, 1.05, T.z[1] - 0.55]));
	b.add('chassis', span([0.55, 0.45, T.z[2] + 0.75], [1.15, 0.95, T.z[2] + 1.35]));
	b.add('steel', rod([0.8, 0.6, T.z[1] - 0.6], [0.8, 0.6, T.z[1] - 1.25], 0.12, 8));
	b.add('steel', rod([0.98, 0.6, zb - 0.12], [0.98, 3.35, zb - 0.12], 0.055, 8));
	// the side guards between the axle groups, mudguards over the rear wheels, the rear underrun guard and lamps
	for (const s of [1, -1]) {
		for (const y of [0.5, 0.8]) b.add('steel', span([s * (H - 0.06), y, T.z[2] + R + 0.2], [s * H, y + 0.08, T.z[1] - R - 0.15]));
		b.add('plastic', span([s * 0.6, 1.16, T.z[3] - 0.62], [s * 1.25, 1.2, T.z[2] + 0.62]));
		b.add('rubber', span([s * 0.6, 0.28, T.z[3] - 0.66], [s * 1.22, 1.16, T.z[3] - 0.63]));
	}
	b.add('steel', span([-1.1, 0.42, T.zR + 0.02], [1.1, 0.58, T.zR + 0.14]));
	b.add('chassis', span([-1.2, 0.85, T.zR + 0.02], [1.2, 1.05, T.zR + 0.14]));
	pair(b, 'light:tail', 0.66, 0.95, T.zR, 0.15, 0.13, 0.02);
	pair(b, 'light:brake', 0.82, 0.95, T.zR, 0.15, 0.13, 0.02);
	b.lamp('light:indicator-l', box(0.15, 0.13, 0.02, [0.98, 0.95, T.zR], { seg: 1 }));
	b.lamp('light:indicator-r', box(0.15, 0.13, 0.02, [-0.98, 0.95, T.zR], { seg: 1 }));

	// the body, on its hinge: its floor, sides with their ribs, the headboard with its canopy over the cab, the
	// tailgate hung from its top; what it carries heaped in it
	const body = new Body('tipper', seed, m, { wear: { spray: 0.75 } });
	const z0 = T.zB0, z1 = T.zB1;
	body.add('paint2', span([-H, y0, z1], [H, y0 + 0.08, z0]));
	for (const s of [1, -1]) {
		body.add('paint2', span([s * (H - 0.05), y0, z1], [s * H, y1, z0], { seg: 3 }));
		body.add('paint2', span([s * (H - 0.06), y1 - 0.1, z1], [s * (H + 0.04), y1, z0]));
		for (let z = z1 + 0.6; z < z0 - 0.3; z += 0.9) body.add('paint2', span([s * H, y0, z - 0.04], [s * (H + 0.04), y1 - 0.1, z + 0.04]));
		body.add('chassis', span([s * (H - 0.02), y0 - 0.12, z1], [s * (H + 0.02), y0, z0])); // its bottom rail
	}
	body.add('paint2', span([-H, y0, z0 - 0.08], [H, y1 + 0.25, z0]));
	body.add('paint2', profile([[z0, y1 + 0.22], [z0 + 0.75, y1 + 0.26], [z0 + 0.75, y1 + 0.21], [z0, y1 + 0.15]], -H + 0.1, H - 0.1, 0));
	body.add('paint2', span([-H + 0.04, y0 + 0.05, z1 - 0.06], [H - 0.04, y1, z1]));
	for (const x of [-0.8, 0, 0.8]) body.add('paint2', span([x - 0.04, y0 + 0.05, z1 - 0.1], [x + 0.04, y1, z1 - 0.06]));
	for (const s of [1, -1]) body.add('chassis', rod([s * (H + 0.02), y1 - 0.05, z1 + 0.02], [s * (H + 0.08), y1 - 0.05, z1 - 0.02], 0.05, 8));
	if (load) body.add('load', heap(-H + 0.05, H - 0.05, z1 + 0.05, z0 - 0.1, y0 + 0.55 * T.side, load.top, seed));
	b.carry(body, T.hinge);

	const rim = [0.4, 0.4, 0.38];
	b.wheel('1-l', [1.0, R, T.z[0]], { ...T.tyre, rimColour: rim });
	b.wheel('1-r', [-1.0, R, T.z[0]], { ...T.tyre, rimColour: rim });
	b.wheel('2-l', [1.0, R, T.z[1]], { ...T.tyre, rimColour: rim });
	b.wheel('2-r', [-1.0, R, T.z[1]], { ...T.tyre, rimColour: rim });
	for (const i of [3, 4]) {
		b.wheel(`${i}-l`, [0.9, R, T.z[i - 1]], { ...T.tyre, dual: true, rimColour: rim });
		b.wheel(`${i}-r`, [-0.9, R, T.z[i - 1]], { ...T.tyre, dual: true, rimColour: rim });
	}
	return b;
}

/* ============================================================================================================
 * PART 3 · THE RECIPE
 * ============================================================================================================ */

/** empty, or loaded with gravel or earth heaped over the sides' middle */
const VARIANTS = {
	empty: { label: 'Empty', load: null },
	gravel: { label: 'Gravel', load: { colour: '#7e7a72', top: 0.75 } },
	earth: { label: 'Earth', load: { colour: '#5a4836', top: 0.85 } },
};
const PAINT = { paint: '#a0683a', paint2: '#6f716c' };

const FACTS = {
	length: TP.L, width: { body: 2.55, mirrors: 2.88 }, height: { cab: 3.3, body: TP.floor + TP.side }, unit: 'm',
	frontOverhang: TP.FO, axleSpacing: TP.A, rearOverhang: TP.RO, axles: '8×4: two steered at the front, two driven at the back',
	body: { length: TP.body, width: 2.45, floor: TP.floor, sides: TP.side, volume: 20, tipAngle: 50, unit: 'm, m³, °' },
	tyres: '315/80 R22.5, twin on the rear axles',
	mass: { empty: 12500, laden: 32000, unit: 'kg' },
	engine: 'diesel six, about 11–13 L, 300–350 kW',
	articulation: 'the group `tipper` turns about x at its hinge over the last axle (rotation.x up to about 0.85 rad lifts its front)',
	sources: 'Directive 96/53/EC (32 t four-axle rigid, 2.55 m); ETRTO tyre sizes; UN R58 / R73; trade data of 8×4 construction tippers with 18–20 m³ steel bodies',
};

function build(variant = 'empty') {
	const V = VARIANTS[variant] ?? VARIANTS.empty;
	const m = materials(grimePicture(`tipper-${variant}`), PAINT);
	if (V.load) m.tint.load = new THREE.Color(V.load.colour);
	const root = tipper(m, variant, V.load).build([0, 0, 0]);
	root.name = 'tipper-truck';
	return root;
}

module.exports.recipe = function (id, v, variant) {
	const name = variant ?? 'empty';
	if (!VARIANTS[name]) throw new Error(`no variant ${name} of machines/${id}@${v}`);
	return {
		meta: {
			group: 'machines',
			id,
			version: v,
			variant: name,
			label: `Tipper truck: ${VARIANTS[name].label}`,
			note: 'A worn 32 t 8×4 tipper, 9.3 × 2.55 × 3.3 m, its steel body on a hinge (the group `tipper`, turned about x). Lights named for the page (light:head, tail, brake, indicator-l, indicator-r), wheels as pivots (wheel:<axle>-<l|r>).',
			from: 'Old City: the streets and the highway',
			facts: JSON.parse(JSON.stringify(FACTS)),
			params: [],
		},
		build: () => build(name),
	};
};
module.exports.variants = Object.keys(VARIANTS);
module.exports.build = build;

return module.exports.recipe("tipper-truck", 3, "gravel");
});
