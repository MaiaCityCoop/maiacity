			const [ax, ay] = pts[i - 1], [bx, by] = pts[i];
			const x0 = Math.floor(Math.min(ax, bx) - r - 1), x1 = Math.ceil(Math.max(ax, bx) + r + 1);
			const y0 = Math.floor(Math.min(ay, by) - r - 1), y1 = Math.ceil(Math.max(ay, by) + r + 1);
			const dx = bx - ax, dy = by - ay, ll = dx * dx + dy * dy || 1e-9;
			for (let y = y0; y <= y1; y++)
				for (let x = x0; x <= x1; x++) {
					const t = clamp(((x + 0.5 - ax) * dx + (y + 0.5 - ay) * dy) / ll);
					const d = Math.hypot(ax + t * dx - x - 0.5, ay + t * dy - y - 0.5);
					this.lay(x, y, c, clamp(r + 0.5 - d));
				}
		}
	}
	/** a filled polygon `pts` (pixels) */
	fill(pts, color) {
		const c = new THREE.Color(color).toArray();
		const xs = pts.map((p) => p[0]), ys = pts.map((p) => p[1]);
		for (let y = Math.floor(Math.min(...ys)); y <= Math.ceil(Math.max(...ys)); y++)
			for (let x = Math.floor(Math.min(...xs)); x <= Math.ceil(Math.max(...xs)); x++) {
				// four samples a pixel for soft edges
				let k = 0;
				for (const [sx, sy] of [[0.25, 0.25], [0.75, 0.25], [0.25, 0.75], [0.75, 0.75]]) if (inside(pts, x + sx, y + sy)) k += 0.25;
				this.lay(x, y, c, k);
			}
	}
	/** a line of text, its cap height `cap` pixels, its middle at (cx, by): its baseline at by */
	text(s, cx, by, cap, color, weight = 0.15) {
		const u = cap / 6;
		const gap = 1.3;
		const width = [...s].reduce((sum, ch) => sum + glyph(ch).w + gap, -gap) * u;
		let x = cx - width / 2;
		for (const ch of s) {
			const g = glyph(ch);
			for (const line of g.s) this.stroke(line.map(([gx, gy]) => [x + gx * u, by + gy * u]), cap * weight, color);
			x += (g.w + gap) * u;
		}
		return width;
	}
	/** a border of width `b` pixels, `inset` in from the edge, round corners of radius `rr` */
	border(b, inset, rr, color) {
		const x0 = inset, y0 = inset, x1 = this.w - 1 - inset, y1 = this.h - 1 - inset;
		const pts = [];
		const corner = (cx, cy, a0) => {
			for (let i = 0; i <= 4; i++) {
				const a = a0 + (i / 4) * (Math.PI / 2);
				pts.push([cx + rr * Math.cos(a), cy + rr * Math.sin(a)]);
			}
		};
		corner(x1 - rr, y0 + rr, -Math.PI / 2);
		corner(x1 - rr, y1 - rr, 0);
		corner(x0 + rr, y1 - rr, Math.PI / 2);
		corner(x0 + rr, y0 + rr, Math.PI);
		pts.push(pts[0]);
		this.stroke(pts, b, color);
	}
	/** age it: the colour faded toward grey, dark streaks running down from the top, a dirty foot, by the seed */
	age(seed, fade = 0.25, dirt = 0.35) {
		const o = chance(seed, 'sign')() * 100;
		for (let y = 0; y < this.h; y++)
			for (let x = 0; x < this.w; x++) {
				const i = (y * this.w + x) * 3;
				const v = y / this.h, u = x / this.w;
				const streak = smooth(0.55, 0.9, noise3(u * 40 + o, v * 2.5, 0.5)) * smooth(0.1, 0.6, v);
				const foot = smooth(0.25, 0, v) * (0.6 + 0.4 * noise3(u * 25 + o, v * 12, 3.1));
				const blot = fbm(u * 8 + o, v * 4, 7.7) - 0.5;
				const dark = clamp(dirt * (0.45 * streak + 0.6 * foot + 0.3 * blot));
				const grey = (this.px[i] + this.px[i + 1] + this.px[i + 2]) / 3;
				for (let j = 0; j < 3; j++) this.px[i + j] = (this.px[i + j] + (grey * 0.95 + 0.04 - this.px[i + j]) * fade) * (1 - dark);
			}
		return this;
	}
	/** the picture as a texture (sRGB, mipmapped) */
	texture() {
		const data = new Uint8Array(this.w * this.h * 4);
		// the pixels are linear colours (as THREE.Color holds them), stored as sRGB
		const srgb = (x) => Math.round(255 * clamp(x <= 0.0031308 ? 12.92 * x : 1.055 * Math.pow(x, 1 / 2.4) - 0.055));
		for (let i = 0; i < this.w * this.h; i++) data.set([srgb(this.px[i * 3]), srgb(this.px[i * 3 + 1]), srgb(this.px[i * 3 + 2]), 255], i * 4);
		const t = new THREE.DataTexture(data, this.w, this.h, THREE.RGBAFormat);
		t.colorSpace = THREE.SRGBColorSpace;
		t.magFilter = THREE.LinearFilter;
		t.minFilter = THREE.LinearMipmapLinearFilter;
		t.generateMipmaps = true;
		t.anisotropy = 4;
		t.needsUpdate = true;
		return t;
	}
}
/** is (x, y) inside the polygon (even-odd) */
function inside(pts, x, y) {
	let c = false;
	for (let i = 0, j = pts.length - 1; i < pts.length; j = i++) {
		const [xi, yi] = pts[i], [xj, yj] = pts[j];
		if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) c = !c;
	}
	return c;
}
/** an arrow, `len` long and pointing at `angle` (radians, 0 = up), its middle at (cx, cy), in pixels */
function arrow(len, angle, cx, cy) {
	const s = len / 10;
	const shape = [[-1, -5], [1, -5], [1, 1], [3, 1], [0, 5], [-3, 1], [-1, 1]];
	const c = Math.cos(angle), n = Math.sin(angle);
	return shape.map(([x, y]) => [cx + (x * c + y * n) * s, cy + (-x * n + y * c) * s]);
}

/*
 * ============================================================================================================
 * PART 2 · THE BILLBOARD — a roadside monopole billboard: a steel column 1.0 m at its foot tapering to 0.7 m, a
 * head frame of steel sections carrying a 12 × 4 m face (the European large format; the US bulletin is 14.6 × 4.3 m)
 * 10 m up, a catwalk with its rail along its foot, and four old floodlights on arms. Its poster is a generic,
 * faded advertisement of no brand: a dark car on a washed-out sunset and the word MORE, its paper sun-bleached,
 * streaked, torn in places down to the grey paper and an older blue poster under it. Facing +z.
 * ============================================================================================================
 */

/** the measures, in metres */
const BB = {
	face: [12, 4], // the face, width × height
	foot: 10, // its foot over the ground
	column: { rFoot: 0.5, rTop: 0.35 },
	depth: 0.9, // from the face back to the column's middle
	catwalk: { d: 0.9, rail: 1.05 },
	lights: [-4.5, -1.5, 1.5, 4.5], // the floodlights along the catwalk (x)
	ppm: 64, // the poster's pixels a metre
};
const BB_C = { steel: '#6f716d', column: '#7a7c77', back: '#5f615d', grating: '#55574f', lamp: '#d8d4c8' };
const LIT_ON = 1.8;

/** the poster: an advert of no brand, faded and torn, as a picture */
function poster(seed) {
	const P = BB.ppm, [W, H] = BB.face;
	const pic = new Picture(Math.round(W * P), Math.round(H * P), '#e9a46a');
	// a sunset of bands, orange low to a pink-violet top
	const sky = ['#f2a25c', '#ef9563', '#e7876c', '#d97a7c', '#c06f8c', '#9a6a98'];
	sky.forEach((c, i) => pic.fill([[0, (i * H * P) / sky.length], [W * P, (i * H * P) / sky.length], [W * P, H * P], [0, H * P]], c));
	// a low sun, and the road's horizon
	const sun = [];
	for (let i = 0; i <= 24; i++) sun.push([3.6 * P + Math.cos((i / 24) * Math.PI) * 0.9 * P, 1.2 * P + Math.sin((i / 24) * Math.PI) * 0.9 * P]);
	pic.fill(sun, '#ffd38a');
	pic.fill([[0, 0], [W * P, 0], [W * P, 1.2 * P], [0, 1.2 * P]], '#7a6c74');
	// a generic saloon car, side on, dark on the light
	const car = [[0.3, 0.55], [0.45, 0.95], [1.6, 1.1], [2.5, 1.75], [4.3, 1.8], [5.3, 1.2], [6.4, 1.05], [6.6, 0.6], [6.2, 0.45], [0.6, 0.45]].map(([x, y]) => [(x + 0.4) * P, (y + 0.15) * P]);
	pic.fill(car, '#6a1f26');
	pic.fill([[2.9, 1.25], [3.25, 1.65], [4.15, 1.68], [4.85, 1.25]].map(([x, y]) => [(x + 0.4) * P, (y + 0.15) * P]), '#251f2a');
	for (const wx of [1.6, 5.3]) {
		const wheel = [];
		for (let i = 0; i < 16; i++) wheel.push([(wx + 0.4) * P + Math.cos((i / 16) * 2 * Math.PI) * 0.45 * P, 0.6 * P + Math.sin((i / 16) * 2 * Math.PI) * 0.45 * P]);
		pic.fill(wheel, '#121116');
	}
	// the words: MORE, and its line under it
	pic.text('MORE', 8.9 * P, 1.8 * P, 1.35 * P, '#ffffff', 0.2);
	pic.text('FASTER BIGGER NOW', 8.9 * P, 0.7 * P, 0.32 * P, '#ffe9c9', 0.17);
	// torn: a few tongues of the paper gone along its seams and edges, down to the grey backing or an older blue poster
	const rnd = chance(seed, 'torn');
	for (let i = 0; i < 4; i++) {
		const x = 2 * Math.round(rnd() * 6), y = rnd() < 0.5 ? H - rnd() * 0.6 : rnd() * H, w = 0.25 + rnd() * 0.6, h = 0.4 + rnd() * 1.1;
		const ragged = [];
		for (let k = 0; k < 14; k++) {
			const a = (k / 14) * 2 * Math.PI;
			const r = 0.7 + rnd() * 0.45;
			ragged.push([(x + Math.cos(a) * (w / 2) * r) * P, (y - h / 2 + Math.sin(a) * (h / 2) * r) * P]);
		}
		pic.fill(ragged, rnd() < 0.6 ? '#bdb9ae' : '#4a6a8f');
	}
	// the panel seams of the paper, every 2 m across
	for (let x = 2; x < W; x += 2) pic.stroke([[x * P, 0], [x * P, H * P]], 1.2, '#8a7f78');
	return pic.age(`${seed}:poster`, 0.5, 0.55).texture();
}

function billboard(bag) {
	const [W, H] = BB.face, C = BB.column;
	const zf = BB.depth; // the face's plane
	const top = BB.foot + H;
	// the column on its base plate (its foundation is under the ground)
	bag.add('column', 'paint', box(1.5, 0.05, 1.5, [0, 0.025, 0]), BB_C.steel, 0.9);
	bag.add('column', 'paint', cyl(C.rTop, C.rFoot, BB.foot + H / 2 - 0.05, 16, [0, 0.05, 0]), BB_C.column, 0.65);
	bag.add('column', 'paint', box(0.3, 0.6, 0.02, [0, 0.8, C.rFoot - 0.02]), BB_C.steel); // its hand hole
	// the head frame: a cross arm on the column, uprights behind the face, rails across
	bag.add('frame', 'paint', box(W * 0.7, 0.5, 0.4, [0, BB.foot + H / 2, 0]), BB_C.steel);
	for (let i = 0; i <= 6; i++) {
		const x = -W / 2 + 0.2 + ((W - 0.4) * i) / 6;
		bag.add('frame', 'paint', box(0.16, H + 0.6, 0.16, [x, BB.foot + H / 2, zf - 0.25]), BB_C.steel);
		bag.add('frame', 'paint', box(0.1, 0.1, zf - 0.3, [x, BB.foot + H / 2, (zf - 0.3) / 2 + 0.05]), BB_C.steel);
	}
	for (const y of [BB.foot + 0.3, BB.foot + H / 2, top - 0.3]) bag.add('frame', 'paint', box(W, 0.12, 0.12, [0, y, zf - 0.11]), BB_C.steel);
	// the face's back sheet and its trim
	bag.add('frame', 'paint', box(W, H, 0.04, [0, BB.foot + H / 2, zf - 0.03]), BB_C.back);
	for (const [x, y, w, h] of [[0, top + 0.06, W + 0.24, 0.12], [0, BB.foot - 0.06, W + 0.24, 0.12], [-W / 2 - 0.06, BB.foot + H / 2, 0.12, H], [W / 2 + 0.06, BB.foot + H / 2, 0.12, H]])
		bag.add('frame', 'paint', box(w, h, 0.1, [x, y, zf + 0.02]), BB_C.steel);
	bag.add('face', 'paper', plate(W, H, [0, BB.foot + H / 2, zf + 0.002]), '#ffffff', 0);
	// the catwalk along its foot: a grating on brackets, its rail
	const cz = zf + BB.catwalk.d / 2, cy = BB.foot - 0.25;
	bag.add('catwalk', 'paint', box(W + 0.4, 0.05, BB.catwalk.d, [0, cy, cz]), BB_C.grating);
	for (let i = 0; i <= 6; i++) {
		const x = -W / 2 + 0.2 + ((W - 0.4) * i) / 6;
		bag.add('catwalk', 'paint', box(0.08, 0.08, BB.catwalk.d + 0.3, [x, cy - 0.07, cz - 0.15]), BB_C.steel);
		bag.add('catwalk', 'paint', rod([x, cy, zf + BB.catwalk.d], [x, cy + BB.catwalk.rail, zf + BB.catwalk.d], 0.02, 0.02, 6), BB_C.steel);
	}
	for (const h of [BB.catwalk.rail, BB.catwalk.rail / 2]) bag.add('catwalk', 'paint', rod([-W / 2 - 0.2, cy + h, zf + BB.catwalk.d], [W / 2 + 0.2, cy + h, zf + BB.catwalk.d], 0.02, 0.02, 6), BB_C.steel);
	// four floodlights on arms out over the catwalk, aimed up at the face
	const lamps = [];
	BB.lights.forEach((x, k) => {
		const arm0 = [x, cy + 0.1, zf + BB.catwalk.d], arm1 = [x, cy + 0.5, zf + 1.9];
		bag.add('lights', 'paint', rod(arm0, arm1, 0.025, 0.025, 6), BB_C.steel);
		const head = box(0.45, 0.14, 0.32, [0, 0, 0]);
		head.rotateX(0.75);
		head.translate(arm1[0], arm1[1] + 0.06, arm1[2]);
		bag.add('lights', 'paint', head, BB_C.steel);
		const glass = plate(0.38, 0.26, [0, 0, 0], [-Math.PI / 2 - 0.75 + Math.PI, 0, 0]);
		glass.translate(arm1[0], arm1[1] + 0.06 + Math.cos(0.75) * 0.075, arm1[2] - Math.sin(0.75) * 0.075 - 0.01);
		bag.add(`lamp:${k + 1}/light:lamp`, 'glass', glass, BB_C.lamp, 0.2);
		lamps.push({ at: [x, arm1[1], arm1[2]], aim: [0, 0.5, -0.86] });
	});
	return lamps;
}

/* ------------------------------------------------------------------------------------------------------------
 * PART 3 · THE RECIPE
 * ------------------------------------------------------------------------------------------------------------ */

const PARAMS = [
	{ id: 'lit', label: 'Lights', type: 'integer', min: 0, max: 1, value: 0, names: ['Off', 'On'] },
	{ id: 'seed', label: 'Seed', type: 'string', value: 'maia', maxLength: 40 },
];
const NOTE =
	'A roadside monopole billboard: a steel column 1.0 m at its foot tapering to 0.7 m on a base plate, a head frame of steel sections carrying a 12 × 4 m face (the European large format; the US bulletin is 14.6 × 4.3 m) from 10 m to 14 m up, a catwalk with its rail along its foot and four old floodlights on arms aimed up at it. ' +
	'Its poster is a generic, faded advertisement of no brand, drawn by the recipe: a red saloon car on a washed-out sunset and MORE / FASTER BIGGER NOW, the paper sun-bleached and streaked, torn in places down to the grey backing and an older blue poster, by its seed. ' +
	'Facing +z, the column at the origin. The floodlights\' glasses are meshes named light:lamp (each its own material, the page drives emissiveIntensity: lit 1.8, dark 0); userData.lamps gives where each stands and aims.';

function build(lit, seed) {
	const sd = `${seed ?? 'maia'}`;
	const bag = new Bag(sd, 0.6);
	const lamps = billboard(bag);
	const root = bag.build('billboard', {
		face: () => new THREE.MeshStandardMaterial({ name: 'poster', map: poster(sd), roughness: 0.9, metalness: 0 }),
		'light:lamp': () => new THREE.MeshStandardMaterial({ name: 'light:lamp', vertexColors: true, roughness: 0.3, emissive: new THREE.Color('#fff1d6'), emissiveIntensity: lit ? LIT_ON : 0 }),
	});
	root.userData.lamps = lamps.map((x) => ({ ...x, color: '#fff1d6', lumens: 20000 }));
	return root;
}

module.exports.recipe = function (id, v, variant) {
	if (variant) throw new Error(`no asset things/${id}@${v}:${variant} in this file`);
	return {
		meta: { group: 'things', id, version: v, label: 'Billboard', note: NOTE, params: JSON.parse(JSON.stringify(PARAMS)), world: { faces: '+z', face: BB.face, foot: BB.foot, lights: ['light:lamp'] } },
		build,
	};
};
module.exports.parts = { BB, poster, billboard, Picture, Bag, trianglesOf };

return module.exports.recipe("billboard", 2, null);
