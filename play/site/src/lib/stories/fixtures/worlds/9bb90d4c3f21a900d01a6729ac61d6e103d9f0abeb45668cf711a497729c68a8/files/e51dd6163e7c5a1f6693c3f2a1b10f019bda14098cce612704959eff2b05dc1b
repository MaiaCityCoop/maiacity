	const gm = (g0 + g1) / 2, gh = g1 - g0;
	b.add('rubber', box(2 * W - 0.19, gh + 0.08, 0.02, [0, gm, zAt(gm) + 0.006], { rx: rake, seg: 1 }));
	b.add('glass', box(2 * W - 0.29, gh, 0.02, [0, gm, zAt(gm) + 0.014], { rx: rake, seg: 1 }));
	b.add('plastic', box(2 * W - 0.15, 0.05, 0.26, [0, g1 + 0.1, zAt(g1 + 0.1) + 0.04], { rx: 0.25, seg: 1 }));
	// the grille between the bumper and the glass
	const gr0 = o.bumper + 0.12, gr1 = g0 - 0.2;
	b.add('plastic', box(2 * W - 0.55, gr1 - gr0, 0.03, [0, (gr0 + gr1) / 2, zf], { seg: 1 }));
	const n = Math.max(2, Math.round((gr1 - gr0) / 0.14));
	for (let i = 0; i < n; i++) b.add('chassis', box(2 * W - 0.65, 0.05, 0.03, [0, gr0 + 0.08 + (i * (gr1 - gr0 - 0.16)) / (n - 1), zf + 0.018], { seg: 1 }));
	for (const s of [1, -1]) {
		const wz = Math.min(0.9, depth - 0.75);
		b.add('glass', box(0.02, gh * 0.75, wz, [s * (W + 0.002), gm + 0.04, zf - 0.23 - wz / 2], { seg: 1 }));
		b.add('chassis', box(0.012, roof - bottom - 0.4, 0.012, [s * (W + 0.004), (roof + bottom) / 2 - 0.1, zf - 1.2], { seg: 1 }));
		b.add('plastic', box(0.03, 0.04, 0.2, [s * (W + 0.01), g0 + 0.05, zf - 1.05], { seg: 1 }));
		// mirrors on their arms
		b.add('steel', rod([s * W, g1 + 0.07, zf - 0.22], [s * (W + 0.18), g1 + 0.07, zf - 0.08], 0.018, 6));
		b.add('steel', rod([s * W, g0 + 0.3, zf - 0.22], [s * (W + 0.18), g0 + 0.3, zf - 0.08], 0.018, 6));
		b.add('plastic', box(0.07, 0.52, 0.24, [s * (W + 0.2), g1 - 0.28, zf - 0.08], { seg: 1 }));
		// the steps behind the front wheel and the arch's mudguard
		const zw = zFA - wheelR - 0.03;
		b.add('plastic', span([s * (W - 0.24), 0.42, zb + 0.03], [s * (W - 0.04), 0.47, Math.min(zw, zb + 0.3)]));
		b.add('plastic', span([s * (W - 0.24), 0.78, zb + 0.03], [s * (W - 0.04), 0.83, Math.min(zw, zb + 0.3)]));
		b.add('rubber', span([s * (W - 0.4), 0.2, zw - 0.03], [s * W, bottom - 0.1, zw]));
		b.add('plastic', span([s * (W - 0.42), bottom - 0.12, zw], [s * W, bottom + 0.01, zFA + wheelR * 0.75]));
		b.lamp(s > 0 ? 'light:indicator-l' : 'light:indicator-r', box(0.02, 0.05, 0.1, [s * (W + 0.01), bottom + 0.16, zf - 0.55], { seg: 1 }));
		b.add('lensAmber', box(0.08, 0.04, 0.05, [s * (W - 0.3), roof + 0.01, zf - 0.6], { seg: 1 }));
	}
	// the bumper, its headlights and indicators in its top corners, the air dam under it
	const bt = o.bumper;
	b.add('plastic', span([-(W - 0.01), 0.42, zf - 0.4], [W - 0.01, bt, zf + 0.04]));
	b.add('chassis', span([-(W - 0.35), 0.3, zf - 0.35], [W - 0.35, 0.42, zf - 0.05]));
	pair(b, 'light:head', W - 0.42, bt - 0.16, zf + 0.045, 0.4, 0.16, 0.02);
	b.lamp('light:indicator-l', box(0.13, 0.13, 0.02, [W - 0.12, bt - 0.16, zf + 0.045], { seg: 1 }));
	b.lamp('light:indicator-r', box(0.13, 0.13, 0.02, [-(W - 0.12), bt - 0.16, zf + 0.045], { seg: 1 }));
	return zb;
}

/* ============================================================================================================
 * PART 2 · THE TRACTOR AND ITS SPRAYER — a big four-wheel-drive farm tractor of about 150 kW with a 1,800 L sprayer
 * on its three-point linkage and 24 m booms: the monoculture's machine, working a field of the barren land or
 * running along the highway to the next one, its beacon turning. Old, faded and caked with the field's dust.
 *
 * Measures (metres; the trade's data of 140–160 kW row-crop tractors and of mounted field sprayers):
 *   the tractor about 5.1 long with its front weight, 2.55 wide over its rear tyres, 3.10 to its cab roof (3.25 over
 *   its beacon); wheelbase 2.85; rear tyres 710/70 R38 (1.96 across, 0.71 wide) on a 1.80 track, front tyres
 *   600/70 R28 (1.55 across) on a 1.95 track; a four-post cab over its rear axle, its floor 1.25 up.
 *   The sprayer: a 1,800 L polyethylene tank (1.85 wide, 1.25 high, 1.0 deep) on a frame hung on the lower links and
 *   top link, a lift mast behind it carrying the booms: 24.2 m across when open (a centre frame and three sections a
 *   side, 4.8 + 4.6 + 2.15 m, their nozzles every 0.5 m), carried at 0.55 m over the ground in the field; folded for
 *   the road, each side's sections zigzagged forward alongside the tractor and lifted to 2.05 m, 3.0 m wide in all.
 *   Masses: the tractor about 7.5 t, the sprayer about 1.3 t empty and 3.1 t full.
 * Articulations (each a pivot; the variants set them): `boom` lifts the booms on the mast (y); `boom-l:1 … 3` and
 * `boom-r:1 … 3` fold each section about y at its hinge (0 = open).
 * ============================================================================================================ */

const TR = {
	L: 6.6, // the tractor with its sprayer, front weight to boom frame
	uFA: 1.3, WB: 2.85,
	front: { D: 1.551, W: 0.6, rim: 0.711, lugs: 18 },
	rear: { D: 1.959, W: 0.71, rim: 0.965, lugs: 22 },
	trackF: 1.95, trackR: 1.8,
	cab: [2.95, 4.72], floor: 1.25, roof: 2.95,
	boomU: 6.5, // the boom frame behind the tank
	boomY: { field: 0.55, road: 2.05 },
	sections: [[0.55, 5.35, 0.45], [5.35, 9.95, 0.38], [9.95, 12.1, 0.28]], // each [from x, to x, its depth], one side
};
const zU = (u) => TR.L / 2 - u; // z of a distance u back from the front weight
TR.zFA = zU(TR.uFA);
TR.zRA = zU(TR.uFA + TR.WB);
TR.zB = zU(TR.boomU);

/** a curved band round an axis along x (a mudguard): radius r0 … r1 round (zc, yc), from angle a0 to a1 (0 = toward −z, π = toward +z, over the top) */
function arcBand(zc, yc, r0, r1, a0, a1, x0, x1, n = 8) {
	const out = [], inn = [];
	for (let i = 0; i <= n; i++) {
		const a = a0 + ((a1 - a0) * i) / n;
		out.push([zc - r1 * Math.cos(a), yc + r1 * Math.sin(a)]);
		inn.push([zc - r0 * Math.cos(a), yc + r0 * Math.sin(a)]);
	}
	return profile([...out, ...inn.reverse()], x0, x1, 0);
}

/** the tractor, the sprayer's frame and tank, and the boom's lift frame with its six folding sections */
function tractorSprayer(m, seed, pose) {
	const T = TR, Rf = T.front.D / 2, Rr = T.rear.D / 2;
	const [c0, c1] = T.cab.map(zU); // the cab's front and back
	const b = new Body('tractor', seed, m, {
		wear: {
			spray: 0.7,
			soot: (p) => smooth(2.6, 3.25, p.y) * smooth(0.25, 0.05, Math.hypot(p.x + 0.62, p.z - (c0 + 0.12))),
		},
	});

	// the front weight, the frame and engine under the bonnet, the front axle
	b.add('chassis', span([-0.52, 0.5, zU(0.35)], [0.52, 1.02, zU(0)]));
	for (let i = 0; i < 4; i++) b.add('chassis', box(1.0, 0.08, 0.05, [0, 0.62 + i * 0.11, zU(0) + 0.02], { seg: 1 }));
	b.add('chassis', span([-0.4, 0.5, zU(2.95)], [0.4, 0.98, zU(0.35)]));
	b.add('chassis', rod([-0.98, Rf, T.zFA], [0.98, Rf, T.zFA], 0.09, 8));
	b.add('chassis', box(0.5, 0.35, 0.5, [0, Rf, T.zFA], { seg: 1 }));
	// the bonnet: its profile pushed across, the grille in its nose, louvres down its sides, the headlights
	b.add('paint', profile([[zU(0.35), 0.95], [zU(0.35), 1.68], [zU(0.6), 1.82], [zU(2.95), 1.9], [zU(2.95), 0.95]], -0.46, 0.46, 0.03));
	b.add('chassis', box(0.7, 0.55, 0.02, [0, 1.27, zU(0.35) + 0.012], { seg: 1 }));
	for (const s of [1, -1]) {
		b.add('chassis', box(0.02, 0.42, 0.7, [s * 0.462, 1.4, zU(0.85)], { seg: 1 }));
		b.lamp('light:head', box(0.16, 0.1, 0.02, [s * 0.27, 1.6, zU(0.35) + 0.015], { seg: 1 }));
	}
	// the front mudguards over the steered wheels
	for (const s of [1, -1]) b.add('paint', arcBand(T.zFA, Rf, Rf + 0.06, Rf + 0.1, 0.35, 2.6, s > 0 ? T.trackF / 2 - 0.33 : -(T.trackF / 2 + 0.33), s > 0 ? T.trackF / 2 + 0.33 : -(T.trackF / 2 - 0.33), 6));
	// the rear axle, its housings out to the wheels, the rear mudguards
	b.add('chassis', rod([-0.92, Rr, T.zRA], [0.92, Rr, T.zRA], 0.11, 8));
	b.add('chassis', span([-0.42, 0.55, T.zRA - 0.5], [0.42, 1.25, T.zRA + 0.65]));
	for (const s of [1, -1]) {
		const xa = s > 0 ? 0.5 : -1.3, xb = s > 0 ? 1.3 : -0.5;
		b.add('paint', arcBand(T.zRA, Rr, Rr + 0.07, Rr + 0.11, 0.2, 2.75, xa, xb, 9));
		// the lamp bracket at the mudguard's back: tail, brake, indicator
		const zl = T.zRA - (Rr + 0.09) * Math.cos(0.2) - 0.02, yl = Rr + (Rr + 0.09) * Math.sin(0.2);
		b.add('chassis', span([s * 0.85, yl - 0.12, zl - 0.04], [s * 1.25, yl + 0.06, zl]));
		b.lamp('light:tail', box(0.1, 0.08, 0.02, [s * 0.95, yl - 0.03, zl - 0.05], { seg: 1 }));
		b.lamp('light:brake', box(0.1, 0.08, 0.02, [s * 1.06, yl - 0.03, zl - 0.05], { seg: 1 }));
		b.lamp(s > 0 ? 'light:indicator-l' : 'light:indicator-r', box(0.08, 0.08, 0.02, [s * 1.18, yl - 0.03, zl - 0.05], { seg: 1 }));
	}
	// steps up to the cab on the left, the fuel tank on the right, the exhaust up the cab's front corner
	for (const [i, y] of [0.45, 0.75, 1.05].entries()) b.add('chassis', span([0.52, y, zU(3.12)], [0.82 - i * 0.04, y + 0.04, zU(2.95)]));
	b.add('chassis', span([0.5, 0.45, zU(3.14)], [0.53, 1.25, zU(2.93)]));
	b.add('paint', span([-0.82, 0.55, zU(3.12)], [-0.42, 1.2, zU(2.2)]));
	b.add('steel', rod([-0.62, 1.7, c0 + 0.12], [-0.62, 3.25, c0 + 0.12], 0.055, 8));

	// the cab: narrow between the wheels, wide over the mudguards; four posts, glass all round, its roof
	b.add('paint', span([-0.5, 1.0, c1], [0.5, 2.0, c0]));
	b.add('chassis', span([-0.92, 1.25, c1], [0.92, 1.3, c0]));
	for (const s of [1, -1]) for (const z of [c0, c1]) b.add('chassis', span([s * 0.86, 1.3, z - 0.035], [s * 0.92, T.roof, z + 0.035]));
	b.add('glass', box(1.72, T.roof - 1.95, 0.02, [0, (1.95 + T.roof) / 2, c0 - 0.01], { seg: 1 }));
	b.add('glass', box(0.92, 0.65, 0.02, [0, 1.62, c0 - 0.01], { seg: 1 }));
	b.add('glass', box(1.72, T.roof - 2.05, 0.02, [0, (2.05 + T.roof) / 2, c1 + 0.01], { seg: 1 }));
	for (const s of [1, -1]) {
		b.add('glass', box(0.02, T.roof - 1.98, c0 - c1 - 0.08, [s * 0.89, (1.98 + T.roof) / 2, (c0 + c1) / 2], { seg: 1 }));
		b.add('chassis', box(0.024, 0.04, c0 - c1, [s * 0.89, 2.4, (c0 + c1) / 2], { seg: 1 })); // a handrail
		// the mirrors on their arms from the front posts, high, over where the folded booms ride
		b.add('steel', rod([s * 0.9, 2.85, c0 - 0.05], [s * 1.25, 2.85, c0 + 0.15], 0.018, 6));
		b.add('plastic', box(0.05, 0.36, 0.22, [s * 1.27, 2.77, c0 + 0.15], { seg: 1 }));
	}
	// inside, seen through the glass: the seat, the steering wheel on its column, the dash, the side console
	b.add('plastic', span([-0.28, 1.3, c1 + 0.55], [0.28, 1.75, c1 + 1.05]));
	b.add('plastic', span([-0.28, 1.75, c1 + 0.45], [0.28, 2.4, c1 + 0.6]));
	b.add('chassis', rod([0, 1.35, c0 - 0.15], [0, 2.0, c0 - 0.4], 0.035, 6));
	b.add('chassis', rod([-0.2, 2.02, c0 - 0.42], [0.2, 2.02, c0 - 0.42], 0.025, 6));
	b.add('chassis', rod([0, 2.02, c0 - 0.62], [0, 2.02, c0 - 0.22], 0.025, 6));
	b.add('chassis', span([-0.45, 1.3, c0 - 0.2], [0.45, 1.85, c0 - 0.05]));
	b.add('chassis', span([-0.75, 1.3, c1 + 0.4], [-0.45, 1.85, c1 + 1.3]));
	b.add('paint3', profile([[c1 - 0.08, T.roof], [c1 - 0.08, T.roof + 0.1], [c1 + 0.05, T.roof + 0.15], [c0 - 0.05, T.roof + 0.15], [c0 + 0.14, T.roof + 0.08], [c0 + 0.14, T.roof]], -1.0, 1.0, 0.02));
	// lights on the roof's front corners (road lights, the indicators) and the amber beacon on its left back corner
	pair(b, 'light:head', 0.62, T.roof + 0.05, c0 + 0.155, 0.16, 0.08, 0.02);
	b.lamp('light:indicator-l', box(0.1, 0.06, 0.02, [0.88, T.roof + 0.05, c0 + 0.155], { seg: 1 }));
	b.lamp('light:indicator-r', box(0.1, 0.06, 0.02, [-0.88, T.roof + 0.05, c0 + 0.155], { seg: 1 }));
	b.add('chassis', rod([0.62, T.roof + 0.15, c1 + 0.2], [0.62, T.roof + 0.19, c1 + 0.2], 0.08, 10));
	b.lamp('light:beacon-amber', rod([0.62, T.roof + 0.19, c1 + 0.2], [0.62, T.roof + 0.34, c1 + 0.2], 0.07, 10, 0.05));

	// the three-point linkage and the PTO shaft to the sprayer's pump
	const zh = zU(5.1);
	for (const s of [1, -1]) b.add('chassis', rod([s * 0.38, 0.55, T.zRA - 0.2], [s * 0.45, 0.58, zh], 0.04, 6));
	b.add('chassis', rod([0, 1.25, T.zRA - 0.45], [0, 1.45, zh], 0.04, 6));
	b.add('chassis', rod([0, 0.65, T.zRA - 0.5], [0, 0.62, zh - 0.2], 0.045, 6));

	// the sprayer: its frame, the tank (rounded, its lid and the rinse tank on top), the pump, the lift mast
	const zs0 = zU(5.15), zs1 = zU(6.25);
	b.add('paint2', span([-0.9, 0.42, zs1], [0.9, 0.58, zs0]));
	for (const s of [1, -1]) b.add('paint2', span([s * 0.42, 0.45, zs0 - 0.05], [s * 0.5, 1.5, zs0 + 0.04]));
	b.add('paint2', span([-0.5, 1.45, zs0 - 0.05], [0.5, 1.53, zs0 + 0.04]));
	const rr = 0.18, round = [];
	for (const [cz, cy, a0] of [[zs0 - 0.05 - rr, 1.85 - rr, 0], [zs1 + 0.05 + rr, 1.85 - rr, Math.PI / 2]])
		for (let i = 0; i <= 4; i++) {
			const a = a0 + (Math.PI / 2) * (i / 4);
			round.push([cz + rr * Math.cos(a), cy + rr * Math.sin(a)]);
		}
	b.add('paint3', profile([[zs0 - 0.05, 0.6], ...round, [zs1 + 0.05, 0.6]], -0.92, 0.92, 0.04));
	b.add('chassis', rod([0.3, 1.84, (zs0 + zs1) / 2], [0.3, 1.92, (zs0 + zs1) / 2], 0.18, 12));
	b.add('paint3', span([-0.85, 1.84, zs0 - 0.35], [-0.2, 2.05, zs0 - 0.08]));
	b.add('chassis', span([-0.25, 0.45, zh - 0.35], [0.25, 0.75, zh - 0.05]));
	for (const s of [1, -1]) b.add('paint2', span([s * 0.4, 0.42, T.zB + 0.08], [s * 0.48, 2.75, T.zB + 0.18]));
	b.add('paint2', span([-0.48, 2.7, T.zB + 0.08], [0.48, 2.78, T.zB + 0.18]));

	// the booms: a lift frame on the mast, three sections a side, each a truss with its spray line and nozzles
	const yF = T.boomY.field;
	const lift = new Body('boom', seed, m, { wear: { spray: 0.3 } });
	lift.add('paint2', span([-0.6, yF, T.zB - 0.06], [0.6, yF + 0.5, T.zB + 0.06]));
	lift.add('chassis', span([-0.38, yF + 0.1, T.zB + 0.06], [0.38, yF + 0.4, T.zB + 0.1]));
	b.carry(lift, [0, yF, T.zB]);
	for (const s of [1, -1]) {
		let parent = lift;
		T.sections.forEach(([x0, x1, h], i) => {
			const sec = new Body(`boom-${s > 0 ? 'l' : 'r'}:${i + 1}`, seed, m, { wear: { spray: 0.3 } });
			truss(sec, s * x0, s * x1, yF, T.zB, h);
			// its hinge: off the boom's line, so that a fold of 90° (the first) or 180° (the others) lays it beside the last
			const e = [0.87, 0.1, -0.1][i];
			parent.carry(sec, [s * x0, yF, T.zB + e]);
			parent = sec;
		});
	}

	const rimF = [0.36, 0.34, 0.28], rimR = [0.36, 0.34, 0.28];
	b.wheel('1-l', [T.trackF / 2, Rf, T.zFA], { ...T.front, rimColour: rimF });
	b.wheel('1-r', [-T.trackF / 2, Rf, T.zFA], { ...T.front, rimColour: rimF });
	b.wheel('2-l', [T.trackR / 2, Rr, T.zRA], { ...T.rear, rimColour: rimR });
	b.wheel('2-r', [-T.trackR / 2, Rr, T.zRA], { ...T.rear, rimColour: rimR });
	return b;
}

/** one boom section: a truss of two chords from x0 to x1 (a side's sign in them), posts and diagonals, the spray line under it, its nozzles */
function truss(b, x0, x1, y, z, h) {
	const L = Math.abs(x1 - x0), s = Math.sign(x1 - x0), n = Math.max(2, Math.round(L / 0.9));
	const at = (k) => x0 + (s * L * k) / n;
	const top = (x) => y + h - (0.25 * h * Math.abs(x - x0)) / L; // a little lower toward its tip
	b.add('paint2', rod([x0, y + 0.03, z], [x1, y + 0.03, z], 0.03, 6));
	b.add('paint2', rod([x0, top(x0), z], [x1, top(x1), z], 0.025, 6));
	for (let k = 0; k <= n; k++) b.add('paint2', rod([at(k), y + 0.03, z], [at(k), top(at(k)), z], 0.014, 4));
	for (let k = 0; k < n; k++) b.add('paint2', rod([at(k), y + 0.03, z], [at(k + 1), top(at(k + 1)), z], 0.012, 4));
	b.add('steel', rod([x0, y - 0.02, z + 0.04], [x1, y - 0.02, z + 0.04], 0.012, 4));
	for (let x = x0 + s * 0.25; s * (x1 - x) > 0.05; x += s * 0.5) b.add('chassis', box(0.03, 0.08, 0.03, [x, y - 0.06, z + 0.04], { seg: 1 }));
}

/* ============================================================================================================
 * PART 3 · THE RECIPE
 * ============================================================================================================ */

/** how each pose sets the articulations: the lift's height, each section's fold (radians about y, the left side's sign) */
const POSES = {
	road: { label: 'Road (booms folded)', lift: TR.boomY.road - TR.boomY.field, fold: [-Math.PI / 2, Math.PI, Math.PI], beacon: 0 },
	field: { label: 'Field (booms open)', lift: 0, fold: [0, 0, 0], beacon: 0 },
};
/** an old row-crop tractor's faded olive, its sprayer's frame a worn grey, its tank and the cab's roof a dirty white */
const PAINT = { paint: '#5c6343', paint2: '#77756b', paint3: '#c4c1b2' };

const FACTS = {
	tractor: {
