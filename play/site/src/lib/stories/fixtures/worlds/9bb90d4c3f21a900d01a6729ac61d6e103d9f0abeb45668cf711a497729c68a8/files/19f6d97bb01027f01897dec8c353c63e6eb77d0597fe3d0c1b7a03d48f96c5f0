					else bag.quad('frame', W(ax, ay - f, fz), W(bx, ay - f, fz), W(bx, ay + f, fz), W(ax, ay + f, fz), null, fc);
				};
				// the bottom rail hides behind the sill: three bars and the mullions
				bar(X0 + f, Y0, X0 + f, Y1), bar(X1 - f, Y0, X1 - f, Y1), bar(X0, Y1 - f, X1, Y1 - f);
				for (const fx of q.mullions ?? []) bar(X0 + fx, Y0, X0 + fx, Y1);
				for (const fy of q.transoms ?? []) bar(X0, Y0 + fy, X1, Y0 + fy);
			}
			// the sill: a strip of galvanised steel standing out from the panel, catching the light
			if (q.sill !== false && q.y0 > 0.05) {
				const s0 = W(X0 - 0.03, Y0 - 0.04, 0.05), s1 = W(X1 + 0.03, Y0 - 0.04, 0.05), s2 = W(X1 + 0.03, Y0, -0.02), s3 = W(X0 - 0.03, Y0, -0.02);
				bag.quad('metal', s0, s1, s2, s3, null, [0.42, 0.43, 0.42]);
			}
		}
	}
}

/**
 * A box laid in a facade's frame (x along it, y up, z out of it), from (x0, y0, z0) to (x1, y1, z1) in its metres:
 * a parapet, a pier, a fin. `skip` as Bag.box's, in the frame's own axes ('-y' its underside, '-z' its back).
 */
function frameBox(bag, mat, frame, x0, x1, y0, y1, z0, z1, col, skip = '', tile = 3) {
	const { o, u, n } = frame;
	const W = (x, y, z) => [o[0] + u[0] * x + n[0] * z, o[1] + y, o[2] + u[2] * x + n[2] * z];
	const s = 1 / tile;
	const uv = (a, b, c, d) => [[a * s, c * s], [b * s, c * s], [b * s, d * s], [a * s, d * s]];
	if (!skip.includes('+z')) bag.quad(mat, W(x0, y0, z1), W(x1, y0, z1), W(x1, y1, z1), W(x0, y1, z1), uv(x0, x1, y0, y1), col);
	if (!skip.includes('-z')) bag.quad(mat, W(x1, y0, z0), W(x0, y0, z0), W(x0, y1, z0), W(x1, y1, z0), uv(x0, x1, y0, y1), col);
	if (!skip.includes('+y')) bag.quad(mat, W(x0, y1, z1), W(x1, y1, z1), W(x1, y1, z0), W(x0, y1, z0), uv(x0, x1, z0, z1), col);
	if (!skip.includes('-y')) bag.quad(mat, W(x0, y0, z0), W(x1, y0, z0), W(x1, y0, z1), W(x0, y0, z1), uv(x0, x1, z0, z1), col);
	if (!skip.includes('-x')) bag.quad(mat, W(x0, y0, z0), W(x0, y0, z1), W(x0, y1, z1), W(x0, y1, z0), uv(z0, z1, y0, y1), col);
	if (!skip.includes('+x')) bag.quad(mat, W(x1, y0, z1), W(x1, y0, z0), W(x1, y1, z0), W(x1, y1, z1), uv(z0, z1, y0, y1), col);
}

/**
 * A blank wall (a gable, an attic band): one plane whose picture is laid on in metres, continuous across it, its
 * panels' joints and stains drawn in the picture (`blank`: two panels by three storeys, repeating), its grime a
 * smooth colour by height. Nothing in it changes from one panel to the next, so when a world draws it far off by a
 * simplified copy (play's levels of detail weld corners that agree and fold flat walls into big triangles), the
 * picture cannot shear across them. `frame` as facade's; `y0`–`y1` its height, `yRef` a floor level the joints keep
 * to, `rows` the heights it is cut at for the colour (each cut's corners alike on both sides, so they weld).
 */
function blankWall(bag, frame, x0, x1, y0, y1, opts) {
	const { panel, yRef = 0, shade = () => 1, tint = [1, 1, 1], cuts = [] } = opts;
	// `ends` pulls its ends in by a hair (an attic band meeting a gable at the corner): two blank walls never share a
	// corner, so a simplifier welding by place alone cannot hand one wall the other's mapping there
	const { o, u, n } = frame;
	const W = (x, y) => [o[0] + u[0] * x, o[1] + y, o[2] + u[2] * x];
	if (opts.ends) (x0 += 0.003), (x1 -= 0.003);
	// the wall's own picture in the building's sheet: the whole wall at once, its panels' joints where they stand; two
	// walls of one size and level share it
	const key = `blank:${(x1 - x0).toFixed(2)}x${(y1 - y0).toFixed(2)}@${(y0 - yRef).toFixed(2)}`;
	bag.walls[key] = { w: x1 - x0, h: y1 - y0, from: y0 - yRef, panel };
	const uv = (x, y) => [(x - x0) / (x1 - x0), (y - y0) / (y1 - y0)];
	const col = (y) => tint.map((c) => c * shade(0, y));
	const ys = [y0, ...cuts.filter((y) => y > y0 + 1e-6 && y < y1 - 1e-6), y1];
	for (let i = 0; i < ys.length - 1; i++) {
		const a = ys[i], b = ys[i + 1];
		bag.quad(key, W(x0, a), W(x1, a), W(x1, b), W(x0, b), [uv(x0, a), uv(x1, a), uv(x1, b), uv(x0, b)], [col(a), col(a), col(b), col(b)]);
	}
	void n;
}

/** the materials every concrete building of the old city uses, its pictures made once a build */
function materials(seed, dusk, kinds, panel, extra = {}) {
	const atlas = panelAtlas(kinds, panel, seed);
	// the blank walls' picture: two panels by three storeys of plain panels, laid on in metres
	const blank = panelAtlas([{ streaks: [] }, { streaks: [] }, { streaks: [] }], { ...panel, cols: 2 }, seed + 7);
	const grime = grimeTile(256, seed + 101);
	const std = (o) => new THREE.MeshStandardMaterial({ vertexColors: true, ...o });
	// the lit windows' OFF look is dark glass, as the others; the page (or `dusk`, 0 by default) lights them
	const lit = new THREE.MeshStandardMaterial({ color: '#16191c', emissive: '#ffc77a', emissiveIntensity: 1.6 * dusk, roughness: 0.15, metalness: 0.5, vertexColors: false });
	lit.name = 'light:window';
	const m = {
		panel: std({ map: atlas, roughness: 0.95 }),
		blank: std({ map: blank, roughness: 0.95 }),
		concrete: std({ map: grime, roughness: 0.95 }),
		glass: std({ color: '#ffffff', roughness: 0.12, metalness: 0.55 }),
		frame: std({ color: '#ffffff', roughness: 0.6 }),
		metal: std({ color: '#ffffff', roughness: 0.45, metalness: 0.6 }),
		paint: std({ color: '#ffffff', roughness: 0.85 }),
		roof: std({ map: grime, roughness: 1 }),
		cloth: std({ color: '#ffffff', roughness: 1, side: THREE.DoubleSide }),
		'light:window': lit,
		...extra,
	};
	for (const [k, v] of Object.entries(m)) v.name = k;
	return m;
}

/**
 * ONE PICTURE FOR A WHOLE BUILDING. A world draws every kind once per material at each level of detail, so a building
 * of ten materials costs ten draws where one would do. The Sheet lays every picture a building needs side by side in
 * one texture (shelf by shelf, a few pixels apart so the far mipmaps do not bleed), and Bag.buildAtlas draws the
 * building with three materials: its body (everything opaque, the pictures from the sheet and its colours as vertex
 * colours), its glass, and its lit windows (`light:window`).
 */
class Sheet {
	constructor(width = 2048, pad = 4) {
		this.W = width;
		this.pad = pad;
		this.items = [];
		this.x = 0;
		this.y = 0;
		this.row = 0;
	}
	/** a picture of w × h pixels, its `pixel(x, y)` in its own pixels (y up); gives its place, filled in by texture() */
	add(w, h, pixel) {
		w = Math.max(1, Math.round(w)), h = Math.max(1, Math.round(h));
		if (this.x + w + this.pad > this.W) (this.x = 0), (this.y += this.row + this.pad), (this.row = 0);
		const it = { x: this.x, y: this.y, w, h, pixel, region: null };
		this.items.push(it);
		this.x += w + this.pad;
		this.row = Math.max(this.row, h);
		return it;
	}
	/** the texture, and every item's region in it as [u0, v0, u1, v1] (half a pixel in from its edges) */
	texture() {
		const W = this.W, H = this.y + this.row;
		const data = new Uint8Array(W * H * 4);
		for (const it of this.items) {
			for (let y = 0; y < it.h; y++)
				for (let x = 0; x < it.w; x++) {
					const c = it.pixel(x, y);
					const i = ((it.y + y) * W + it.x + x) * 4;
					data[i] = Math.round(clamp(srgb(c[0])) * 255);
					data[i + 1] = Math.round(clamp(srgb(c[1])) * 255);
					data[i + 2] = Math.round(clamp(srgb(c[2])) * 255);
					data[i + 3] = 255;
				}
			it.region = [(it.x + 0.5) / W, (it.y + 0.5) / H, (it.x + it.w - 0.5) / W, (it.y + it.h - 0.5) / H];
		}
		const t = new THREE.DataTexture(data, W, H, THREE.RGBAFormat);
		t.colorSpace = THREE.SRGBColorSpace;
		t.anisotropy = 8;
		t.generateMipmaps = true;
		t.minFilter = THREE.LinearMipmapLinearFilter;
		t.magFilter = THREE.LinearFilter;
		t.needsUpdate = true;
		return t;
	}
}

/** what each of the Bag's names becomes in a building drawn from one sheet */
const FLAT = new Set(['frame', 'metal', 'paint', 'cloth']); // a plain colour: the sheet's white, the vertex colour
const STRETCH = new Set(['concrete', 'roof', 'shutter']); // each face its own: the whole of its picture laid on it

/**
 * Draw the Bag with three materials from one Sheet. `o`: { seed, dusk, kinds, panel, pictures: { name: { w, h, pixel } } }
 * (a building's own pictures, by the Bag's name that shows them: a sign board, a shutter). The panels take the panel
 * atlas; each blank wall its own picture of itself (blankWall); `concrete` and `roof` faces each the grime picture
 * whole; frames, metal, paint and cloth (both its sides) the sheet's white under their vertex colours.
 */
Bag.prototype.buildAtlas = function (root, o) {
	const sheet = new Sheet();
	const regions = {};
	const atlas = panelAtlas(o.kinds, o.panel, o.seed, true);
	regions.panel = sheet.add(atlas.w, atlas.h, atlas.pixel);
	regions.white = sheet.add(8, 8, () => [1, 1, 1]);
	const grime = grimeTile(256, o.seed + 101, true);
	regions.grime = sheet.add(256, 256, grime.pixel);
	// the blank walls: each its own picture, the plain panels (two by three storeys, repeating) laid on at 20 px a metre
	const blank = panelAtlas([{ streaks: [] }, { streaks: [] }, { streaks: [] }], { ...o.panel, cols: 2 }, o.seed + 7, true);
	const [bcw, bch] = o.panel.cell ?? ATLAS.cell;
	for (const [key, w] of Object.entries(this.walls)) {
		const ppm = Math.min(28, 2040 / w.w, 2040 / w.h);
		const at = (mx, my) => {
			const tx = ((mx % (2 * w.panel.w)) + 2 * w.panel.w) % (2 * w.panel.w), ty = ((my % (3 * w.panel.h)) + 3 * w.panel.h) % (3 * w.panel.h);
			return blank.pixel(Math.min(blank.w - 1, Math.floor((tx / w.panel.w) * bcw)), Math.min(blank.h - 1, Math.floor((ty / w.panel.h) * bch)));
		};
		// each pixel the mean of the panels' picture across it (3 × 3 samples), so a joint thinner than a pixel still shows
		regions[key] = sheet.add(w.w * ppm, Math.max(2, w.h * ppm), (x, y) => {
			const c = [0, 0, 0];
			for (let i = 0; i < 3; i++)
				for (let j = 0; j < 3; j++) {
					const q = at((x + (i + 0.5) / 3) / ppm, w.from + (y + (j + 0.5) / 3) / ppm);
					(c[0] += q[0] / 9), (c[1] += q[1] / 9), (c[2] += q[2] / 9);
				}
			return c;
		});
	}
	for (const [name, pic] of Object.entries(o.pictures ?? {})) regions[name] = sheet.add(pic.w, pic.h, pic.pixel);
	const map = sheet.texture();

	const body = { p: [], n: [], uv: [], c: [] }, glass = { p: [], n: [], uv: [], c: [] }, lit = { p: [], n: [], uv: [], c: [] };
	const lay = (r, u, v) => [r[0] + clamp(u) * (r[2] - r[0]), r[1] + clamp(v) * (r[3] - r[1])];
	for (const [name, t] of this.parts) {
		const into = name === 'glass' ? glass : name.startsWith('light:') ? lit : body;
		const n = t.p.length / 3;
		const reg = FLAT.has(name) ? regions.white.region : name === 'concrete' || name === 'roof' ? regions.grime.region : regions[name]?.region ?? regions.white.region;
		for (let q = 0; q < n; q += 6) {
			// a quad's six corners (a geometry's triangles come in sixes too, or end short: taken as they come)
			const m = Math.min(6, n - q);
			let u0 = Infinity, u1 = -Infinity, v0 = Infinity, v1 = -Infinity;
			if (STRETCH.has(name)) for (let k = q; k < q + m; k++) (u0 = Math.min(u0, t.uv[2 * k])), (u1 = Math.max(u1, t.uv[2 * k])), (v0 = Math.min(v0, t.uv[2 * k + 1])), (v1 = Math.max(v1, t.uv[2 * k + 1]));
			const sides = name === 'cloth' ? [false, true] : [false];
			for (const back of sides) {
				const order = back ? [0, 2, 1, 3, 5, 4] : [0, 1, 2, 3, 4, 5];
				for (const j of order.slice(0, m)) {
					const k = q + j;
					into.p.push(t.p[3 * k], t.p[3 * k + 1], t.p[3 * k + 2]);
					const s = back ? -1 : 1;
					into.n.push(s * t.n[3 * k], s * t.n[3 * k + 1], s * t.n[3 * k + 2]);
					into.c.push(t.c[3 * k], t.c[3 * k + 1], t.c[3 * k + 2]);
					let u = t.uv[2 * k], v = t.uv[2 * k + 1];
					if (FLAT.has(name)) (u = 0.5), (v = 0.5);
					else if (STRETCH.has(name)) (u = u1 > u0 ? (u - u0) / (u1 - u0) : 0.5), (v = v1 > v0 ? (v - v0) / (v1 - v0) : 0.5);
					into.uv.push(...(into === body ? lay(reg, u, v) : [u, v]));
				}
			}
		}
	}
	const mesh = (t, mat, name) => {
		if (!t.p.length) return;
		const g = new THREE.BufferGeometry();
		g.setAttribute('position', new THREE.Float32BufferAttribute(t.p, 3));
		g.setAttribute('normal', new THREE.Float32BufferAttribute(t.n, 3));
		g.setAttribute('uv', new THREE.Float32BufferAttribute(t.uv, 2));
		g.setAttribute('color', new THREE.Float32BufferAttribute(t.c, 3));
		g.computeBoundingSphere();
		const m = new THREE.Mesh(g, mat);
		m.name = name;
		m.castShadow = name !== 'light:window';
		m.receiveShadow = true;
		root.add(m);
	};
	const bodyM = new THREE.MeshStandardMaterial({ vertexColors: true, map, roughness: 0.92 });
	bodyM.name = 'body';
	const glassM = new THREE.MeshStandardMaterial({ vertexColors: true, color: '#ffffff', roughness: 0.12, metalness: 0.55 });
	glassM.name = 'glass';
	// the lit windows' OFF look is dark glass; the page (or `dusk`, 0 by default) lights them
	const litM = new THREE.MeshStandardMaterial({ color: '#16191c', emissive: '#ffc77a', emissiveIntensity: 1.6 * clamp(o.dusk), roughness: 0.15, metalness: 0.5 });
	litM.name = 'light:window';
	mesh(body, bodyM, 'body'), mesh(glass, glassM, 'glass'), mesh(lit, litM, 'light:window');
	return root;
};

/** a satellite dish, its mouth toward +z: a shallow bowl, the feed arm and its head; ~0.8 m across */
function dish(r = 0.4) {
	const pts = [];
	for (let i = 0; i <= 3; i++) {
		const t = i / 3;
		pts.push(new THREE.Vector2(r * t, (r * t) ** 2 * 0.55));
	}
	const bowl = new THREE.LatheGeometry(pts, 8);
	bowl.rotateX(Math.PI / 2);
	const arm = new THREE.BoxGeometry(0.03, 0.03, r * 1.3);
	arm.translate(0, -r * 0.5, r * 0.55);
	arm.rotateX(-0.6);
	const head = new THREE.BoxGeometry(0.07, 0.07, 0.1);
	head.translate(0, 0, r * 0.75);
	return [bowl, arm, head].map((g) => (g.index ? g.toNonIndexed() : g));
}


// ───────────────────────────────────────────── 2. THE TOWER ─────────────────────────────────────────────

const TOWER = {
	axis: 3.6, // the panel grid round the tower, m (the 3.6 m module of the large-panel towers)
	storey: 2.8, // floor to floor, m
	plinth: 0.9, // the basement out of the ground, m
	attic: 1.0, // the roof parapet, m
	loggia: { deep: 1.2, parapet: 1.0, head: 0.2 }, // a loggia set into the wall, m
	machine: { w: 8.4, d: 6.0, h: 4.2 }, // the lifts' machine room and the water tank over the core, m [EST]
	porch: { w: 5.0, d: 2.4, h: 3.1 }, // the lobby's vestibule on the front, m [EST]
};

/**
 * The kinds of panel round the tower, each 3.6 m wide (x from its left seen from outside, y from its floor):
 *   W  a room's window, 1.5 × 1.45 m;
 *   T  a kitchen's window and a bathroom's small one;
 *   S  the stairwell's window, between floors;
 *   L  a loggia set 1.2 m into the wall: its opening (no glass: the room's wall stands behind it, panel R);
 *   R  the loggia's back wall: the door and the window of the room behind it;
 *   G  blank: the plinth, the attic.
 */
const TOPEN = {
	W: [{ x0: 1.05, x1: 2.55, y0: 0.85, y1: 2.3, kind: 'window', mullions: [0.75] }],
	T: [{ x0: 0.5, x1: 1.4, y0: 1.0, y1: 2.3, kind: 'window' }, { x0: 2.3, x1: 2.9, y0: 1.6, y1: 2.2, kind: 'small' }],
	S: [{ x0: 1.2, x1: 2.4, y0: 1.5, y1: 2.6, kind: 'stair', mullions: [0.6] }],
	L: [{ x0: 0.15, x1: 3.45, y0: 0, y1: 2.6, kind: 'loggia' }],
	R: [{ x0: 0.35, x1: 1.25, y0: 0.02, y1: 2.2, kind: 'door' }, { x0: 1.45, x1: 2.95, y0: 0.85, y1: 2.3, kind: 'window' }],
	G: [],
};
const TKINDS = ['W', 'T', 'S', 'L', 'R', 'G'];
const tstreaks = (k) => (k === 'L' ? [[0.2, 0.05], [3.4, 0.05]] : TOPEN[k].filter((q) => q.y0 > 0.1).flatMap((q) => [[q.x0 + 0.05, q.y0], [q.x1 - 0.05, q.y0]]));

/** each side's axes, left to right seen from outside: loggias one in from the corners, the stair on the back */
function sidesOf(N) {
	const ring = (mid) => {
		const a = Array(N).fill('W');
		a[1] = 'L', a[N - 2] = 'L';
		for (let i = 2; i < N - 2; i++) a[i] = mid(i);
		return a;
	};
	return {
		front: ring(() => 'W'),
		right: ring((i) => (i === 2 || i === N - 3 ? 'T' : 'W')),
		back: ring((i) => (i === Math.floor((N - 1) / 2) ? 'S' : 'T')),
		left: ring((i) => (i === 2 || i === N - 3 ? 'T' : 'W')),
	};
}

const GLASS = [[0.07, 0.08, 0.09], [0.07, 0.08, 0.09], [0.09, 0.1, 0.1], [0.2, 0.19, 0.17], [0.24, 0.23, 0.2], [0.16, 0.15, 0.13], [0.12, 0.11, 0.1]];
const FRAMES = [[0.22, 0.17, 0.13], [0.46, 0.46, 0.44], [0.4, 0.4, 0.39]];
const LIT = [[1, 0.85, 0.6], [1, 0.8, 0.55], [0.85, 0.9, 1], [1, 0.75, 0.5]];
const WASH = [[0.6, 0.58, 0.54], [0.42, 0.2, 0.17], [0.22, 0.28, 0.4], [0.5, 0.46, 0.3], [0.66, 0.66, 0.64], [0.3, 0.36, 0.3]];
/** the loggias' parapets: plain, or the faded paint the tower got once */
const PARAPETS = [[0.5, 0.49, 0.46], [0.5, 0.44, 0.37], [0.4, 0.42, 0.43], [0.47, 0.39, 0.34]];

function pointTower(floors, axes, seed, dusk) {
	const rnd = chance(`point-tower:${seed}`);
	const F = Math.round(clamp(floors, 12, 26));
	const N = Math.round(clamp(axes, 5, 7));
	const Wd = N * TOWER.axis, P = TOWER.plinth, S = TOWER.storey;
	const top = P + F * S;
	const at = top + TOWER.attic;
	const panel = { w: TOWER.axis, h: S, cell: [160, 128] };
	const kinds = TKINDS.map((k) => ({ streaks: tstreaks(k) }));
	const rows = kinds.length;
	const row = (k) => TKINDS.indexOf(k);
	const bag = new Bag();
	const parapetPaint = rnd.pick(PARAPETS);
	const frameOf = rnd.pick([0, 1, 1, 2]);
	const shade = (x, y) => (1 - 0.35 * Math.exp(-y / 3.2)) * (1 - 0.15 * Math.exp(-(at - y) / 5));
	const tintOf = (k = 1) => {
		const t = rnd.range(0.76, 1.0) * k, w = rnd.range(-0.02, 0.02);
		return [t * (1 + w), t, t * (1 - w)];
	};
	const windowOf = (q) => {
		const lit = rnd.chance(q.kind === 'stair' ? 0.5 : 0.2);
		const frame = q.kind === 'stair' ? FRAMES[2] : rnd.chance(0.25) ? rnd.pick(FRAMES) : FRAMES[frameOf];
		return { ...q, glass: 'glass', tone: rnd.pick(GLASS), frame, lit: lit ? rnd.pick(LIT) : null, transoms: q.kind === 'door' ? [1.2] : [] };
	};
	const h = Wd / 2;
	const FRAMESET = {
		front: { o: [-h, 0, h], u: [1, 0, 0], n: [0, 0, 1] },
		right: { o: [h, 0, h], u: [0, 0, -1], n: [1, 0, 0] },
		back: { o: [h, 0, -h], u: [-1, 0, 0], n: [0, 0, -1] },
		left: { o: [-h, 0, -h], u: [0, 0, 1], n: [-1, 0, 0] },
	};
	const sides = sidesOf(N);
	const L = TOWER.loggia;
	for (const [side, frame] of Object.entries(FRAMESET)) {
		const panels = [];
		const recess = [];
		const inner = { o: [frame.o[0] - frame.n[0] * L.deep, 0, frame.o[2] - frame.n[2] * L.deep], u: frame.u, n: frame.n };
		for (let i = 0; i < N; i++) {
			const x = i * TOWER.axis;
			panels.push({ x, y: 0, w: TOWER.axis, h: P, row: row('G'), col: rnd.int(4), tint: tintOf(0.66), open: i % 2 ? [{ x0: 1.2, x1: 2.4, y0: 0.3, y1: 0.7, glass: 'glass', tone: [0.05, 0.05, 0.05], deep: 0.2, sill: false }] : [] });
			for (let f = 0; f < F; f++) {
				const k = sides[side][i];
				const y = P + f * S;
				// the ground floor's middle axes on the front are the lobby, behind its vestibule
				if (side === 'front' && f === 0 && Math.abs(x + TOWER.axis / 2 - h) < TOWER.axis) {
					panels.push({ x, y, w: TOWER.axis, h: S, row: row('G'), col: rnd.int(4), tint: tintOf(0.9), open: [] });
					continue;
				}
				if (k !== 'L') {
					panels.push({ x, y, w: TOWER.axis, h: S, row: row(k), col: rnd.int(4), tint: tintOf(), open: TOPEN[k].map(windowOf) });
					continue;
				}
				// a loggia: the opening in the face (its reveals its side walls, floor and ceiling), the room's wall
				// behind it, the parapet in front, and what its people keep in it
				const tint = tintOf();
				panels.push({ x, y, w: TOWER.axis, h: S, row: row('L'), col: rnd.int(4), tint, open: [{ ...TOPEN.L[0], deep: L.deep, glass: null, sill: false, revealMat: 'concrete' }] });
				const back = TOPEN.R.map(windowOf).map((q) => ({ ...q, x0: q.x0 - 0.15, x1: q.x1 - 0.15, flat: true, frame: null, deep: 0.04, sill: false }));
				recess.push({ x: x + 0.15, y, w: 3.3, h: 2.6, row: row('R'), col: rnd.int(4), tint: tint.map((c) => c * 0.8), open: back });
				const g = shade(x, y);
				const pc = parapetPaint.map((c) => c * g * rnd.range(0.88, 1.05));
				frameBox(bag, 'concrete', frame, x + 0.15, x + 3.45, y, y + L.parapet, -0.12, -0.04, pc, '-y');
				const r = rnd();
				if (r < 0.35) {
					// glazed in: aluminium frames and panes above the parapet, up to the slab
					const yy = y + L.parapet, yt = y + 2.6;
					bag.quad('glass', ...[[x + 0.15, yy], [x + 3.45, yy], [x + 3.45, yt], [x + 0.15, yt]].map(([a, b]) => [frame.o[0] + frame.u[0] * a - frame.n[0] * 0.08, b, frame.o[2] + frame.u[2] * a - frame.n[2] * 0.08]), null, rnd.pick([[0.3, 0.31, 0.31], [0.22, 0.23, 0.24], [0.4, 0.38, 0.35]]));
					for (let k2 = 0; k2 <= 3; k2++) {
						const fx = x + 0.15 + (3.3 * k2) / 3;
						frameBox(bag, 'frame', frame, fx - 0.03, fx + 0.03, yy, yt, -0.1, -0.05, [0.6, 0.6, 0.58], '-y+y-z');
					}
					frameBox(bag, 'frame', frame, x + 0.15, x + 3.45, yy, yy + 0.06, -0.1, -0.05, [0.6, 0.6, 0.58], '-y-z');
				} else if (r < 0.5) {
					// washing on a line across the loggia
					const lz = -0.6, ly = y + 2.3;
					for (let k2 = 0, xx = x + 0.4; k2 < 6 && xx < x + 3.1; k2++) {
						const w = rnd.range(0.2, 0.45), hh = rnd.range(0.25, 0.5);
						if (rnd.chance(0.75)) bag.quad('cloth', ...[[xx, ly - hh], [xx + w, ly - hh], [xx + w, ly], [xx, ly]].map(([a, b]) => [frame.o[0] + frame.u[0] * a + frame.n[0] * lz, b, frame.o[2] + frame.u[2] * a + frame.n[2] * lz]), null, rnd.pick(WASH));
						xx += w + rnd.range(0.05, 0.35);
					}
				}
				if (rnd.chance(0.22)) {
					// a dish on the parapet, turned to the same sky as every other
					const a = x + (rnd.chance(0.5) ? 0.5 : 3.1);
					const pos = new THREE.Vector3(frame.o[0] + frame.u[0] * a + frame.n[0] * 0.1, y + L.parapet + 0.4, frame.o[2] + frame.u[2] * a + frame.n[2] * 0.1);
					const mtx = new THREE.Matrix4().compose(pos, new THREE.Quaternion().setFromEuler(new THREE.Euler(-0.55, 0.4, 0)), new THREE.Vector3(1, 1, 1));
					for (const gg of dish(rnd.range(0.3, 0.42))) bag.geometry('metal', gg, mtx, [0.72, 0.72, 0.7]);
				}
			}
		}
		facade(bag, frame, panels, { mat: 'panel', rows, panel, shade });
		// the attic parapet along the whole face: a blank wall, its picture continuous (see blankWall)
		blankWall(bag, frame, 0, Wd, top, at, { panel, yRef: P, shade, tint: [0.88, 0.88, 0.88], ends: true });
		facade(bag, inner, recess, { mat: 'panel', rows, panel, shade });
	}

	// ── the roof: membrane, the attic's inner faces, coping; the machine room and tank over the core; antennas ──
	const ins = 0.25, a0 = -h + ins, a1 = h - ins;
	bag.quad('roof', [a0, top, a1], [a1, top, a1], [a1, top, a0], [a0, top, a0], [[0, 0], [Wd / 6, 0], [Wd / 6, Wd / 6], [0, Wd / 6]], [0.3, 0.29, 0.28]);
	const ic = [0.62, 0.61, 0.59];
	bag.quad('concrete', [a1, top, a1], [a0, top, a1], [a0, at, a1], [a1, at, a1], null, ic);
	bag.quad('concrete', [a0, top, a0], [a1, top, a0], [a1, at, a0], [a0, at, a0], null, ic);
	bag.quad('concrete', [a0, top, a1], [a0, top, a0], [a0, at, a0], [a0, at, a1], null, ic);
	bag.quad('concrete', [a1, top, a0], [a1, top, a1], [a1, at, a1], [a1, at, a0], null, ic);
	const cp = [0.38, 0.38, 0.37];
	bag.box('metal', -h - 0.03, at, a1, h + 0.03, at + 0.06, h + 0.03, cp, 4, '-y');
	bag.box('metal', -h - 0.03, at, -h - 0.03, h + 0.03, at + 0.06, a0, cp, 4, '-y');
	bag.box('metal', -h - 0.03, at, a0, a0, at + 0.06, a1, cp, 4, '-y');
	bag.box('metal', a1, at, a0, h + 0.03, at + 0.06, a1, cp, 4, '-y');
	const M = TOWER.machine;
	bag.box('concrete', -M.w / 2, top, -M.d / 2 - 1, M.w / 2, top + M.h, M.d / 2 - 1, [0.64, 0.63, 0.61], 3, '-y');
	bag.box('roof', -M.w / 2 - 0.15, top + M.h, -M.d / 2 - 1.15, M.w / 2 + 0.15, top + M.h + 0.15, M.d / 2 - 0.85, [0.33, 0.32, 0.31], 3, '-y');
	// the water tank's steel drum on its own plinth beside it
	const tank = new THREE.CylinderGeometry(1.4, 1.4, 2.6, 12, 1);
	bag.geometry('metal', tank, new THREE.Matrix4().makeTranslation(M.w / 2 - 1.6, top + M.h + 1.45, -1), [0.42, 0.4, 0.37]);
	bag.box('paint', -0.5, top, M.d / 2 - 1 - 0.01, 0.5, top + 2.1, M.d / 2 - 1 + 0.03, [0.3, 0.32, 0.3], 3, '-y');
	// a mobile-phone mast over the machine room: a lattice of bars and three sector panels, and its red light
	const mx = -M.w / 2 + 1.5, mz = -1, mb = top + M.h + 0.15, mt = mb + 6;
	for (const [dx, dz] of [[-0.4, -0.4], [0.4, -0.4], [0.4, 0.4], [-0.4, 0.4]]) bag.box('metal', mx + dx - 0.04, mb, mz + dz - 0.04, mx + dx + 0.04, mt, mz + dz + 0.04, [0.4, 0.4, 0.39], 4, '-y');
	for (let y = mb + 1; y < mt; y += 1.2) bag.box('metal', mx - 0.45, y, mz - 0.45, mx + 0.45, y + 0.05, mz + 0.45, [0.4, 0.4, 0.39], 4, '');
	for (let k = 0; k < 3; k++) {
		const a = (k * Math.PI * 2) / 3 + 0.4;
		const mtx = new THREE.Matrix4().compose(new THREE.Vector3(mx + Math.sin(a) * 0.7, mt - 1, mz + Math.cos(a) * 0.7), new THREE.Quaternion().setFromEuler(new THREE.Euler(0, a, 0)), new THREE.Vector3(1, 1, 1));
		bag.geometry('paint', new THREE.BoxGeometry(0.3, 1.6, 0.12), mtx, [0.82, 0.82, 0.8]);
	}
	bag.box('paint', mx - 0.1, mt, mz - 0.1, mx + 0.1, mt + 0.2, mz + 0.1, [0.7, 0.08, 0.06], 4, '-y');
	// vents and the old TV antennas, a few dishes
	for (let k = 0; k < 4; k++) {
		const vx = rnd.range(-h + 2, h - 2), vz = rnd.range(3, h - 1.5);
		bag.box('concrete', vx - 0.3, top, vz - 0.3, vx + 0.3, top + rnd.range(0.6, 1.2), vz + 0.3, [0.58, 0.57, 0.55], 2, '-y');
	}
	for (let k = 0; k < 2 + rnd.int(3); k++) {
		const mtx = new THREE.Matrix4().compose(new THREE.Vector3(rnd.range(-h + 2, h - 2), top + 0.6, rnd.range(-h + 2, -h + 4)), new THREE.Quaternion().setFromEuler(new THREE.Euler(-0.5, 0.35, 0)), new THREE.Vector3(1.3, 1.3, 1.3));
		for (const g of dish()) bag.geometry('metal', g, mtx, [0.7, 0.7, 0.68]);
	}

	// ── the lobby's vestibule on the front: concrete walls, a canopy, glass doors, steps and a ramp ──
	const p = TOWER.porch;
	const zf = h + p.d;
	bag.box('concrete', -p.w / 2, 0, h, -p.w / 2 + 0.3, p.h, zf, [0.55, 0.54, 0.52], 3, '-y');
	bag.box('concrete', p.w / 2 - 0.3, 0, h, p.w / 2, p.h, zf, [0.55, 0.54, 0.52], 3, '-y');
	bag.box('concrete', -p.w / 2 - 0.5, p.h, h, p.w / 2 + 0.5, p.h + 0.25, zf + 0.8, [0.6, 0.59, 0.57], 3);
	bag.quad('glass', [-p.w / 2 + 0.3, 0.3, zf - 0.3], [p.w / 2 - 0.3, 0.3, zf - 0.3], [p.w / 2 - 0.3, p.h, zf - 0.3], [-p.w / 2 + 0.3, p.h, zf - 0.3], null, [0.12, 0.13, 0.13]);
	for (const fx of [-p.w / 2 + 0.3, -0.9, 0, 0.9, p.w / 2 - 0.3]) bag.box('metal', fx - 0.04, 0.3, zf - 0.34, fx + 0.04, p.h, zf - 0.28, [0.25, 0.26, 0.26], 4, '-y');
	bag.box('metal', -p.w / 2 + 0.3, 2.4, zf - 0.34, p.w / 2 - 0.3, 2.47, zf - 0.28, [0.25, 0.26, 0.26], 4);
	bag.box('concrete', -p.w / 2, 0, h, p.w / 2, 0.3, zf, [0.5, 0.49, 0.47], 2, '-y');
	bag.box('concrete', -1.6, 0, zf, 1.6, 0.15, zf + 0.35, [0.5, 0.49, 0.47], 2, '-y');
	bag.quad('light:window', [-0.25, p.h - 0.01, zf + 0.1], [0.25, p.h - 0.01, zf + 0.1], [0.25, p.h - 0.01, zf + 0.5], [-0.25, p.h - 0.01, zf + 0.5], null, [1, 0.9, 0.7]);
	// the lobby lit behind the glass at dusk
	bag.quad('light:window', [-p.w / 2 + 0.35, 0.35, h + 0.05], [p.w / 2 - 0.35, 0.35, h + 0.05], [p.w / 2 - 0.35, p.h - 0.1, h + 0.05], [-p.w / 2 + 0.35, p.h - 0.1, h + 0.05], null, [0.9, 0.95, 1]);

	const root = new THREE.Group();
	root.name = 'point-tower';
	// one sheet, three materials: the body, its glass, its lit windows (a world draws a kind once per material)
	bag.buildAtlas(root, { seed: rnd.int(1000), dusk, kinds, panel });
	root.userData.size = [Wd, mt + 0.2, Wd + p.d + 0.8];
	return root;
}

// ───────────────────────────────────────────── 3. RECIPE ─────────────────────────────────────────────

const PARAMS = [
	{ id: 'floors', label: 'Floors', type: 'integer', min: 12, max: 26, step: 1, value: 22 },
	{ id: 'axes', label: 'Axes a side (3.6 m)', type: 'integer', min: 5, max: 7, step: 1, value: 6 },
