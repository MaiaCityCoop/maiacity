	for (let k = 0; k < 3; k++) bag.box('paint', 28 + k * 0.1, k * 0.14, Z(zB - 4 - k * 0.05), 29.2, (k + 1) * 0.14, Z(zB - 5.2), [0.55, 0.45, 0.32], 1, '-y');

	// ── the pylon at the lot's entrance: a tall steel post, a sign of made-up glyphs, lit at dusk ──
	const px = pw - 4, pz = lotEnd - 1.5;
	bag.box('metal', px - 0.2, 0, Z(pz) - 0.2, px + 0.2, 7.0, Z(pz) + 0.2, [0.4, 0.4, 0.39], 4, '-y');
	bag.box('metal', px - 1.6, 7.0, Z(pz) - 0.25, px + 1.6, 9.6, Z(pz) + 0.25, [0.35, 0.35, 0.34], 3, '+z-z');
	const prow = (srow + 1 + rnd.int(3)) % 4;
	for (const s of [1, -1]) {
		const zz = Z(pz) + s * 0.26;
		const a = [px - 1.5, 7.1, zz], b = [px + 1.5, 7.1, zz], c = [px + 1.5, 9.5, zz], e = [px - 1.5, 9.5, zz];
		const uv = [[0.2, prow / 4 + 0.003], [0.8, prow / 4 + 0.003], [0.8, (prow + 1) / 4 - 0.003], [0.2, (prow + 1) / 4 - 0.003]];
		if (s > 0) bag.quad('sign', a, b, c, e, uv, [1, 1, 1]);
		else bag.quad('sign', b, a, e, c, uv, [1, 1, 1]);
	}

	const root = new THREE.Group();
	root.name = 'discount-store';
	// one sheet, three materials: the body (steel sheet and asphalt baked into the sheet as many tiles as they span,
	// the name boards beside them), its glass, its lit windows
	const cladding = claddingTile(rnd.int(1000), true), tarmac = asphaltTile(rnd.int(1000), true), sign = storeSigns(rnd.int(1000), true);
	bag.buildAtlas(root, { seed: rnd.int(1000), dusk, kinds: [{ streaks: [] }], panel: { w: 6, h: 3 }, pictures: { sign }, tiled: { cladding: { pic: cladding }, asphalt: { pic: tarmac } } });
	root.userData.size = [STORE.plot.w, H.h + 0.12, lotEnd - zBack];
	return root;
}

