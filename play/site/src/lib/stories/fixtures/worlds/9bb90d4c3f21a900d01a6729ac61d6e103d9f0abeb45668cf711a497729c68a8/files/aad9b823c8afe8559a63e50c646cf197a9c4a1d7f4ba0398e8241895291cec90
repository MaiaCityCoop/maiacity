					else bag.quad('frame', W(ax, ay - f, fz), W(bx, ay - f, fz), W(bx, ay + f, fz), W(ax, ay + f, fz), null, fc);
				};
				// the bottom rail hides behind the sill: three bars and the mullions
				bar(X0 + f, Y0, X0 + f, Y1), bar(X1 - f, Y0, X1 - f, Y1), bar(X0, Y1 - f, X1, Y1 - f);
				for (const fx of q.mullions ?? []) bar(X0 + fx, Y0, X0 + fx, Y1);
				for (const fy of q.transoms ?? []) bar(X0, Y0 + fy, X1, Y0 + fy);
			}
			// the sill: a strip of galvanised steel standing out from the panel, catching the light
			if (q.sill !== false && q.y0 > 0.05) {
				const s0 = W(X0 - 0.03, Y0 - 0.04, 0.05), s1 = W(X1 + 0.03, Y0 - 0.04, 0.05), s2 = W(X1 + 0.03, Y0, -0.02), s3 = W(X0 - 0.03, Y0, -0.02);
				bag.quad('metal', s0, s1, s2, s3, null, [0.42, 0.43, 0.42]);
			}
		}
	}
}

/**
 * A box laid in a facade's frame (x along it, y up, z out of it), from (x0, y0, z0) to (x1, y1, z1) in its metres:
 * a parapet, a pier, a fin. `skip` as Bag.box's, in the frame's own axes ('-y' its underside, '-z' its back).
 */
function frameBox(bag, mat, frame, x0, x1, y0, y1, z0, z1, col, skip = '', tile = 3) {
	const { o, u, n } = frame;
	const W = (x, y, z) => [o[0] + u[0] * x + n[0] * z, o[1] + y, o[2] + u[2] * x + n[2] * z];
	const s = 1 / tile;
	const uv = (a, b, c, d) => [[a * s, c * s], [b * s, c * s], [b * s, d * s], [a * s, d * s]];
	if (!skip.includes('+z')) bag.quad(mat, W(x0, y0, z1), W(x1, y0, z1), W(x1, y1, z1), W(x0, y1, z1), uv(x0, x1, y0, y1), col);
	if (!skip.includes('-z')) bag.quad(mat, W(x1, y0, z0), W(x0, y0, z0), W(x0, y1, z0), W(x1, y1, z0), uv(x0, x1, y0, y1), col);
	if (!skip.includes('+y')) bag.quad(mat, W(x0, y1, z1), W(x1, y1, z1), W(x1, y1, z0), W(x0, y1, z0), uv(x0, x1, z0, z1), col);
	if (!skip.includes('-y')) bag.quad(mat, W(x0, y0, z0), W(x1, y0, z0), W(x1, y0, z1), W(x0, y0, z1), uv(x0, x1, z0, z1), col);
	if (!skip.includes('-x')) bag.quad(mat, W(x0, y0, z0), W(x0, y0, z1), W(x0, y1, z1), W(x0, y1, z0), uv(z0, z1, y0, y1), col);
	if (!skip.includes('+x')) bag.quad(mat, W(x1, y0, z1), W(x1, y0, z0), W(x1, y1, z0), W(x1, y1, z1), uv(z0, z1, y0, y1), col);
}

/**
 * A blank wall (a gable, an attic band): one plane whose picture is laid on in metres, continuous across it, its
 * panels' joints and stains drawn in the picture (`blank`: two panels by three storeys, repeating), its grime a
 * smooth colour by height. Nothing in it changes from one panel to the next, so when a world draws it far off by a
 * simplified copy (play's levels of detail weld corners that agree and fold flat walls into big triangles), the
 * picture cannot shear across them. `frame` as facade's; `y0`–`y1` its height, `yRef` a floor level the joints keep
 * to, `rows` the heights it is cut at for the colour (each cut's corners alike on both sides, so they weld).
 */
function blankWall(bag, frame, x0, x1, y0, y1, opts) {
	const { panel, yRef = 0, shade = () => 1, tint = [1, 1, 1], cuts = [] } = opts;
	// `ends` pulls its ends in by a hair (an attic band meeting a gable at the corner): two blank walls never share a
	// corner, so a simplifier welding by place alone cannot hand one wall the other's mapping there
	const { o, u, n } = frame;
	const W = (x, y) => [o[0] + u[0] * x, o[1] + y, o[2] + u[2] * x];
	if (opts.ends) (x0 += 0.003), (x1 -= 0.003);
	// the wall's own picture in the building's sheet: the whole wall at once, its panels' joints where they stand; two
	// walls of one size and level share it
	const key = `blank:${(x1 - x0).toFixed(2)}x${(y1 - y0).toFixed(2)}@${(y0 - yRef).toFixed(2)}`;
	bag.walls[key] = { w: x1 - x0, h: y1 - y0, from: y0 - yRef, panel };
	const uv = (x, y) => [(x - x0) / (x1 - x0), (y - y0) / (y1 - y0)];
	const col = (y) => tint.map((c) => c * shade(0, y));
	const ys = [y0, ...cuts.filter((y) => y > y0 + 1e-6 && y < y1 - 1e-6), y1];
	for (let i = 0; i < ys.length - 1; i++) {
		const a = ys[i], b = ys[i + 1];
		bag.quad(key, W(x0, a), W(x1, a), W(x1, b), W(x0, b), [uv(x0, a), uv(x1, a), uv(x1, b), uv(x0, b)], [col(a), col(a), col(b), col(b)]);
	}
	void n;
}

/** the materials every concrete building of the old city uses, its pictures made once a build */
function materials(seed, dusk, kinds, panel, extra = {}) {
	const atlas = panelAtlas(kinds, panel, seed);
	// the blank walls' picture: two panels by three storeys of plain panels, laid on in metres
	const blank = panelAtlas([{ streaks: [] }, { streaks: [] }, { streaks: [] }], { ...panel, cols: 2 }, seed + 7);
	const grime = grimeTile(256, seed + 101);
	const std = (o) => new THREE.MeshStandardMaterial({ vertexColors: true, ...o });
	// the lit windows' OFF look is dark glass, as the others; the page (or `dusk`, 0 by default) lights them
	const lit = new THREE.MeshStandardMaterial({ color: '#16191c', emissive: '#ffc77a', emissiveIntensity: 1.6 * dusk, roughness: 0.15, metalness: 0.5, vertexColors: false });
	lit.name = 'light:window';
	const m = {
		panel: std({ map: atlas, roughness: 0.95 }),
		blank: std({ map: blank, roughness: 0.95 }),
		concrete: std({ map: grime, roughness: 0.95 }),
		glass: std({ color: '#ffffff', roughness: 0.12, metalness: 0.55 }),
		frame: std({ color: '#ffffff', roughness: 0.6 }),
		metal: std({ color: '#ffffff', roughness: 0.45, metalness: 0.6 }),
		paint: std({ color: '#ffffff', roughness: 0.85 }),
		roof: std({ map: grime, roughness: 1 }),
		cloth: std({ color: '#ffffff', roughness: 1, side: THREE.DoubleSide }),
		'light:window': lit,
		...extra,
	};
	for (const [k, v] of Object.entries(m)) v.name = k;
	return m;
}

/**
 * ONE PICTURE FOR A WHOLE BUILDING. A world draws every kind once per material at each level of detail, so a building
 * of ten materials costs ten draws where one would do. The Sheet lays every picture a building needs side by side in
 * one texture (shelf by shelf, a few pixels apart so the far mipmaps do not bleed), and Bag.buildAtlas draws the
 * building with three materials: its body (everything opaque, the pictures from the sheet and its colours as vertex
 * colours), its glass, and its lit windows (`light:window`).
 */
class Sheet {
	constructor(width = 2048, pad = 4) {
		this.W = width;
		this.pad = pad;
		this.items = [];
		this.x = 0;
		this.y = 0;
		this.row = 0;
	}
	/** a picture of w × h pixels, its `pixel(x, y)` in its own pixels (y up); gives its place, filled in by texture() */
	add(w, h, pixel) {
		w = Math.max(1, Math.round(w)), h = Math.max(1, Math.round(h));
		if (this.x + w + this.pad > this.W) (this.x = 0), (this.y += this.row + this.pad), (this.row = 0);
		const it = { x: this.x, y: this.y, w, h, pixel, region: null };
		this.items.push(it);
		this.x += w + this.pad;
		this.row = Math.max(this.row, h);
		return it;
	}
	/** the texture, and every item's region in it as [u0, v0, u1, v1] (half a pixel in from its edges) */
	texture() {
		const W = this.W, H = this.y + this.row;
		const data = new Uint8Array(W * H * 4);
		for (const it of this.items) {
			for (let y = 0; y < it.h; y++)
				for (let x = 0; x < it.w; x++) {
					const c = it.pixel(x, y);
					const i = ((it.y + y) * W + it.x + x) * 4;
					data[i] = Math.round(clamp(srgb(c[0])) * 255);
					data[i + 1] = Math.round(clamp(srgb(c[1])) * 255);
					data[i + 2] = Math.round(clamp(srgb(c[2])) * 255);
					data[i + 3] = 255;
				}
			it.region = [(it.x + 0.5) / W, (it.y + 0.5) / H, (it.x + it.w - 0.5) / W, (it.y + it.h - 0.5) / H];
		}
		const t = new THREE.DataTexture(data, W, H, THREE.RGBAFormat);
		t.colorSpace = THREE.SRGBColorSpace;
		t.anisotropy = 8;
		t.generateMipmaps = true;
		t.minFilter = THREE.LinearMipmapLinearFilter;
		t.magFilter = THREE.LinearFilter;
		t.needsUpdate = true;
		return t;
	}
}

/** a picture's pixels worked out once ({ w, h, pixel } in, the same out, its pixel now a lookup) */
function cached(pic) {
	const data = new Float32Array(pic.w * pic.h * 3);
	for (let y = 0; y < pic.h; y++)
		for (let x = 0; x < pic.w; x++) {
			const c = pic.pixel(x, y), i = (y * pic.w + x) * 3;
			(data[i] = c[0]), (data[i + 1] = c[1]), (data[i + 2] = c[2]);
		}
	return { w: pic.w, h: pic.h, pixel: (x, y) => { const i = (y * pic.w + x) * 3; return [data[i], data[i + 1], data[i + 2]]; } };
}

/** what each of the Bag's names becomes in a building drawn from one sheet */
const FLAT = new Set(['frame', 'metal', 'paint', 'cloth']); // a plain colour: the sheet's white, the vertex colour
const STRETCH = new Set(['concrete', 'roof', 'shutter']); // each face its own: the whole of its picture laid on it

/**
 * Draw the Bag with three materials from one Sheet. `o`: { seed, dusk, kinds, panel, pictures: { name: { w, h, pixel } } }
 * (a building's own pictures, by the Bag's name that shows them: a sign board, a shutter). The panels take the panel
 * atlas; each blank wall its own picture of itself (blankWall); `concrete` and `roof` faces each the grime picture
 * whole; frames, metal, paint and cloth (both its sides) the sheet's white under their vertex colours.
 */
Bag.prototype.buildAtlas = function (root, o) {
	const sheet = new Sheet();
	const regions = {};
	const atlas = panelAtlas(o.kinds, o.panel, o.seed, true);
	regions.panel = sheet.add(atlas.w, atlas.h, atlas.pixel);
	regions.white = sheet.add(8, 8, () => [1, 1, 1]);
	const grime = grimeTile(256, o.seed + 101, true);
	regions.grime = sheet.add(256, 256, grime.pixel);
	// the blank walls: each its own picture, the plain panels (two by three storeys, repeating) laid on at 20 px a metre
	const blank = cached(panelAtlas([{ streaks: [] }, { streaks: [] }, { streaks: [] }], { ...o.panel, cols: 2 }, o.seed + 7, true));
	const [bcw, bch] = o.panel.cell ?? ATLAS.cell;
	for (const [key, w] of Object.entries(this.walls)) {
		const ppm = Math.min(28, 2040 / w.w, 2040 / w.h);
		const at = (mx, my) => {
			const tx = ((mx % (2 * w.panel.w)) + 2 * w.panel.w) % (2 * w.panel.w), ty = ((my % (3 * w.panel.h)) + 3 * w.panel.h) % (3 * w.panel.h);
			return blank.pixel(Math.min(blank.w - 1, Math.floor((tx / w.panel.w) * bcw)), Math.min(blank.h - 1, Math.floor((ty / w.panel.h) * bch)));
		};
		// each pixel the mean of the panels' picture across it (3 × 3 samples), so a joint thinner than a pixel still shows
		regions[key] = sheet.add(w.w * ppm, Math.max(2, w.h * ppm), (x, y) => {
			const c = [0, 0, 0];
			for (let i = 0; i < 3; i++)
				for (let j = 0; j < 3; j++) {
					const q = at((x + (i + 0.5) / 3) / ppm, w.from + (y + (j + 0.5) / 3) / ppm);
					(c[0] += q[0] / 9), (c[1] += q[1] / 9), (c[2] += q[2] / 9);
				}
			return c;
		});
	}
	for (const [name, pic] of Object.entries(o.pictures ?? {})) regions[name] = sheet.add(pic.w, pic.h, pic.pixel);
	// the repeating pictures (`tiled`: board-marked concrete, steel sheet, asphalt): their uvs count tiles, as a
	// repeating texture takes them. Each is baked into the sheet as many tiles as its faces span, shrunk to fit:
	// `shift: false` over the uvs of all its faces at once (faces that meet keep one continuous picture); `shift: true`
	// each face moved by whole tiles to start at the first (faces that stand alone: one region however far apart)
	const tiled = {};
	for (const [name, tp] of Object.entries(o.tiled ?? {})) {
		const t = this.parts.get(name);
		if (!t) continue;
		let u0 = Infinity, u1 = -Infinity, v0 = Infinity, v1 = -Infinity;
		const n = t.p.length / 3;
		const shifts = [];
		for (let q = 0; q < n; q += 6) {
			let a0 = Infinity, a1 = -Infinity, b0 = Infinity, b1 = -Infinity;
			for (let k = q; k < Math.min(n, q + 6); k++) (a0 = Math.min(a0, t.uv[2 * k])), (a1 = Math.max(a1, t.uv[2 * k])), (b0 = Math.min(b0, t.uv[2 * k + 1])), (b1 = Math.max(b1, t.uv[2 * k + 1]));
			const su = tp.shift ? Math.floor(a0) : 0, sv = tp.shift ? Math.floor(b0) : 0;
			shifts.push([su, sv]);
			(u0 = Math.min(u0, a0 - su)), (u1 = Math.max(u1, a1 - su)), (v0 = Math.min(v0, b0 - sv)), (v1 = Math.max(v1, b1 - sv));
		}
		(u0 = Math.floor(u0)), (v0 = Math.floor(v0)), (u1 = Math.max(u0 + 1, Math.ceil(u1))), (v1 = Math.max(v0 + 1, Math.ceil(v1)));
		const pic = (tp.cached ??= cached(tp.pic)), k = Math.min(1, 1600 / ((u1 - u0) * pic.w), 1600 / ((v1 - v0) * pic.h));
		const tw = pic.w * k, th = pic.h * k;
		const region = sheet.add((u1 - u0) * tw, (v1 - v0) * th, (x, y) => {
			// each pixel the mean of the tile across it (2 × 2 samples)
			const c = [0, 0, 0];
			for (let i = 0; i < 2; i++)
				for (let j = 0; j < 2; j++) {
					const px = Math.floor((((x + (i + 0.5) / 2) / tw) % 1) * pic.w), py = Math.floor((((y + (j + 0.5) / 2) / th) % 1) * pic.h);
					const q = pic.pixel(Math.min(pic.w - 1, px), Math.min(pic.h - 1, py));
					(c[0] += q[0] / 4), (c[1] += q[1] / 4), (c[2] += q[2] / 4);
				}
			return c;
		});
		tiled[name] = { region, u0, v0, U: u1 - u0, V: v1 - v0, shifts };
	}
	const map = sheet.texture();

	const body = { p: [], n: [], uv: [], c: [] }, glass = { p: [], n: [], uv: [], c: [] }, lit = { p: [], n: [], uv: [], c: [] };
	const lay = (r, u, v) => [r[0] + clamp(u) * (r[2] - r[0]), r[1] + clamp(v) * (r[3] - r[1])];
	for (const [name, t] of this.parts) {
		const into = name === 'glass' ? glass : name.startsWith('light:') ? lit : body;
		const n = t.p.length / 3;
		const reg = FLAT.has(name) ? regions.white.region : name === 'concrete' || name === 'roof' ? regions.grime.region : regions[name]?.region ?? regions.white.region;
		const tl = tiled[name];
		for (let q = 0; q < n; q += 6) {
			// a quad's six corners (a geometry's triangles come in sixes too, or end short: taken as they come)
			const m = Math.min(6, n - q);
			let u0 = Infinity, u1 = -Infinity, v0 = Infinity, v1 = -Infinity;
			if (STRETCH.has(name)) for (let k = q; k < q + m; k++) (u0 = Math.min(u0, t.uv[2 * k])), (u1 = Math.max(u1, t.uv[2 * k])), (v0 = Math.min(v0, t.uv[2 * k + 1])), (v1 = Math.max(v1, t.uv[2 * k + 1]));
			const sides = name === 'cloth' ? [false, true] : [false];
			for (const back of sides) {
				const order = back ? [0, 2, 1, 3, 5, 4] : [0, 1, 2, 3, 4, 5];
				for (const j of order.slice(0, m)) {
					const k = q + j;
					into.p.push(t.p[3 * k], t.p[3 * k + 1], t.p[3 * k + 2]);
					const s = back ? -1 : 1;
					into.n.push(s * t.n[3 * k], s * t.n[3 * k + 1], s * t.n[3 * k + 2]);
					into.c.push(t.c[3 * k], t.c[3 * k + 1], t.c[3 * k + 2]);
					let u = t.uv[2 * k], v = t.uv[2 * k + 1];
					if (tl) {
						const [su, sv] = tl.shifts[q / 6];
						into.uv.push(...lay(tl.region.region, (u - su - tl.u0) / tl.U, (v - sv - tl.v0) / tl.V));
						continue;
					}
					if (FLAT.has(name)) (u = 0.5), (v = 0.5);
					else if (STRETCH.has(name)) (u = u1 > u0 ? (u - u0) / (u1 - u0) : 0.5), (v = v1 > v0 ? (v - v0) / (v1 - v0) : 0.5);
					into.uv.push(...(into === body ? lay(reg, u, v) : [u, v]));
				}
			}
		}
	}
	const mesh = (t, mat, name) => {
		if (!t.p.length) return;
		const g = new THREE.BufferGeometry();
		g.setAttribute('position', new THREE.Float32BufferAttribute(t.p, 3));
		g.setAttribute('normal', new THREE.Float32BufferAttribute(t.n, 3));
		g.setAttribute('uv', new THREE.Float32BufferAttribute(t.uv, 2));
		g.setAttribute('color', new THREE.Float32BufferAttribute(t.c, 3));
		g.computeBoundingSphere();
		const m = new THREE.Mesh(g, mat);
		m.name = name;
		m.castShadow = name !== 'light:window';
		m.receiveShadow = true;
		root.add(m);
	};
	const bodyM = new THREE.MeshStandardMaterial({ vertexColors: true, map, roughness: 0.92 });
	bodyM.name = 'body';
	const glassM = new THREE.MeshStandardMaterial({ vertexColors: true, color: '#ffffff', roughness: 0.12, metalness: 0.55 });
	glassM.name = 'glass';
	// the lit windows' OFF look is dark glass; the page (or `dusk`, 0 by default) lights them
	const litM = new THREE.MeshStandardMaterial({ color: '#16191c', emissive: '#ffc77a', emissiveIntensity: 1.6 * clamp(o.dusk), roughness: 0.15, metalness: 0.5 });
	litM.name = 'light:window';
	mesh(body, bodyM, 'body'), mesh(glass, glassM, 'glass'), mesh(lit, litM, 'light:window');
	return root;
};

/** a satellite dish, its mouth toward +z: a shallow bowl, the feed arm and its head; ~0.8 m across */
function dish(r = 0.4) {
	const pts = [];
	for (let i = 0; i <= 3; i++) {
		const t = i / 3;
		pts.push(new THREE.Vector2(r * t, (r * t) ** 2 * 0.55));
	}
	const bowl = new THREE.LatheGeometry(pts, 8);
	bowl.rotateX(Math.PI / 2);
	const arm = new THREE.BoxGeometry(0.03, 0.03, r * 1.3);
	arm.translate(0, -r * 0.5, r * 0.55);
	arm.rotateX(-0.6);
	const head = new THREE.BoxGeometry(0.07, 0.07, 0.1);
	head.translate(0, 0, r * 0.75);
	return [bowl, arm, head].map((g) => (g.index ? g.toNonIndexed() : g));
}


// ───────────────────────────────────────────── 2. THE STORE AND ITS CAR PARK ─────────────────────────────────────────────

const STORE = {
	hall: { w: 70, d: 35, h: 6.5, roof: 6.0, plinth: 1.0, front: 5 }, // the hall: x, z, parapet, roof, precast plinth, its front face's z, m
	glazing: { x0: -30, x1: -8, h: 4.0 }, // the shop front's glass, m
	canopy: { x0: -32, x1: 0, out: 4.0, y: 3.6 }, // over the walk along the front, m
	bay: { w: 2.5, d: 5.0 }, // a parking space, m (the usual 2.50 × 5.00)
	aisle: 6.0, // between two rows of spaces, m (two-way, 90° parking)
	lane: 4.0, // the fire lane along the walk, m
	plot: { w: 90, back: 15, side: 8 }, // the plot's width, the delivery yard behind, the side lane, m
	dock: { door: [3.0, 3.0], level: 1.2 }, // the loading doors and the height of a lorry's bed, m
};

/** trapezoidal steel sheet, 2 m a tile: ribs every 25 cm (their faces in light and shade), faded paint, dirt down the troughs */
function claddingTile(seed, raw) {
	const W = 256, H = 256, ppm = 128;
	return picture(W, H, (x, y) => {
		const p = (x % 32) / 32; // across one rib's pitch
		// the profile: a crest, a slope in shade, the trough, a slope in light
		let v = p < 0.3 ? 0.62 : p < 0.4 ? 0.48 : p < 0.85 ? 0.58 : 0.66;
		v += (fbm2(x / 50, y / 50, seed, 3) - 0.5) * 0.08;
		// dirt washed down the troughs, heavier toward the foot of each tile (the wall's foot gets its own from the colour)
		if (p > 0.4 && p < 0.85) v -= Math.max(0, noise2(Math.floor(x / 32), y / 90, seed + 1) - 0.3) * 0.3;
		v -= Math.max(0, fbm2(x / 30, y / 120, seed + 4, 3) - 0.5) * 0.3;
		// rust round the fixings, a row every metre
		if ((y % ppm) < 3 && p > 0.45 && p < 0.55 && hash2(Math.floor(x / 32), Math.floor(y / ppm), seed) > 0.6) v -= 0.12;
		v = clamp(v, 0.05, 1);
		return [v * 0.97, v * 0.97, v * 0.94];
	}, raw);
}

/** asphalt, 8 m a tile: grey grain, aggregate, patches, oil where the cars stand, cracks as fine dark lines */
function asphaltTile(seed, raw) {
	const W = 512, H = 512;
	return picture(W, H, (x, y) => {
		let v = 0.13 + (noise2(x * 0.9, y * 0.9, seed) - 0.5) * 0.05 + (fbm2(x / 70, y / 70, seed + 1, 4) - 0.5) * 0.06;
		if (hash2(x, y, seed + 2) > 0.985) v += 0.06;
		const oil = fbm2(x / 30, y / 30, seed + 3, 3);
		if (oil > 0.62) v -= (oil - 0.62) * 0.25;
		const patch = fbm2(x / 120 + 5, y / 120, seed + 4, 2);
		if (patch > 0.6) v -= 0.025;
		const crack = noise2(x / 40, y / 40, seed + 5);
		if (Math.abs(crack - 0.5) < 0.006) v -= 0.06;
		v = clamp(v, 0.03, 1);
		return [v, v, v * 1.02];
	}, raw);
}

/** the store's name boards: made-up glyphs on a faded ground (no word, no name), 4 rows, each a board 4 : 1 */
function storeSigns(seed, raw) {
	const W = 512, RH = 128, H = RH * 4;
	const grounds = [[0.75, 0.62, 0.15], [0.12, 0.25, 0.5], [0.6, 0.12, 0.1], [0.85, 0.83, 0.78]];
	const inks = [[0.12, 0.14, 0.35], [0.92, 0.85, 0.3], [0.95, 0.93, 0.88], [0.6, 0.1, 0.08]];
	return picture(W, H, (x, y) => {
		const r = Math.floor(y / RH), ly = y - r * RH, s = seed + r * 37;
		const n = 5 + (r % 3);
		const gw = (W * 0.8) / n, x0 = W * 0.1, gh = RH * 0.5, y0 = RH * 0.25;
		let c = grounds[r];
		const gi = Math.floor((x - x0) / gw);
		if (gi >= 0 && gi < n && ly >= y0 && ly < y0 + gh) {
			const gx = (x - x0 - gi * gw) / (gw * 0.8), gy = (ly - y0) / gh;
			if (gx < 1) {
				const bx = Math.floor(gx * 3), by = 4 - Math.floor(gy * 5), k = by * 3 + bx;
				if (bx === 0 || hash2(gi, k, s) > 0.5) c = inks[r];
			}
		}
		if (ly < 5 || ly > RH - 6 || x < 5 || x > W - 6) c = [0.85, 0.85, 0.83];
		const fade = 0.6 + 0.25 * fbm2(x / 50, y / 25, s, 3);
		return c.map((q) => q * fade + 0.45 * (1 - fade) * 0.7);
	}, raw);
}

