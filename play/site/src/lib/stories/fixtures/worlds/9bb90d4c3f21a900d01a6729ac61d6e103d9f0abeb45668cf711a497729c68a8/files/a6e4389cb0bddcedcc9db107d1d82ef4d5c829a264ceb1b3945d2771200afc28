	const gm = (g0 + g1) / 2, gh = g1 - g0;
	b.add('rubber', box(2 * W - 0.19, gh + 0.08, 0.02, [0, gm, zAt(gm) + 0.006], { rx: rake, seg: 1 }));
	b.add('glass', box(2 * W - 0.29, gh, 0.02, [0, gm, zAt(gm) + 0.014], { rx: rake, seg: 1 }));
	b.add('plastic', box(2 * W - 0.15, 0.05, 0.26, [0, g1 + 0.1, zAt(g1 + 0.1) + 0.04], { rx: 0.25, seg: 1 }));
	// the grille between the bumper and the glass
	const gr0 = o.bumper + 0.12, gr1 = g0 - 0.2;
	b.add('plastic', box(2 * W - 0.55, gr1 - gr0, 0.03, [0, (gr0 + gr1) / 2, zf], { seg: 1 }));
	const n = Math.max(2, Math.round((gr1 - gr0) / 0.14));
	for (let i = 0; i < n; i++) b.add('chassis', box(2 * W - 0.65, 0.05, 0.03, [0, gr0 + 0.08 + (i * (gr1 - gr0 - 0.16)) / (n - 1), zf + 0.018], { seg: 1 }));
	for (const s of [1, -1]) {
		const wz = Math.min(0.9, depth - 0.75);
		b.add('glass', box(0.02, gh * 0.75, wz, [s * (W + 0.002), gm + 0.04, zf - 0.23 - wz / 2], { seg: 1 }));
		b.add('chassis', box(0.012, roof - bottom - 0.4, 0.012, [s * (W + 0.004), (roof + bottom) / 2 - 0.1, zf - 1.2], { seg: 1 }));
		b.add('plastic', box(0.03, 0.04, 0.2, [s * (W + 0.01), g0 + 0.05, zf - 1.05], { seg: 1 }));
		// mirrors on their arms
		b.add('steel', rod([s * W, g1 + 0.07, zf - 0.22], [s * (W + 0.18), g1 + 0.07, zf - 0.08], 0.018, 6));
		b.add('steel', rod([s * W, g0 + 0.3, zf - 0.22], [s * (W + 0.18), g0 + 0.3, zf - 0.08], 0.018, 6));
		b.add('plastic', box(0.07, 0.52, 0.24, [s * (W + 0.2), g1 - 0.28, zf - 0.08], { seg: 1 }));
		// the steps behind the front wheel and the arch's mudguard
		const zw = zFA - wheelR - 0.03;
		b.add('plastic', span([s * (W - 0.24), 0.42, zb + 0.03], [s * (W - 0.04), 0.47, Math.min(zw, zb + 0.3)]));
		b.add('plastic', span([s * (W - 0.24), 0.78, zb + 0.03], [s * (W - 0.04), 0.83, Math.min(zw, zb + 0.3)]));
		b.add('rubber', span([s * (W - 0.4), 0.2, zw - 0.03], [s * W, bottom - 0.1, zw]));
		b.add('plastic', span([s * (W - 0.42), bottom - 0.12, zw], [s * W, bottom + 0.01, zFA + wheelR * 0.75]));
		b.lamp(s > 0 ? 'light:indicator-l' : 'light:indicator-r', box(0.02, 0.05, 0.1, [s * (W + 0.01), bottom + 0.16, zf - 0.55], { seg: 1 }));
		b.add('lensAmber', box(0.08, 0.04, 0.05, [s * (W - 0.3), roof + 0.01, zf - 0.6], { seg: 1 }));
	}
	// the bumper, its headlights and indicators in its top corners, the air dam under it
	const bt = o.bumper;
	b.add('plastic', span([-(W - 0.01), 0.42, zf - 0.4], [W - 0.01, bt, zf + 0.04]));
	b.add('chassis', span([-(W - 0.35), 0.3, zf - 0.35], [W - 0.35, 0.42, zf - 0.05]));
	pair(b, 'light:head', W - 0.42, bt - 0.16, zf + 0.045, 0.4, 0.16, 0.02);
	b.lamp('light:indicator-l', box(0.13, 0.13, 0.02, [W - 0.12, bt - 0.16, zf + 0.045], { seg: 1 }));
	b.lamp('light:indicator-r', box(0.13, 0.13, 0.02, [-(W - 0.12), bt - 0.16, zf + 0.045], { seg: 1 }));
	return zb;
}

/* ============================================================================================================
 * PART 2 · THE BOX TRUCK — an 18 t 4×2 rigid lorry with a cab over its engine and a 7.3 m dry-freight box with a
 * roller shutter, the delivery lorry of the old city's jammed streets: grey with road film, the box streaked from its
 * roof, the shutter dented by years of loading docks.
 *
 * Measures (EU 96/53/EC and the trade's data of 18 t rigids; metres):
 *   9.20 long over the bodies, 2.55 wide over the box (2.88 over the mirrors), 3.75 high;
 *   front overhang 1.35, wheelbase 5.40, rear overhang 2.45; a day cab 1.80 deep, 2.42 wide, its roof 2.95 and a
 *   spoiler to 3.45; the box 7.30 × 2.55 × 2.63 on a floor 1.12 up (2.48 inside); tyres 295/80 R22.5 (1.04 across),
 *   twin at the rear; a tail lift folded under the floor at the back; side guards and a rear underrun guard.
 *   Masses: about 7.5 t empty, 18 t laden; 18 pallets.
 * ============================================================================================================ */

const BT = {
	CAB: 1.8, GAP: 0.1, BOX: 7.3, FO: 1.35, WB: 5.4,
	half: 1.275, floor: 1.12, top: 3.75,
	tyre: { D: 1.044, W: 0.295, rim: 0.5715 },
};
BT.L = BT.CAB + BT.GAP + BT.BOX;
BT.zF = BT.L / 2;
BT.zFA = BT.zF - BT.FO;
BT.zRA = BT.zFA - BT.WB;
BT.zB0 = BT.zF - BT.CAB - BT.GAP; // the box's front wall
BT.zB1 = BT.zB0 - BT.BOX; // its shutter

function boxTruck(m, seed) {
	const T = BT, H = T.half, y0 = T.floor, y1 = T.top, zA = T.zB0, zR = T.zB1, R = T.tyre.D / 2;
	const b = new Body('box-truck', seed, m, {
		wear: { soot: (p) => smooth(0.75, 0.35, p.y) * smooth(0.5, 0.0, Math.hypot(p.x + 0.9, p.z - (T.zRA + 0.7))) },
	});
	const zb = cabOver(b, { zf: T.zF, depth: T.CAB, half: 1.21, bottom: 1.0, glass: [1.72, 2.55], roof: 2.95, deflector: 3.45, zFA: T.zFA, wheelR: R, bumper: 1.0 });

	// the box: GRP sandwich on aluminium posts and rails, a roller shutter at its back
	b.add('paint2', box(2 * H, y1 - y0, zA - zR, [0, (y0 + y1) / 2, (zA + zR) / 2], { seg: 5 }));
	for (const s of [1, -1]) {
		b.add('steel', span([s * (H - 0.02), y0, zR - 0.01], [s * (H + 0.012), y0 + 0.13, zA + 0.01]));
		b.add('steel', span([s * (H - 0.02), y1 - 0.06, zR - 0.01], [s * (H + 0.012), y1 + 0.005, zA + 0.01]));
		for (const z of [zR, zA]) b.add('steel', span([s * (H - 0.06), y0, z - 0.04], [s * (H + 0.014), y1, z + 0.04]));
		for (let z = zR + 1.2; z < zA - 0.4; z += 2.4) b.add('lensAmber', box(0.02, 0.05, 0.1, [s * (H + 0.02), y0 + 0.065, z], { seg: 1 }));
		b.lamp('light:tail', box(0.06, 0.06, 0.03, [s * (H - 0.08), y1 - 0.08, zR - 0.03], { seg: 1 }));
	}
	// the shutter: its slats, its guides, the handle and the step bar under it
	b.add('steel', box(2 * H - 0.22, y1 - y0 - 0.2, 0.03, [0, (y0 + y1) / 2 - 0.02, zR - 0.02], { seg: 1 }));
	for (let y = y0 + 0.2; y < y1 - 0.15; y += 0.115) b.add('chassis', box(2 * H - 0.24, 0.012, 0.012, [0, y, zR - 0.038], { seg: 1 }));
	for (const s of [1, -1]) b.add('chassis', span([s * (H - 0.11), y0 + 0.05, zR - 0.05], [s * (H - 0.05), y1 - 0.08, zR]));
	b.add('chassis', box(0.3, 0.05, 0.05, [0, y0 + 0.2, zR - 0.06], { seg: 1 }));

	// the chassis: two rails from the bumper to the back, axles, the propshaft, the engine and gearbox under the cab
	for (const s of [1, -1]) b.add('chassis', span([s * 0.36, 0.72, zR + 0.3], [s * 0.45, 1.0, T.zF - 0.38]));
	for (let z = zR + 0.4; z < zA; z += 0.9) b.add('chassis', span([-H + 0.05, 0.98, z - 0.04], [H - 0.05, y0, z + 0.04]));
	b.add('chassis', rod([-0.95, R, T.zFA], [0.95, R, T.zFA], 0.07, 8));
	b.add('chassis', rod([-0.98, R, T.zRA], [0.98, R, T.zRA], 0.09, 8));
	b.add('chassis', box(0.42, 0.42, 0.38, [0, R + 0.02, T.zRA], { seg: 1 }));
	b.add('chassis', rod([0, 0.6, T.zRA + 0.2], [0, 0.72, T.zFA - 0.9], 0.05, 6));
	b.add('chassis', span([-0.5, 0.6, T.zFA - 1.3], [0.5, 1.0, zb + 0.15]));
	// the fuel tank on the left, batteries and air tanks on the right, the silencer and its tailpipe out to the side
	b.add('steel', rod([0.9, 0.7, T.zRA + 1.4], [0.9, 0.7, T.zRA + 2.5], 0.26, 12));
	b.add('chassis', span([-1.15, 0.45, T.zRA + 1.4], [-0.55, 0.9, T.zRA + 2.0]));
	b.add('steel', rod([-0.8, 0.6, T.zRA + 2.1], [-0.8, 0.6, T.zRA + 2.8], 0.11, 8));
	b.add('steel', rod([-0.8, 0.5, T.zRA + 0.9], [-1.08, 0.45, T.zRA + 0.75], 0.045, 6));
	// the side guards between the wheels
	const zG0 = T.zRA + R + 0.15, zG1 = T.zFA - R - 0.2;
	for (const s of [1, -1]) {
		for (const y of [0.48, 0.78]) b.add('steel', span([s * (H - 0.08), y, zG0], [s * (H - 0.02), y + 0.1, zG1]));
		for (let z = zG0 + 0.3; z < zG1; z += 1.6) b.add('chassis', span([s * 0.45, 0.5, z - 0.03], [s * (H - 0.08), y0, z + 0.03]));
		// the mudguard over the twin wheels and its flap
		b.add('plastic', span([s * 0.6, y0 - 0.06, T.zRA - 0.6], [s * (H - 0.02), y0 - 0.01, T.zRA + 0.6]));
		b.add('rubber', span([s * 0.6, 0.25, T.zRA - 0.64], [s * (H - 0.04), y0 - 0.06, T.zRA - 0.61]));
	}
	// the tail lift folded under the floor, the rear underrun guard, the lamp bar
	b.add('steel', span([-1.05, 0.62, zR + 0.05], [1.05, 0.95, zR + 0.75]));
	b.add('steel', span([-1.1, 0.42, zR + 0.0], [1.1, 0.58, zR + 0.12]));
	b.add('chassis', span([-1.22, 0.88, zR - 0.02], [1.22, 1.08, zR + 0.1]));
	pair(b, 'light:tail', 0.68, 0.98, zR - 0.025, 0.15, 0.13, 0.02);
	pair(b, 'light:brake', 0.84, 0.98, zR - 0.025, 0.15, 0.13, 0.02);
	b.lamp('light:indicator-l', box(0.15, 0.13, 0.02, [1.0, 0.98, zR - 0.025], { seg: 1 }));
	b.lamp('light:indicator-r', box(0.15, 0.13, 0.02, [-1.0, 0.98, zR - 0.025], { seg: 1 }));
	b.add('lensRed', box(0.45, 0.06, 0.012, [0.6, 0.5, zR - 0.006], { seg: 1 }));
	b.add('lensRed', box(0.45, 0.06, 0.012, [-0.6, 0.5, zR - 0.006], { seg: 1 }));

	const rim = [0.44, 0.44, 0.42];
	b.wheel('1-l', [1.0, R, T.zFA], { ...T.tyre, rimColour: rim });
	b.wheel('1-r', [-1.0, R, T.zFA], { ...T.tyre, rimColour: rim });
	b.wheel('2-l', [0.9, R, T.zRA], { ...T.tyre, dual: true, rimColour: rim });
	b.wheel('2-r', [-0.9, R, T.zRA], { ...T.tyre, dual: true, rimColour: rim });
	return b;
}

/* ============================================================================================================
 * PART 3 · THE RECIPE
 * ============================================================================================================ */

const VARIANTS = {
	white: { label: 'Faded white', cab: '#b8b3a4', box: '#c4bfae' },
	grey: { label: 'Fleet grey', cab: '#5f6261', box: '#9a9b96' },
	blue: { label: 'Faded blue', cab: '#3e5470', box: '#bfbcb0' },
	ochre: { label: 'Faded ochre', cab: '#94804f', box: '#b8ad8f' },
};

const FACTS = {
	length: 9.2, width: { body: 2.55, mirrors: 2.88 }, height: 3.75, unit: 'm',
	wheelbase: BT.WB, frontOverhang: BT.FO, rearOverhang: 2.45,
	cab: { depth: BT.CAB, width: 2.42, roof: 2.95, spoiler: 3.45 },
	box: { length: BT.BOX, width: 2.55, height: 2.63, floor: BT.floor, inside: [7.15, 2.45, 2.48], door: 'roller shutter', pallets: 18 },
	tyres: '295/80 R22.5, twin at the rear',
	mass: { empty: 7500, laden: 18000, unit: 'kg' },
	engine: 'diesel six, about 7 L, 210–240 kW',
	sources: 'Directive 96/53/EC (2.55 m, 18 t two-axle rigid); ETRTO tyre sizes; UN R58 / R73 guards; trade data of 18 t 4×2 distribution rigids with 7.3 m boxes',
};

function build(variant = 'white') {
	const V = VARIANTS[variant] ?? VARIANTS.white;
	const m = materials(grimePicture(variant), { paint: V.cab, paint2: V.box });
	const root = boxTruck(m, variant).build([0, 0, 0]);
	root.name = 'box-truck';
	return root;
}

module.exports.recipe = function (id, v, variant) {
	const name = variant ?? 'white';
	if (!VARIANTS[name]) throw new Error(`no variant ${name} of machines/${id}@${v}`);
	return {
		meta: {
			group: 'machines',
			id,
			version: v,
			variant: name,
			label: `Box truck: ${VARIANTS[name].label}`,
			note: 'A worn 18 t rigid lorry with a 7.3 m box and a roller shutter, 9.2 × 2.55 × 3.75 m, delivering in the old city. Lights named for the page (light:head, tail, brake, indicator-l, indicator-r), wheels as pivots (wheel:<axle>-<l|r>).',
			from: 'Old City: the streets',
			facts: JSON.parse(JSON.stringify(FACTS)),
			params: [],
		},
		build: () => build(name),
	};
};
module.exports.variants = Object.keys(VARIANTS);
module.exports.build = build;

return module.exports.recipe("box-truck", 3, "white");
});
