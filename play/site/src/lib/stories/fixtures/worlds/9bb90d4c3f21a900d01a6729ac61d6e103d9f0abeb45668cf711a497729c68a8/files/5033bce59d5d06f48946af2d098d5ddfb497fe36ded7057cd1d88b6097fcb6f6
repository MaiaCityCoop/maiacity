const PARAMS = [{ id: 'seed', label: 'Seed', type: 'string', value: 'maia', maxLength: 40 }];
const NOTE =
	'An overhead sign gantry over a motorway of four lanes (3.75 m) and its shoulders: a welded box truss of four tubular chords (Ø 168 mm), 1.2 m square, its middle 7.25 m up, spanning 22 m between two legs of twin Ø 340 mm columns braced as ladders, each on a 1 m concrete crash plinth (behind the barrier, at x ±11). ' +
	'Three direction signs hang off its front toward +z, their foot 5.5 m over the road (EU clearance 4.7–5.5 m): aluminium panels 3.2 m tall on Z posts, blue faces faded and streaked, 400 mm white capitals of a stroke font drawn here, and arrows. No real place: CENTRE / RING ROAD over the two left lanes, PORT / INDUSTRY over the third, EXIT 14 / 1000 m over the right lane, its arrow pointing out to the right. ' +
	'The road\'s middle is x = 0, the lanes run along z (their middles at x −5.625, −1.875, 1.875, 5.625); drivers going toward −z read the signs (right-hand traffic: the exit on +x). The sign faces are pictures made by the recipe (DataTextures), aged by its seed.';

function build(seed) {
	const sd = `${seed ?? 'maia'}`;
	const bag = new Bag(sd, 0.5);
	gantry(bag);
	const special = {};
	SIGNS.forEach((S, k) => {
		special[`sign:${k + 1}/face`] = () => new THREE.MeshStandardMaterial({ name: `sign:${k + 1}`, map: signFace(S, sd), roughness: 0.55, metalness: 0 });
	});
	const root = bag.build('sign-gantry', special);
	root.userData.gantry = { lanes: GT.lanes, clear: GT.clear, legs: [-GT.legs, GT.legs], faces: '+z' };
	return root;
}

