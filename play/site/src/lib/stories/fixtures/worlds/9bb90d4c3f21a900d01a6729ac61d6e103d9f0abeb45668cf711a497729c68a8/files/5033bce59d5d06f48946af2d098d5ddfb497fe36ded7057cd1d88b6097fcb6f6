			const [ax, ay] = pts[i - 1], [bx, by] = pts[i];
			const x0 = Math.floor(Math.min(ax, bx) - r - 1), x1 = Math.ceil(Math.max(ax, bx) + r + 1);
			const y0 = Math.floor(Math.min(ay, by) - r - 1), y1 = Math.ceil(Math.max(ay, by) + r + 1);
			const dx = bx - ax, dy = by - ay, ll = dx * dx + dy * dy || 1e-9;
			for (let y = y0; y <= y1; y++)
				for (let x = x0; x <= x1; x++) {
					const t = clamp(((x + 0.5 - ax) * dx + (y + 0.5 - ay) * dy) / ll);
					const d = Math.hypot(ax + t * dx - x - 0.5, ay + t * dy - y - 0.5);
					this.lay(x, y, c, clamp(r + 0.5 - d));
				}
		}
	}
	/** a filled polygon `pts` (pixels) */
	fill(pts, color) {
		const c = new THREE.Color(color).toArray();
		const xs = pts.map((p) => p[0]), ys = pts.map((p) => p[1]);
		for (let y = Math.floor(Math.min(...ys)); y <= Math.ceil(Math.max(...ys)); y++)
			for (let x = Math.floor(Math.min(...xs)); x <= Math.ceil(Math.max(...xs)); x++) {
				// four samples a pixel for soft edges
				let k = 0;
				for (const [sx, sy] of [[0.25, 0.25], [0.75, 0.25], [0.25, 0.75], [0.75, 0.75]]) if (inside(pts, x + sx, y + sy)) k += 0.25;
				this.lay(x, y, c, k);
			}
	}
	/** a line of text, its cap height `cap` pixels, its middle at (cx, by): its baseline at by */
	text(s, cx, by, cap, color, weight = 0.15) {
		const u = cap / 6;
		const gap = 1.3;
		const width = [...s].reduce((sum, ch) => sum + glyph(ch).w + gap, -gap) * u;
		let x = cx - width / 2;
		for (const ch of s) {
			const g = glyph(ch);
			for (const line of g.s) this.stroke(line.map(([gx, gy]) => [x + gx * u, by + gy * u]), cap * weight, color);
			x += (g.w + gap) * u;
		}
		return width;
	}
	/** a border of width `b` pixels, `inset` in from the edge, round corners of radius `rr` */
	border(b, inset, rr, color) {
		const x0 = inset, y0 = inset, x1 = this.w - 1 - inset, y1 = this.h - 1 - inset;
		const pts = [];
		const corner = (cx, cy, a0) => {
			for (let i = 0; i <= 4; i++) {
				const a = a0 + (i / 4) * (Math.PI / 2);
				pts.push([cx + rr * Math.cos(a), cy + rr * Math.sin(a)]);
			}
		};
		corner(x1 - rr, y0 + rr, -Math.PI / 2);
		corner(x1 - rr, y1 - rr, 0);
		corner(x0 + rr, y1 - rr, Math.PI / 2);
		corner(x0 + rr, y0 + rr, Math.PI);
		pts.push(pts[0]);
		this.stroke(pts, b, color);
	}
	/** age it: the colour faded toward grey, dark streaks running down from the top, a dirty foot, by the seed */
	age(seed, fade = 0.25, dirt = 0.35) {
		const o = chance(seed, 'sign')() * 100;
		for (let y = 0; y < this.h; y++)
			for (let x = 0; x < this.w; x++) {
				const i = (y * this.w + x) * 3;
				const v = y / this.h, u = x / this.w;
				const streak = smooth(0.55, 0.9, noise3(u * 40 + o, v * 2.5, 0.5)) * smooth(0.1, 0.6, v);
				const foot = smooth(0.25, 0, v) * (0.6 + 0.4 * noise3(u * 25 + o, v * 12, 3.1));
				const blot = fbm(u * 8 + o, v * 4, 7.7) - 0.5;
				const dark = clamp(dirt * (0.45 * streak + 0.6 * foot + 0.3 * blot));
				const grey = (this.px[i] + this.px[i + 1] + this.px[i + 2]) / 3;
				for (let j = 0; j < 3; j++) this.px[i + j] = (this.px[i + j] + (grey * 0.95 + 0.04 - this.px[i + j]) * fade) * (1 - dark);
			}
		return this;
	}
	/** the picture as a texture (sRGB, mipmapped) */
	texture() {
		const data = new Uint8Array(this.w * this.h * 4);
		// the pixels are linear colours (as THREE.Color holds them), stored as sRGB
		const srgb = (x) => Math.round(255 * clamp(x <= 0.0031308 ? 12.92 * x : 1.055 * Math.pow(x, 1 / 2.4) - 0.055));
		for (let i = 0; i < this.w * this.h; i++) data.set([srgb(this.px[i * 3]), srgb(this.px[i * 3 + 1]), srgb(this.px[i * 3 + 2]), 255], i * 4);
		const t = new THREE.DataTexture(data, this.w, this.h, THREE.RGBAFormat);
		t.colorSpace = THREE.SRGBColorSpace;
		t.magFilter = THREE.LinearFilter;
		t.minFilter = THREE.LinearMipmapLinearFilter;
		t.generateMipmaps = true;
		t.anisotropy = 4;
		t.needsUpdate = true;
		return t;
	}
}
/** is (x, y) inside the polygon (even-odd) */
function inside(pts, x, y) {
	let c = false;
	for (let i = 0, j = pts.length - 1; i < pts.length; j = i++) {
		const [xi, yi] = pts[i], [xj, yj] = pts[j];
		if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) c = !c;
	}
	return c;
}
/** an arrow, `len` long and pointing at `angle` (radians, 0 = up), its middle at (cx, cy), in pixels */
function arrow(len, angle, cx, cy) {
	const s = len / 10;
	const shape = [[-1, -5], [1, -5], [1, 1], [3, 1], [0, 5], [-3, 1], [-1, 1]];
	const c = Math.cos(angle), n = Math.sin(angle);
	return shape.map(([x, y]) => [cx + (x * c + y * n) * s, cy + (-x * n + y * c) * s]);
}

/*
 * ============================================================================================================
 * PART 2 · THE SIGN GANTRY — an overhead sign gantry over a motorway of four lanes (3.75 m each) and its hard
 * shoulders: a welded box truss of four tubular chords, 1.2 m square, spanning 22 m between two legs of twin
 * columns braced as ladders, each on a crash plinth of concrete behind the barrier. Three direction signs hang off
 * its front (+z, toward the traffic): their foot 5.5 m over the road (EU clearance 4.7–5.5 m; it is kept high),
 * blue faces faded and streaked, white words and arrows of no real place: "CENTRE / RING ROAD" over the two left
 * lanes, "PORT / INDUSTRY" over the third, "EXIT 14 / 1000 m" over the right lane with its arrow out to the right.
 * The road's middle is x = 0; the lanes run along z; drivers coming toward −z read the signs.
 * ============================================================================================================
 */

/** the measures, in metres */
const GT = {
	lanes: [-5.625, -1.875, 1.875, 5.625], // the four lanes' middles (x), 3.75 m wide
	legs: 11.0, // the legs stand at x ±11
	truss: { y: 7.25, side: 1.2, bay: 1.375, chord: 0.084, web: 0.042 }, // its middle's height, its square, a bay; tube radii
	column: { r: 0.17, z: 0.6 }, // each leg's two columns (Ø 340 mm), at z ±0.6
	plinth: { h: 1.0, w: 1.0, d: 2.0 }, // the crash plinth under each leg
	clear: 5.5, // the signs' foot over the road
	ppm: 64, // the sign pictures' pixels a metre
};
const GT_C = { steel: '#9b9e99', concrete: '#a29d92', back: '#8d908b', blue: '#1f4e8c', white: '#ece9dc', post: '#7f827d' };

/** the signs: where each hangs (x of its middle), its size, its lines of words and arrows */
const SIGNS = [
	{ x: -3.75, w: 6.8, h: 3.2, lines: ['CENTRE', 'RING ROAD'], arrows: [{ x: -5.625, a: Math.PI }, { x: -1.875, a: Math.PI }] },
	{ x: 1.875, w: 3.4, h: 3.2, lines: ['PORT', 'INDUSTRY'], arrows: [{ x: 1.875, a: Math.PI }] },
	{ x: 5.9, w: 3.8, h: 3.2, lines: ['EXIT 14', '1000 m'], arrows: [{ x: 5.9, a: Math.PI / 4 }] },
];

/** a sign's face: the blue ground, its white border, its words and its arrows */
function signFace(S, seed) {
	const P = GT.ppm;
	const pic = new Picture(Math.round(S.w * P), Math.round(S.h * P), GT_C.blue);
	pic.border(0.06 * P, 0.07 * P, 0.15 * P, GT_C.white);
	const cap = 0.4 * P; // 400 mm capitals (motorway direction signs: 300–450 mm)
	const textX = pic.w / 2;
	pic.text(S.lines[0], textX, pic.h - 0.35 * P - cap, cap, GT_C.white, 0.17);
	pic.text(S.lines[1], textX, pic.h - 0.35 * P - cap - 0.65 * P, cap, GT_C.white, 0.17);
	for (const a of S.arrows) {
		const cx = (a.x - (S.x - S.w / 2)) * P;
		pic.fill(arrow(0.95 * P, a.a, cx, 0.62 * P), GT_C.white);
	}
	return pic.age(`${seed}:${S.x}`, 0.38, 0.55).texture();
}

function gantry(bag) {
	const T = GT.truss, half = T.side / 2;
	const L = GT.legs;
	// the truss: four chords, and in each bay verticals and diagonals on all four faces
	const ys = [T.y - half, T.y + half], zs = [-half, half];
	for (const y of ys) for (const z of zs) bag.add('truss', 'galvanised', rod([-L, y, z], [L, y, z], T.chord, T.chord, 8), GT_C.steel);
	const bays = Math.round((2 * L) / T.bay);
	for (let i = 0; i <= bays; i++) {
		const x = -L + (2 * L * i) / bays;
		// a square frame at each panel point
		for (const z of zs) bag.add('truss', 'galvanised', rod([x, ys[0], z], [x, ys[1], z], T.web, T.web, 5), GT_C.steel);
		for (const y of ys) bag.add('truss', 'galvanised', rod([x, y, zs[0]], [x, y, zs[1]], T.web, T.web, 5), GT_C.steel);
		if (i === bays) break;
		const x2 = -L + (2 * L * (i + 1)) / bays;
		// diagonals, turned each bay, on the front, back, top and bottom faces
		const flip = i % 2 ? 1 : 0;
		for (const z of zs) bag.add('truss', 'galvanised', rod([x, ys[flip], z], [x2, ys[1 - flip], z], T.web, T.web, 5), GT_C.steel);
		for (const y of ys) bag.add('truss', 'galvanised', rod([x, y, zs[flip]], [x2, y, zs[1 - flip]], T.web, T.web, 5), GT_C.steel);
	}
	// the legs: two columns each, braced as a ladder, on a base plate on the plinth
	const C = GT.column, Pl = GT.plinth;
	for (const s of [-1, 1]) {
		const x = s * L;
		bag.add('legs', 'concrete', box(Pl.w, Pl.h, Pl.d, [x, Pl.h / 2, 0]), GT_C.concrete, 0.9);
		const top = T.y + half + 0.1;
		for (const z of [-C.z, C.z]) {
			bag.add('legs', 'galvanised', box(0.5, 0.03, 0.5, [x, Pl.h + 0.015, z]), GT_C.steel);
			bag.add('legs', 'galvanised', cyl(C.r, C.r, top - Pl.h, 12, [x, Pl.h, z]), GT_C.steel);
			bag.add('legs', 'galvanised', cyl(0.01, C.r + 0.01, 0.05, 12, [x, top, z]), GT_C.steel);
		}
		let y0 = Pl.h + 0.4, up = 0;
		const step = 1.2;
		while (y0 < T.y - half - 0.3) {
			const y1 = Math.min(y0 + step, T.y - half);
			bag.add('legs', 'galvanised', rod([x, y0, -C.z], [x, y0, C.z], 0.05, 0.05, 6), GT_C.steel);
			bag.add('legs', 'galvanised', rod([x, y0, up ? -C.z : C.z], [x, y1, up ? C.z : -C.z], 0.04, 0.04, 6), GT_C.steel);
			(y0 = y1), (up = 1 - up);
		}
		// the truss's seat on the columns
		bag.add('legs', 'galvanised', box(0.5, 0.06, 2 * C.z + 0.5, [x, T.y - half - 0.12, 0]), GT_C.steel);
	}
	// the signs: each a panel of aluminium on Z-section posts clamped to the truss's front chords
	const faces = [];
	SIGNS.forEach((S, k) => {
		const y0 = GT.clear, zf = half + 0.32;
		const yMid = y0 + S.h / 2;
		bag.add(`sign:${k + 1}/panel`, 'galvanised', box(S.w, S.h, 0.04, [S.x, yMid, zf - 0.02]), GT_C.back, 0.7);
		// stiffening rails across the back, and the posts up to the top chord
		for (const yy of [y0 + 0.5, y0 + S.h - 0.5]) bag.add(`sign:${k + 1}/panel`, 'galvanised', box(S.w - 0.1, 0.1, 0.06, [S.x, yy, zf - 0.07]), GT_C.post, 0.8);
		const posts = Math.max(2, Math.round(S.w / 1.8));
		for (let i = 0; i < posts; i++) {
			const px = S.x - S.w / 2 + 0.4 + ((S.w - 0.8) * i) / (posts - 1);
			bag.add(`sign:${k + 1}/panel`, 'galvanised', box(0.1, Math.max(S.h, T.y + half - y0) + 0.1, 0.08, [px, y0 + Math.max(S.h, T.y + half - y0) / 2, zf - 0.14]), GT_C.post, 0.8);
			for (const y of ys) bag.add(`sign:${k + 1}/panel`, 'galvanised', box(0.12, 0.16, zf - 0.18 - half + 0.1, [px, y, half + (zf - 0.18 - half) / 2]), GT_C.post, 0.8);
		}
		bag.add(`sign:${k + 1}/face`, 'paint', plate(S.w, S.h, [S.x, yMid, zf + 0.001]), '#ffffff', 0);
		faces.push(S);
	});
	return faces;
}

