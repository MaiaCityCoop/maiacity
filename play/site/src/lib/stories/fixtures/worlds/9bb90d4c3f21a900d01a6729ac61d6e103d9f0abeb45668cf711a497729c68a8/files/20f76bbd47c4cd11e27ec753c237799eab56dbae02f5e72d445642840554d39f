/** the bracket from the column's top out to `dir` (+1: +z, −1: −z): a sweeping curve, its tip level; returns the tip */
function bracket(bag, L, dir) {
	const mat = L.galvanised ? 'galvanised' : 'paint';
	const pts = [];
	const n = 7;
	// a quarter curve rising off the column, then running out nearly level
	for (let i = 0; i <= n; i++) {
		const t = i / n;
		const a = (t * Math.PI) / 2;
		const z = dir * L.reach * (1 - Math.cos(a)) * 0.85 + dir * L.reach * 0.15 * t;
		const y = L.h - 0.25 + L.rise * Math.sin(a);
