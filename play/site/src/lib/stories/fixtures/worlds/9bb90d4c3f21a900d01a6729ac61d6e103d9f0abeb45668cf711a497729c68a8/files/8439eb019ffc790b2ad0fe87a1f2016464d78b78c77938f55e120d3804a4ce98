function lightAt(offset, axis, t) {
	let p = (((t + offset) % PERIOD) + PERIOD) % PERIOD;
	for (const [ax, colour, d] of CYCLE) {
		if (p < d) return ax === axis ? colour : 'red';
		p -= d;
