				// one of three variants of its kind, the skyline's own (the same heights and seeds): a few builds shared by every
				// block, not one of its own for each building (123 builds were more than a phone holds)
				const v = Math.floor(chance(seed, 'fl', b, k) * 3);
				const floors = kind === 'slab' || kind === 'office' ? `floors=${[7, 10, 14][v]}` : kind === 'tower' ? `floors=${[14, 20, 26][v]}` : '';
				useNode(root, H[kind], [vals, floors, `seed=o${v}`].filter(Boolean).join('&'), x, 0.23, z, yaw + turn);
