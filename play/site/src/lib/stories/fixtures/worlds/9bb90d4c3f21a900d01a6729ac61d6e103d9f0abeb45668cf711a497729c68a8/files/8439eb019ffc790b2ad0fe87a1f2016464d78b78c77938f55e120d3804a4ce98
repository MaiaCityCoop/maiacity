}
const nearRow = (z) => CITY.rows.some((r) => Math.abs(z - r) < CITY.street / 2 + 4.5);
const nearCol = (x) => CITY.cols.some((c) => Math.abs(x - c) < widthOfCol(c) / 2 + 4.5);
/** the edge land along the frontage road: sheds in fenced yards, nothing green */
function buildEdgeLand(seed, bag, root) {
	[[-150, -720], [-160, -620], [-150, -500], [-165, -420], [-150, -250]].forEach(([x, z], k) => {
		const [w, h, d] = chance(seed, 'wy', k) < 0.5 ? [44, 9, 30] : [30, 8, 44];
		bag.box('concrete', w, h, d, x, h / 2, z, tint(seed, 'wh', k, 0.6, 0.85));
		bag.box('roof', w + 0.6, 0.4, d + 0.6, x, h + 0.2, z);
		bag.box('rust', 0.2, 5, 5, x + w / 2 + 0.05, 2.5, z, '#8a8a86');
		const [yx0, yx1, yz0, yz1] = [x - 34, x + 34, z - 30, z + 30];
		bag.add('sidewalk', groundQuad(yx0, yz0, yx1, yz1, 0.03, 4), '#a09c94');
		for (const [ax, az, bx, bz] of [[yx0, yz0, yx1, yz0], [yx0, yz1, yx1, yz1], [yx0, yz0, yx0, yz1]]) bag.box('steel', 0.04, 2.0, Math.hypot(bx - ax, bz - az), (ax + bx) / 2, 1.0, (az + bz) / 2, '#5a5d5f', Math.atan2(bx - ax, bz - az));
	});
	for (const [x, z, yaw] of [[-262, -900, 0.3], [330, -1460, -0.2], [-610, -1720, 1.4], [-110, -790, 0]]) useNode(root, H.oldShed, '', x, 0, z, yaw);
}

/* ------------------------------------------------------------------------------------------------------------------
 * 13. Power lines: the accepted pylons every ~340 m, the conductors sagging between their clamps.
 * ---------------------------------------------------------------------------------------------------------------- */
/** where the pylon's six conductors and two earth wires hang, in its own frame (its lines run along its ±z) */
const CLAMPS = [[-5.6, 19.291], [-10.8, 19.281], [-7, 29.282], [5.6, 19.291], [10.8, 19.281], [7, 29.282], [-3.2, 41.15], [3.2, 41.15]];
function buildPowerLines(root) {
	const wires = [];
	for (const [a, b] of [[[300, -3000], [300, -60]], [[-2600, -1300], [2600, -1300]], [[-2400, -440], [-640, -110]]]) {
		const n = Math.max(1, Math.round(Math.hypot(b[0] - a[0], b[1] - a[1]) / 340));
		const yaw = Math.atan2(b[0] - a[0], b[1] - a[1]);
		const c = Math.cos(yaw), s = Math.sin(yaw);
		const tops = [];
		for (let i = 0; i <= n; i++) {
			const x = a[0] + ((b[0] - a[0]) * i) / n, z = a[1] + ((b[1] - a[1]) * i) / n;
			// never on the highway or in the city: the line spans over them
			if (Math.abs(x) < HW_EDGE + HW.verge + 6 || (x > -240 && x < 240 && z > -30)) {
				tops.push(tops.length && tops.at(-1) === null ? null : 'span');
				continue;
			}
			useNode(root, H.pylon, '', x, 0, z, yaw);
			tops.push(CLAMPS.map(([cx, cy]) => [x + cx * c, cy, z - cx * s]));
		}
		// string each pylon to the next one standing
		const standing = tops.filter((p) => Array.isArray(p));
		for (let i = 0; i < standing.length - 1; i++)
			for (let k = 0; k < CLAMPS.length; k++) {
				const [p, q] = [standing[i][k], standing[i + 1][k]];
				const sag = Math.hypot(q[0] - p[0], q[2] - p[2]) * (k > 5 ? 0.028 : 0.036);
				const P = (u) => [p[0] + (q[0] - p[0]) * u, p[1] + (q[1] - p[1]) * u - 4 * sag * u * (1 - u), p[2] + (q[2] - p[2]) * u];
				for (let t = 0; t < 16; t++) wires.push(...P(t / 16), ...P((t + 1) / 16));
			}
	}
	const g = new THREE.BufferGeometry();
	g.setAttribute('position', new THREE.Float32BufferAttribute(wires, 3));
	const m = new THREE.LineSegments(g, new THREE.LineBasicMaterial({ color: '#2f3133' }));
	m.name = 'power-lines';
	root.add(m);
}

/* ------------------------------------------------------------------------------------------------------------------
 * 14. The traffic.
 * ---------------------------------------------------------------------------------------------------------------- */
/** the intelligent driver model: minimum gap (m), time headway (s), comfortable acceleration and braking (m/s²) */
const IDM = { s0: 2.0, T: 1.3, a: 1.4, b: 2.2 };
const accel = (v, wish, gap, dv) => {
	const sStar = IDM.s0 + Math.max(0, v * IDM.T + (v * dv) / (2 * Math.sqrt(IDM.a * IDM.b)));
	return IDM.a * (1 - (v / wish) ** 4 - (sStar / Math.max(0.1, gap)) ** 2);
};
/** how many run: the loop into and out of the city, the streets' lanes, the far flow, the exit's lorries */
const COUNT = { main: 290, perRow: 2, perCol: 1, far: 9, exit: 3 };
/** the ambulance and the police car on their timetable: every `period` s from `from` up the rescue lane, `gap` m apart */
const BLUE = { period: 150, from: -1150, phase: 131, gap: 26 };

function makeVehicle(root, seed, key, kindName, states) {
	const kind = KINDS[kindName];
	const g = useNode(root, pickOf(seed, kind.h, 'paint', key), '', 0, 0.05, 0, 0, states);
	return { ...g, kind: kindName, L: kind.L, truck: !!kind.truck, v: 0, s: 0, lane: null, wish: 13.9, queued: 0, honk: 0, wait: 0, k: 0 };
}
const show = (m, on) => (m.node.visible = on);
function place(m) {
	const p = m.lane.at(m.s);
	m.node.position.set(p.x, 0.05, p.z);
	m.node.rotation.y = p.yaw;
}

function buildTraffic(seed, root, lanes, signals, field, mats) {
	const rnd = stream(`${seed}:traffic`);
	const offsetOf = {};
	for (const x of CITY.cols) for (const z of CITY.rows) offsetOf[`${x}:${z}`] = Math.floor(chance(seed, 'jo', x, z) * PERIOD);
	const movers = [];
	const pick = (key) => (chance(seed, 'truck?', key) < 0.24 ? weighted(seed, MIX_TRUCKS, 'tk', key) : weighted(seed, MIX_CARS, 'ck', key));
	const states = (k) => ['head', 'tail', 'brake', 'horn', ...(KINDS[k].truck ? ['engine'] : [])];

	// the far end of the jam: standing still from 1.27 km out to 330 m, brake lights on, the rescue lane open
	for (let i = 0; i < HW.lanes; i++) {
		const lane = lanes[`in-${i}`];
		let s = lane.sAt(JAM.tail), n = 0;
		const end = lane.sAt(JAM.front);
		for (;;) {
			const truck = i > 0 && chance(seed, 'jt', i, n) < (i === 2 ? 0.42 : 0.25);
			const kind = truck ? weighted(seed, MIX_TRUCKS, 'jk', i, n) : weighted(seed, MIX_CARS, 'jc', i, n);
			const L = KINDS[kind].L;
			if (s + L > end) break;
			const m = makeVehicle(root, seed, `jam${i}-${n}`, kind, ['brake', ...(truck ? ['engine'] : [])]);
			m.st.brake.visible = true;
			if (m.st.engine) m.st.engine.visible = true;
			m.lane = lane;
			m.s = s + L / 2;
			place(m);
			s += L + between(seed, 1.6, 3.4, 'jg', i, n);
			n++;
		}
	}
	// the cars parked in the supermarket's lot: its 2.5 × 5 m spaces in four rows, most taken
	[[15.5, Math.PI], [26.5, 0], [31.5, Math.PI], [42.5, 0]].forEach(([lz, yaw], r) => {
		for (let k = 0; k < 34; k++) {
			if (chance(seed, 'park', r, k) > 0.72) continue;
			const m = makeVehicle(root, seed, `park${r}-${k}`, weighted(seed, MIX_CARS.filter(([n]) => n !== 'taxi'), 'pk', r, k), []);
			m.node.position.set(SHOP.x - 41.75 + k * 2.5, 0.05, SHOP.z + lz);
			m.node.rotation.y = yaw + (chance(seed, 'py', r, k) - 0.5) * 0.06;
		}
	});

	// the loop: in along the highway and the avenue, a U-turn out of sight, out again, back in at the jam's front
	const main = [];
	for (let k = 0; k < COUNT.main; k++) {
		const kind = pick(`m${k}`);
		const i = KINDS[kind].truck ? 1 + Math.floor(chance(seed, 'tl', k) * 2) : Math.floor(chance(seed, 'cl', k) * 3);
		const m = makeVehicle(root, seed, `m${k}`, kind, states(kind));
		Object.assign(m, { group: 'main', i, wish: (KINDS[kind].truck ? 22 : 26) * (0.9 + 0.15 * chance(seed, 'w', k)) });
		m.st.head.visible = m.st.tail.visible = true;
		if (m.st.engine) m.st.engine.visible = true;
		movers.push(m);
		main.push(m);
	}
	// spread along the loop at the start: most in the moving jam and the avenue's queues, a fifth outbound
	[0, 1, 2].forEach((i) => {
		const list = main.filter((m) => m.i === i);
		const lin = lanes[`in-${i}`], lout = lanes[`out-${i}`];
		const outbound = Math.floor(list.length * 0.22);
		let s = lin.sAt(JAM.front) + 1;
		for (const m of list.slice(outbound)) {
			if (s + m.L > lin.length - 2) {
				Object.assign(m, { state: 'wait', wait: 1 });
				show(m, false);
				continue;
			}
			Object.assign(m, { lane: lin, s: s + m.L / 2, state: 'in' });
			s += m.L + 2.5 + 4 * chance(seed, 'sp', i, s | 0);
		}
		let so = 10;
		for (const m of list.slice(0, outbound)) {
			if (so > lout.sAt(-1000) - 20) {
				Object.assign(m, { state: 'wait', wait: 1 });
				show(m, false);
				continue;
			}
			Object.assign(m, { lane: lout, s: so, v: 12, state: 'out' });
			so += 25 + 30 * chance(seed, 'so', i, so | 0);
		}
	});
	// the streets: a car or two on each lane, round and round
	for (const lane of Object.values(lanes).filter((l) => l.id.startsWith('row-') || l.id.startsWith('col-'))) {
		const n = lane.id.startsWith('row-') ? COUNT.perRow : COUNT.perCol;
		for (let k = 0; k < n; k++) {
			const kind = chance(seed, 'st', lane.id, k) < 0.15 ? 'taxi' : chance(seed, 'st2', lane.id, k) < 0.08 ? 'boxTruck' : weighted(seed, MIX_CARS, 'sc', lane.id, k);
			const m = makeVehicle(root, seed, `${lane.id}-${k}`, kind, states(kind));
			Object.assign(m, { group: 'street', lane, s: ((k + chance(seed, 'ss', lane.id)) / n) * lane.length * 0.9, wish: 12.5, state: 'in' });
			m.st.head.visible = m.st.tail.visible = true;
			if (m.st.engine) m.st.engine.visible = true;
			movers.push(m);
		}
	}
	// the far flow: out of the haze toward the jam's tail, where it stops (and, standing a while, is swallowed)
	for (let k = 0; k < COUNT.far; k++) {
		const i = k % 3, kind = i === 2 && k % 2 ? 'semi' : pick(`f${k}`);
		const m = makeVehicle(root, seed, `f${k}`, kind, states(kind));
		Object.assign(m, { group: 'far', i, lane: lanes[`in-${i}`], s: 60 + k * 70, v: 20, wish: 24, state: 'in' });
		m.st.head.visible = m.st.tail.visible = true;
		if (m.st.engine) m.st.engine.visible = true;
		movers.push(m);
	}
	// lorries taking the exit to the supermarket
	for (let k = 0; k < COUNT.exit; k++) {
		const kind = k === 1 ? 'boxTruck' : 'semi';
		const m = makeVehicle(root, seed, `x${k}`, kind, states(kind));
		Object.assign(m, { group: 'exit', lane: lanes.exit, s: 20 + k * 150, v: 10, wish: 14, state: 'in' });
		m.st.head.visible = m.st.tail.visible = m.st.engine.visible = true;
		movers.push(m);
	}
	for (const m of movers) if (m.state === 'in' || m.state === 'out') place(m);
	// the ambulance and the police car, on their timetable up the rescue lane and the avenue
	const amb = makeVehicle(root, seed, 'amb', 'ambulance', ['head', 'tail', 'beacon', 'siren']);
	const pol = makeVehicle(root, seed, 'pol', 'police', ['head', 'tail', 'beacon', 'siren']);
	for (const m of [amb, pol]) m.st.head.visible = m.st.tail.visible = m.st.beacon.visible = m.st.siren.visible = true;
	// the crop sprayer, its booms open, up and down its tramlines at 10 km/h; the drift under its booms
	const tractor = useNode(root, H.tractorField, '', SPRAY.x, 0, SPRAY.z, 0, ['head', 'engine', 'spray']);
	tractor.st.engine.visible = tractor.st.head.visible = true;
	const mist = [];
	for (let k = 0; k < 6; k++) {
		const veil = new THREE.Mesh(new THREE.PlaneGeometry(25 + k * 2.5, 1.0 + k * 0.5), mats.mist);
		veil.position.set(0, 0.6 + k * 0.28, -4.2 - k * 2.4);
		veil.rotation.x = -0.25;
		veil.name = 'spray-mist';
		tractor.node.add(veil);
		mist.push(veil);
	}

	// camera seats for film: a driver in the jam, the ambulance's driver and a chase behind it, a food lorry's cab
	const seat = (m, name, x, y, z, tilt = 0) => (marker(m.node, `frame:${name}`, x, y, z).rotation.x = tilt);
	const jamCar = main.find((m) => m.state === 'in' && m.i === 1 && !m.truck && m.lane.at(m.s).z > -280);
	if (jamCar) seat(jamCar, 'driver', 0.38, 1.15, -0.2);
	seat(amb, 'ambulance-driver', 0.5, 1.9, 1.9);
	seat(amb, 'chase', 0, 4.6, -17, 0.14);
	const lorry = main.find((m) => m.state === 'in' && m.kind === 'semi');
	if (lorry) seat(lorry, 'lorry-cab', 0.6, 2.6, 6.9);
	seat(tractor, 'sprayer-cab', 0.2, 2.6, 0.6);

	/* -------- one step of everything -------- */
	let t = 0;
	/** where the ambulance is (z), and whether a junction of the avenue is holding its cross traffic for it */
	let blueZ = -1e9;
	const holding = (j) => j.startsWith('0:') && Number(j.slice(2)) - blueZ < 110 && Number(j.slice(2)) - blueZ > -20;
	const colourAt = (j, axis) => (holding(j) ? (axis === 'ns' ? 'green' : 'red') : lightAt(offsetOf[j], axis, t));
	const all = Object.values(lanes);
	const sortLanes = () => {
		for (const l of all) l.cars.length = 0;
		for (const m of movers) if (m.state === 'in' || m.state === 'out') m.lane.cars.push(m);
		for (const l of all) {
			l.cars.sort((a, b) => a.s - b.s);
			l.cars.forEach((m, k) => (m.k = k));
		}
	};
	/** room at `s` on a lane for a vehicle `L` long */
	const clear = (lane, s, L) => lane.cars.every((o) => !o.node.visible || Math.abs(o.s - s) > (o.L + L) / 2 + 3);
	const tailS = [0, 1, 2].map((i) => lanes[`in-${i}`].sAt(JAM.tail));
	const frontS = [0, 1, 2].map((i) => lanes[`in-${i}`].sAt(JAM.front));
	const outEnd = lanes['out-0'].sAt(-1000);

	function follow(m, dt) {
		const lane = m.lane;
		const ahead = lane.cars[m.k + 1];
		let gap = 1e9, dv = 0;
		if (ahead) (gap = ahead.s - m.s - (ahead.L + m.L) / 2), (dv = m.v - ahead.v);
		// the far flow meets the standing jam's tail
		if (m.group === 'far' && tailS[m.i] - m.s - m.L / 2 - 1 < gap) (gap = tailS[m.i] - m.s - m.L / 2 - 1), (dv = m.v);
		// a red (or an amber it can stop for) at the next stop line is a car standing on the line
		for (const st of lane.stops) {
			const d = st.s - m.s - m.L / 2;
			if (d < -0.5) continue;
			if (d < gap && d < 160 && colourAt(st.junction, st.axis) !== 'green' && d > (m.v * m.v) / (2 * IDM.b * 2.5) - 0.5) (gap = Math.max(0.1, d)), (dv = m.v);
			break;
		}
		const wish = Math.min(m.wish, lane.speed * (m.group === 'main' && lane.at(m.s).z > -40 ? 0.56 : 1));
		const acc = accel(m.v, wish, gap, dv);
		m.v = Math.max(0, m.v + acc * dt);
		let next = m.s + m.v * dt;
		if (ahead && ahead.node.visible) next = Math.min(next, ahead.s - (ahead.L + m.L) / 2 - 0.4);
		if (next < m.s) m.v = 0;
		m.s = Math.max(m.s, next);
		m.st.brake.visible = acc < -0.6 || m.v < 0.4;
		// standing long in the queue, now and then a horn
		m.queued = m.v < 0.5 ? m.queued + dt : 0;
		if (m.honk > 0) m.honk -= dt;
		else if (m.queued > 6 && rnd() < dt * 0.035) m.honk = 0.35 + rnd() * 0.5;
		m.st.horn.visible = m.honk > 0;
	}
	function advance(m, dt) {
		if (m.state === 'in' || m.state === 'out') {
			follow(m, dt);
			const end = m.group === 'main' && m.state === 'out' ? outEnd : m.lane.length;
			if (m.s >= end - m.L / 2) {
				show(m, false);
				if (m.group === 'main') Object.assign(m, m.state === 'in' ? { state: 'uturn', wait: 6 } : { state: 'wait', wait: 4 });
				else Object.assign(m, { state: 'wait', wait: m.group === 'exit' ? 25 : 3 });
				return;
			}
			if (m.group === 'far' && m.v < 0.2 && m.queued > 14) {
				show(m, false);
				Object.assign(m, { state: 'wait', wait: 5 });
				return;
			}
			place(m);
			return;
		}
		// put away: waiting to come back where there is room
		m.wait -= dt;
		if (m.wait > 0) return;
		let to = null;
		if (m.group === 'main') to = m.state === 'uturn' ? { lane: lanes[`out-${m.i}`], s: m.L / 2 + 1, v: 4, state: 'out' } : { lane: lanes[`in-${m.i}`], s: frontS[m.i] + m.L / 2 + 0.5, v: 0, state: 'in' };
		else to = { lane: m.lane, s: m.L / 2, v: m.group === 'far' ? 18 : m.group === 'exit' ? 12 : 6, state: 'in' };
		if (!clear(to.lane, to.s, m.L)) return;
		Object.assign(m, to, { queued: 0, honk: 0 });
		show(m, true);
		m.lane.cars.push(m);
		m.lane.cars.sort((a, b) => a.s - b.s);
		m.lane.cars.forEach((o, k) => (o.k = k));
		place(m);
	}
	// the sprayer's run: up a tramline, a turn on the headland, down the next; across the field and back
	const runs = field ? Math.floor((field.x1 - field.x0 - 18) / 24) : 0;
	const span = field ? field.z1 - field.z0 - 30 : 0;
	const leg = span + Math.PI * 12;
	function sprayer() {
		if (!runs) return;
		let d = (t * 2.8 + 400) % (2 * runs * leg);
		const back = d > runs * leg;
		if (back) d = 2 * runs * leg - d;
		const n = Math.min(runs - 1, Math.floor(d / leg)), r = d - n * leg;
		const x0 = field.x0 + 12 + n * 24, up = n % 2 === 0;
		let x, z, yaw;
		if (r < span) {
			x = x0;
			z = up ? field.z1 - 15 - r : field.z0 + 15 + r;
			yaw = up ? Math.PI : 0;
		} else {
			const a = ((r - span) / (Math.PI * 12)) * Math.PI;
			x = x0 + 12 - 12 * Math.cos(a);
			z = up ? field.z0 + 15 - 12 * Math.sin(a) : field.z1 - 15 + 12 * Math.sin(a);
			yaw = up ? Math.PI - a : a;
		}
		if (back) yaw += Math.PI;
		tractor.node.position.set(x, 0, z);
		tractor.node.rotation.y = yaw;
		const spraying = r < span;
		tractor.st.spray.visible = spraying;
		for (const v of mist) v.visible = spraying;
	}
	function emergency() {
		const lane = lanes.rescue;
		const cyc = (((t + BLUE.phase) % BLUE.period) + BLUE.period) % BLUE.period;
		const start = lane.sAt(BLUE.from), end = lane.length - 8;
		const sa = start + cyc * lane.speed;
		for (const [m, s] of [[amb, sa], [pol, sa - BLUE.gap]]) {
			const on = s > start && s < end;
			show(m, on);
			if (!on) continue;
			m.lane = lane;
			m.s = s;
			place(m);
		}
		blueZ = sa < end ? lane.at(sa).z : -1e9;
	}
	const lights = signals.map((g) => ({ ...g }));
	function step(dt) {
		t += dt;
		emergency();
		sortLanes();
		// every mover in the order it was made: one fixed order, the same world every time
		for (const m of movers) advance(m, dt);
		for (const g of lights) {
			const c = colourAt(g.junction, g.axis);
			g.st.red.visible = c === 'red';
			g.st.amber.visible = c === 'amber';
			g.st.green.visible = c === 'green';
		}
		sprayer();
	}
	return {
		step,
		moving: movers.length + 3,
		sprayerAt: () => ({ x: tractor.node.position.x, z: tractor.node.position.z, yaw: tractor.node.rotation.y }),
		/** every node a step moves: the movers, the ambulance, the police car, the sprayer */
		nodes: [...movers.map((m) => m.node), amb.node, pol.node, tractor.node]
	};
}

/* ------------------------------------------------------------------------------------------------------------------
 * 15. The world.
 * ---------------------------------------------------------------------------------------------------------------- */
function build(seed = 'old-city') {
	seed = String(seed || 'old-city');
	const root = new THREE.Group();
	root.name = 'old-city';
	const mats = materialsOf();
	const bag = new Bag();
	const inst = { dash: [], dashX: [], zebra: [], post: [] };
	const field = buildFields(seed, bag, root, { tilled: mats.soil, stubble: mats.stubble, crop: mats.crop, verge: mats.gravel });
	buildHighway(seed, bag, root, inst, mats.gravel);
	const signals = [];
	buildCity(seed, bag, root, inst, signals);
	buildPowerLines(root);
	for (const m of bag.meshes(mats)) root.add(m);
	const instanced = (name, geo, mat, list, at) => {
		if (!list.length) return;
		const im = new THREE.InstancedMesh(geo, mat, list.length);
		im.name = name;
		const m = new THREE.Matrix4();
		list.forEach((a, i) => im.setMatrixAt(i, at(m, a)));
		im.receiveShadow = true;
		root.add(im);
	};
	const flat = new THREE.PlaneGeometry(1, 1).rotateX(-Math.PI / 2);
	const S = (m, [x, y, z, sx, sz]) => m.compose(new THREE.Vector3(x, y, z), new THREE.Quaternion(), new THREE.Vector3(sx, 1, sz));
	instanced('markings', flat, mats.paint, inst.dash, S);
	instanced('markings-x', flat, mats.paint, inst.dashX, S);
	instanced('crossings', flat, mats.paint, inst.zebra, S);
	instanced('guardrail-posts', new THREE.BoxGeometry(0.15, 0.75, 0.1), mats.steel, inst.post, (m, [x, y, z]) => m.makeTranslation(x, y, z));

	// the mood, the sound, the views
	marker(root, 'mood:smog-dusk');
	for (const [h, k, g] of SOUND) marker(root, `sound:${h}?for=${k}&gain=${g}`);
	view(root, 'highway-jam', [-17.5, 1.5, -420], [-5, 2.5, -60]);
	view(root, 'lorries', [9, 9, -560], [-9, 2, -330]);
	view(root, 'ambulance', [1.8, 3.2, -330], [-5, 1.5, -160]);
	view(root, 'junction', [-7, 14, 42], [0, 0, 100]);
	view(root, 'street', [-13.5, 1.6, 168], [-4, 3, 245]);
	view(root, 'towers', [-140, 150, -160], [40, 25, 210]);
	view(root, 'supermarket', [-60, 22, -10], [SHOP.x, 0, SHOP.z]);
	view(root, 'above', [170, 175, -230], [-15, 0, 190]);

	// the traffic, settled for a minute and a half before t = 0
	const traffic = buildTraffic(seed, root, lanesOf(), signals, field, mats);
	for (let i = 0; i < 900; i++) traffic.step(0.1);
	// the fields' view: over the crop beside where the sprayer is when the world opens, looking down its run
	const tr = traffic.sprayerAt();
	const ahead = new THREE.Vector3(Math.sin(tr.yaw), 0, Math.cos(tr.yaw));
	view(root, 'fields', [tr.x + ahead.x * 60 + 30, 9, tr.z + ahead.z * 60], [tr.x, 1, tr.z]);
	// the world at time t (s, its total since its run began), brought there in counted steps of 0.1 s, one step ahead of
	// t; everything that moves is drawn between where the last two steps put it (a film at 24 fps sees it move every
	// frame, not every 0.1 s), and is the same at the same t however it got there
	const moving = traffic.nodes;
	const pose = () => moving.map((o) => ({ p: o.position.clone(), r: o.rotation.y, v: o.visible }));
	const keep = (to) => moving.forEach((o, i) => {
		to[i].p.copy(o.position);
		to[i].r = o.rotation.y;
		to[i].v = o.visible;
	});
	const was = pose(), now = pose();
	let n = 0;
	root.userData.tick = (t) => {
		const to = Math.max(0, Number(t) || 0);
		const want = Math.floor(to / 0.1 + 1e-9) + 1;
		if (n < want) {
			// first back to where the last step truly put everything (a step reads who is shown), then on
			moving.forEach((o, i) => {
				o.position.copy(now[i].p);
				o.rotation.y = now[i].r;
				o.visible = now[i].v;
			});
			while (n < want) {
				keep(was);
				traffic.step(0.1);
				n++;
			}
			keep(now);
		}
		const f = Math.min(1, Math.max(0, to / 0.1 - (n - 1)));
		moving.forEach((o, i) => {
			const a = was[i], b = now[i];
			o.visible = b.v;
			// a jump (shown again, put back at its start) is no move: drawn where it is
			if (!a.v || !b.v || a.p.distanceToSquared(b.p) > 16) {
				o.position.copy(b.p);
				o.rotation.y = b.r;
				return;
			}
			o.position.lerpVectors(a.p, b.p, f);
			const d = b.r - a.r - Math.round((b.r - a.r) / (2 * Math.PI)) * 2 * Math.PI;
			o.rotation.y = b.r - d * (1 - f);
		});
	};
	return root;
}

const PARAMS = [{ id: 'seed', label: 'Seed', type: 'string', value: 'old-city', maxLength: 40 }];

module.exports.recipe = function (id, v, variant) {
	return {
		meta: {
			group: 'worlds',
			id: id ?? 'old-city',
			version: v ?? 1,
			variant: variant ?? undefined,
			label: 'Old City',
			note: 'The old way: a small grid of tired concrete blocks at the end of a jammed 2 × 3-lane highway across barren monoculture land, food lorries hauling in, an ambulance and a police car pushing through the rescue lane, a crop sprayer, power lines, a smoggy dusk. 1 unit = 1 m.',
			params: JSON.parse(JSON.stringify(PARAMS))
		},
		build
	};
};
module.exports.lanesOf = lanesOf;
module.exports.lightAt = lightAt;

return module.exports.recipe("old-city", 8, null);
