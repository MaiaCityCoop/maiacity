			for (const s of [-1, 1]) {
				const zc = z + s * (wz / 2 + 2);
				for (let k = -cw + 0.5; k < cw; k += 1.0) inst.zebra.push([x + k, 0.062, zc, 0.5, 3]);
				bag.add('paint', groundQuad(Math.min(x, x - s * cw), zc + s * 2.1, Math.max(x, x - s * cw), zc + s * 2.5, 0.062));
				const xc = x + s * (wx / 2 + 2);
				for (let k = -5.5; k < 6; k += 1.0) inst.zebra.push([xc, 0.062, z + k, 3, 0.5]);
				bag.add('paint', groundQuad(Math.min(xc + s * 2.1, xc + s * 2.5), Math.min(z, z + s * 6), Math.max(xc + s * 2.1, xc + s * 2.5), Math.max(z, z + s * 6), 0.062));
			}
			// a signal for each approach at its right kerb by the stop line, facing the traffic that comes to it
			const kind = x === 0 ? 1 : 0;
			for (const [axis, px, pz, yaw, k] of [
				['ns', x - cw - 0.7, z - wz / 2 - 3, Math.PI, kind],
				['ns', x + cw + 0.7, z + wz / 2 + 3, 0, kind],
				['ew', x - wx / 2 - 3, z + 6.7, -Math.PI / 2, 0],
				['ew', x + wx / 2 + 3, z - 6.7, Math.PI / 2, 0]
			]) {
				const g = useNode(root, H.signal, `kind=${k}&seed=old`, px, 0.2, pz, yaw, ['red', 'amber', 'green']);
				signals.push({ junction: `${x}:${z}`, axis, st: g.st });
			}
		}
	// the city beyond what is built: its grid goes on, streets and lots under slabs, towers and offices to the skyline
	const OUT = { cols: [-555, -455, -355, 355, 455, 555], rows: [0, 100, 200, 300, 400, 500, 600, 700, 800, 900] };
	bag.add('asphalt', groundQuad(-600, -10, -230, 900, 0.04, 8), '#b8b4ae');
	bag.add('asphalt', groundQuad(230, -10, 600, 900, 0.04, 8), '#b8b4ae');
	bag.add('asphalt', groundQuad(-230, 425, 230, 900, 0.04, 8), '#b8b4ae');
	const outBlock = (cx, cz, k) => {
		bag.box('sidewalk', 88, 0.15, 88, cx, 0.115, cz, tint(seed, 'osw', k, 0.85, 1.0));
		bag.box('gravel', 80, 0.02, 80, cx, 0.2, cz, tint(seed, 'olot', k, 0.55, 0.7));
		// a few kinds only (each kind is drawn and pictured once, however many stand): the far city repeats unseen
		const kind = pickOf(seed, ['slab', 'slab', 'tower', 'tower', 'office'], 'sk', k);
		const v = Math.floor(chance(seed, 'sv', k) * 3);
		const fl = kind === 'tower' ? [14, 20, 26][v] : [7, 10, 14][v];
		useNode(root, H[kind], `floors=${fl}&seed=o${v}`, cx, 0.22, cz, Math.floor(chance(seed, 'sy', k) * 4) * (Math.PI / 2));
	};
	let k = 0;
	// beside the grid, east and west, from the city's first street to its last and beyond
	for (const side of [-1, 1]) for (const x of [-300, -400, -500]) for (let z = 50; z < 900; z += 100) outBlock(side * -x, z, k++);
	// behind it, south of its last street
	for (const x of [-155, -55, 55, 155]) for (let z = 475; z < 900; z += 100) outBlock(x, z, k++);
	for (const [x0, x1, z0, z1] of [[-660, -600, -60, 920], [600, 660, -60, 920], [-600, 600, 900, 920], [-600, -230, -60, -10], [230, 600, -60, -10]]) bag.add('gravel', groundQuad(x0, z0, x1, z1, 0.01, 6), '#a09a90');
	// the discount supermarket on the city's edge, its lot to the street; the abandoned gas station; the bus stop
	useNode(root, H.supermarket, 'rows=4&seed=old-city', SHOP.x, 0, SHOP.z, 0);
	useNode(root, H.gasStation, '', EXIT.x - 26, 0, -330, Math.PI / 2);
	bag.add('asphalt', groundQuad(EXIT.x - 44, -350, EXIT.x - 4, -310, 0.04, 8), '#b0aca4');
	useNode(root, H.busStop, '', -13.2, 0.2, 150, -Math.PI / 2);
	for (let k = 0; k < 6; k++) useNode(root, H.bollard, `kind=0&seed=p${k}`, SHOP.x - 36 + k * 1.4, 0, SHOP.z + 9.5, 0);
