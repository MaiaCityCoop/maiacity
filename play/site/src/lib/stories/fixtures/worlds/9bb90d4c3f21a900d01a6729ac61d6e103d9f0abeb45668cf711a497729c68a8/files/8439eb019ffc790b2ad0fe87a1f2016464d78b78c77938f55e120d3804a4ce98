/* ------------------------------------------------------------------------------------------------------------------
 * 7. The lanes: polylines of [x, z] in the way they are driven, their stop lines.
 * ---------------------------------------------------------------------------------------------------------------- */
class Lane {
	constructor(id, pts, o = {}) {
		Object.assign(this, { id, pts, speed: 13.9, stops: [], off: null, ...o });
		this.cum = [0];
		for (let i = 1; i < pts.length; i++) this.cum.push(this.cum[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
		this.length = this.cum.at(-1);
		this.cars = [];
	}
	/** where it is `s` m along: x, z and the heading (rotation.y; a guest's front is its +z) */
	at(s) {
		let i = 0;
		while (i < this.pts.length - 2 && this.cum[i + 1] < s) i++;
		const [a, b] = [this.pts[i], this.pts[i + 1]];
		const u = Math.min(1, Math.max(0, (s - this.cum[i]) / (this.cum[i + 1] - this.cum[i] || 1)));
		let x = a[0] + (b[0] - a[0]) * u;
		const z = a[1] + (b[1] - a[1]) * u;
		if (this.off) x += this.off(z);
		return { x, z, yaw: Math.atan2(b[0] - a[0], b[1] - a[1]) };
	}
	/** how far along it is where it reaches z (axis 1) or x (axis 0); null if it never does */
	sAt(v, axis = 1) {
		for (let i = 0; i < this.pts.length - 1; i++) {
			const [a, b] = [this.pts[i][axis], this.pts[i + 1][axis]];
			if ((v - a) * (v - b) <= 0 && a !== b) return this.cum[i] + ((v - a) / (b - a)) * (this.cum[i + 1] - this.cum[i]);
		}
		return null;
	}
}
/** the rescue lane: in the jam the left lane edges toward the median and the others away (m, + toward the median) */
const RESCUE = { hw: [0.95, -0.9, -0.9], av: [0.6, -0.9, -0.6], x: [-(HW.median / 2 + HW.inner + HW.lane) - 0.03, -(AV.median / 2 + AV.lane) - 0.15] };
const blend = (z, hw, av) => (z < -80 ? hw : z > -20 ? av : hw + (av - hw) * ((z + 80) / 60));

function lanesOf() {
	const L = {};
	const end = CITY.rows.at(-1) + 25;
	for (let i = 0; i < HW.lanes; i++) {
		// into the city: the highway and the avenue as one lane, the rescue lane's offset on it
		L[`in-${i}`] = new Lane(`in-${i}`, [[-hwLaneX(i), HW.from], [-hwLaneX(i), -80], [-avLaneX(i), HW.to], [-avLaneX(i), end]], { speed: 25, off: (z) => blend(z, RESCUE.hw[i], RESCUE.av[i]), axis: 'ns' });
		L[`out-${i}`] = new Lane(`out-${i}`, [[avLaneX(i), end], [avLaneX(i), HW.to], [hwLaneX(i), -80], [hwLaneX(i), HW.from]], { speed: 25, axis: 'ns' });
	}
	L.rescue = new Lane('rescue', [[RESCUE.x[0], HW.from], [RESCUE.x[0], -80], [RESCUE.x[1], HW.to], [RESCUE.x[1], end]], { speed: 12 });
	L.exit = new Lane('exit', exitPath(), { speed: 15 });
	// the streets: two lanes each way; eastbound on the south side (+z), westbound on the north
	for (const z of CITY.rows)
		for (let i = 0; i < 2; i++) {
			L[`row-${z}-e-${i}`] = new Lane(`row-${z}-e-${i}`, [[-228, z + stLaneOff(i)], [228, z + stLaneOff(i)]], { speed: 12.5, axis: 'ew' });
			L[`row-${z}-w-${i}`] = new Lane(`row-${z}-w-${i}`, [[228, z - stLaneOff(i)], [-228, z - stLaneOff(i)]], { speed: 12.5, axis: 'ew' });
		}
	// southbound on the west side of a street, northbound on the east
	for (const x of CITY.cols.filter((c) => c !== 0))
		for (let i = 0; i < 2; i++) {
			L[`col-${x}-s-${i}`] = new Lane(`col-${x}-s-${i}`, [[x - stLaneOff(i), -18], [x - stLaneOff(i), 425]], { speed: 12.5, axis: 'ns' });
			L[`col-${x}-n-${i}`] = new Lane(`col-${x}-n-${i}`, [[x + stLaneOff(i), 425], [x + stLaneOff(i), -18]], { speed: 12.5, axis: 'ns' });
		}
	// a stop line before every junction a lane crosses, 4.5 m behind the near kerb of the street it crosses
	for (const lane of Object.values(L)) {
		if (!lane.axis) continue;
		const alongZ = lane.axis === 'ns';
		const k = alongZ ? 1 : 0;
		const heading = Math.sign(lane.pts.at(-1)[k] - lane.pts[0][k]);
		const near = (list, v) => list.reduce((a, c) => (Math.abs(c - v) < Math.abs(a - v) ? c : a));
		const fixed = alongZ ? near(CITY.cols, lane.pts.at(-1)[0]) : near(CITY.rows, lane.pts[0][1]);
		for (const c of alongZ ? CITY.rows : CITY.cols) {
			const half = alongZ ? CITY.street / 2 : widthOfCol(c) / 2;
			const s = lane.sAt(c - heading * (half + 4.5), k);
			if (s !== null) lane.stops.push({ s, junction: alongZ ? `${fixed}:${c}` : `${c}:${fixed}`, axis: lane.axis });
		}
		lane.stops.sort((a, b) => a.s - b.s);
	}
