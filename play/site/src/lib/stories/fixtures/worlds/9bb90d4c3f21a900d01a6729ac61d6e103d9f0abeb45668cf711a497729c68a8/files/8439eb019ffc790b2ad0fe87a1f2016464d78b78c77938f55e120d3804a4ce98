		for (const s of [-1, 1]) for (let x = X0; x < X1; x += 9) if (!nearCol(x + 1.5)) inst.dashX.push([x + 1.5, 0.061, z + s * 3.1, 3, 0.12]);
	}
	for (const x of CITY.cols)
