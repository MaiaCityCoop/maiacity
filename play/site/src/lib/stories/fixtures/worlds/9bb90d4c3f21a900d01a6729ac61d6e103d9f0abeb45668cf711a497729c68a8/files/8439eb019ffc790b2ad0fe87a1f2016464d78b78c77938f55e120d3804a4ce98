	// the markings: a double yellow down each street, lane dashes, stop lines and zebras at every corner
	for (const x of CITY.cols) {
		if (x !== 0) bag.add('yellow', groundQuad(x - 0.2, Z0, x + 0.2, Z1, 0.06));
		const each = x === 0 ? 3 : 2, lw = x === 0 ? AV.lane : 3, mid = x === 0 ? AV.median / 2 : 0.1;
		for (const s of [-1, 1]) for (let k = 1; k < each; k++) for (let z = Z0; z < Z1; z += 9) if (!nearRow(z + 1.5)) inst.dash.push([x + s * (mid + lw * k), 0.061, z + 1.5, 0.12, 3]);
	}
	for (const z of CITY.rows) {
