/* ------------------------------------------------------------------------------------------------------------------
 * 6. Guests and markers: a node named for a build, with its state nodes (each on while visible); named empties.
 * ---------------------------------------------------------------------------------------------------------------- */
function useNode(parent, hash, values, x, y, z, yaw, states = []) {
	const n = new THREE.Group();
	n.name = `use:${hash}${values ? `?${values}` : ''}`;
	n.position.set(x, y, z);
	n.rotation.y = yaw;
	const st = {};
	for (const s of states) {
		const o = new THREE.Object3D();
		o.name = `state:${s}`;
		o.visible = false;
		n.add(o);
		st[s] = o;
