}
/** the exit's line [x, z]: off the hard shoulder, curving out to the frontage road, along it to the supermarket */
function exitPath() {
	const pts = [];
	const x0 = -HW_EDGE + 0.4;
	for (let i = 0; i <= 12; i++) {
		const u = i / 12, s = u * u * (3 - 2 * u);
		pts.push([x0 + (EXIT.x - x0) * s, EXIT.from + (EXIT.bend - EXIT.from) * u]);
	}
	pts.push([EXIT.x, -150], [EXIT.x - 14, -128], [SHOP.x + 40, -128]);
	return pts;
}

/* ------------------------------------------------------------------------------------------------------------------
 * 8. The signals: every junction on one cycle (s) from an offset of its own; the north-south greens the longer.
 * ---------------------------------------------------------------------------------------------------------------- */
const CYCLE = [['ns', 'green', 32], ['ns', 'amber', 3], ['all', 'red', 2], ['ew', 'green', 22], ['ew', 'amber', 3], ['all', 'red', 2]];
const PERIOD = CYCLE.reduce((a, c) => a + c[2], 0);
