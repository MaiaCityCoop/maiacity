function buildCity(seed, bag, root, inst, signals) {
	const [X0, X1, Z0, Z1] = [-230, 230, -12, 425];
	bag.add('asphalt', groundQuad(X0, Z0, X1, Z1, 0.05, 8));
	bag.box('concrete', AV.median, 0.18, Z1 - Z0 - 24, 0, 0.09, (Z0 + Z1) / 2 + 12, '#8a8780');
	let b = 0;
	for (let i = 0; i < CITY.cols.length - 1; i++)
		for (let j = 0; j < CITY.rows.length - 1; j++, b++) {
			const xa = CITY.cols[i] + widthOfCol(CITY.cols[i]) / 2 - CITY.sidewalk, xb = CITY.cols[i + 1] - widthOfCol(CITY.cols[i + 1]) / 2 + CITY.sidewalk;
			const za = CITY.rows[j] + CITY.street / 2 - CITY.sidewalk, zb = CITY.rows[j + 1] - CITY.street / 2 + CITY.sidewalk;
			const [cx, cz] = [(xa + xb) / 2, (za + zb) / 2];
			// the sidewalks and the lot as one raised slab; the lot worn paving
			bag.box('sidewalk', xb - xa, 0.15, zb - za, cx, 0.125, cz, tint(seed, 'sw', i, j, 0.9, 1.02));
			bag.box('gravel', xb - xa - 2 * CITY.sidewalk, 0.02, zb - za - 2 * CITY.sidewalk, cx, 0.21, cz, tint(seed, 'lot', i, j, 0.55, 0.7));
			// street lamps along its sidewalks every 30 m, the bracket over the road
			for (let x = xa + 10; x < xb - 8; x += 30) for (const [z, f] of [[za + 0.7, Math.PI], [zb - 0.7, 0]]) useNode(root, H.lamp, `kind=0&seed=c${Math.abs(x | 0) & 1}`, x, 0.2, z, f);
			for (let z = za + 10; z < zb - 8; z += 30) for (const [x, f] of [[xa + 0.7, -Math.PI / 2], [xb - 0.7, Math.PI / 2]]) useNode(root, H.lamp, `kind=0&seed=c${Math.abs(z | 0) & 1}`, x, 0.2, z, f);
			// its buildings by a plan the seed picks, the plan turned so no two blocks read alike
			const plan = BLOCK_PLANS[Math.floor(chance(seed, 'plan', i, j) * BLOCK_PLANS.length)];
			const turn = Math.floor(chance(seed, 'turn', i, j) * 4) * (Math.PI / 2);
			const c = Math.cos(turn), s = Math.sin(turn);
			plan.forEach(([kind, dx, dz, yaw, vals], k) => {
