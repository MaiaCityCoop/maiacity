/* ------------------------------------------------------------------------------------------------------------------
 * 10. The land: fields to the horizon (no trees, no hedges), field tracks, the edge land.
 * ---------------------------------------------------------------------------------------------------------------- */
function buildFields(seed, bag, root, fieldMats) {
	const KIND = ['tilled', 'stubble', 'crop', 'tilled', 'stubble', 'tilled'];
	const out = [];
	const parcels = (xa, xb, side) => {
		const xs = [xa];
		let x = xa, k = 0;
		while (Math.abs(x - xa) < Math.abs(xb - xa)) {
			x += side * between(seed, 300, 620, 'px', side, k++);
			xs.push(side > 0 ? Math.min(x, xb) : Math.max(x, xb));
		}
		for (let i = 0; i < xs.length - 1; i++) {
			let z = -3200, j = 0;
			while (z < -60) {
				const z1 = Math.min(-60, z + between(seed, 380, 760, 'pz', side, i, j));
				const [x0, x1] = [Math.min(xs[i], xs[i + 1]), Math.max(xs[i], xs[i + 1])];
				const spray = SPRAY.x > x0 && SPRAY.x < x1 && SPRAY.z > z && SPRAY.z < z1;
				const kind = spray ? 'crop' : pickOf(seed, KIND, 'pk', side, i, j);
				// beside the highway's last stretch the fields give way to the edge land
				const edge = side < 0 && i === 0 && z1 > EDGE.z0;
				const xr = edge ? Math.min(x1, EDGE.x0) : x1;
				if (xr - x0 > 60) out.push({ x0: x0 + 2, x1: xr - 2, z0: z + 2, z1: z1 - 2, kind, spray });
				if (edge && x1 > EDGE.x0 && EDGE.z0 - z > 60) out.push({ x0: EDGE.x0 + 2, x1: x1 - 2, z0: z + 2, z1: EDGE.z0 - 2, kind });
				z = z1;
				j++;
			}
		}
	};
	parcels(-HW_EDGE - HW.verge - 2, -3200, -1);
	parcels(HW_EDGE + HW.verge + 2, 3200, 1);
	// the land round the city: more of the same, the city's edge left out
	for (const [x0, x1] of [[-3200, -660], [660, 3200]]) {
		let z = -60, j = 0;
		while (z < 1600) {
			const z1 = Math.min(1600, z + between(seed, 400, 700, 'bz', x0, j));
			out.push({ x0: x0 + 2, x1: x1 - 2, z0: z + 2, z1: z1 - 2, kind: pickOf(seed, KIND, 'bk', x0, j) });
			z = z1;
			j++;
		}
	}
	// each field its own mesh named for its biome, its rows along its long side (the sprayer's along its tramlines, z)
	for (const f of out) {
		const along = f.spray ? false : f.x1 - f.x0 >= f.z1 - f.z0;
		const g = groundQuad(f.x0, f.z0, f.x1, f.z1, 0, FURROW * 8, !along);
		const c = f.kind === 'tilled' ? tint(seed, 'f', f.x0, f.z0, 0.88, 1.06) : new THREE.Color('#ffffff');
		g.setAttribute('color', new THREE.Float32BufferAttribute(new Float32Array(g.attributes.position.count * 3).map((_, k) => [c.r, c.g, c.b][k % 3]), 3));
		const m = new THREE.Mesh(g, fieldMats[f.kind]);
		m.name = BIOMES[f.kind] ? `biome:${BIOMES[f.kind]} rows:${along ? 0 : 90}` : `field:${f.kind}`;
		m.receiveShadow = true;
		root.add(m);
	}
	// the tracks between the fields: the bare ground under everything
	bag.add('dirt', groundQuad(-3300, -3300, 3300, 1700, -0.04, 50));
	// the edge land where the fields stop: dry weedy ground and its litter (the roadside verge), the yards on it
	const eg = groundQuad(EDGE.x0, EDGE.z0, -HW_EDGE - HW.verge, -12, 0.005, 6);
	eg.setAttribute('color', new THREE.Float32BufferAttribute(new Float32Array(eg.attributes.position.count * 3).fill(0.95), 3));
	const edge = new THREE.Mesh(eg, fieldMats.verge);
	edge.name = `biome:${BIOMES.verge} rows:90`;
	edge.receiveShadow = true;
	root.add(edge);
	// tramlines in the sprayer's field every 24 m (its boom), where its wheels run
	const sf = out.find((f) => f.spray);
	if (sf) for (let x = sf.x0 + 12; x < sf.x1 - 6; x += 24) for (const dx of [-0.95, 0.95]) bag.add('dirt', groundQuad(x + dx - 0.25, sf.z0, x + dx + 0.25, sf.z1, 0.02, 4), '#c8c0b0');
	return sf;
}

/* ------------------------------------------------------------------------------------------------------------------
 * 11. The highway: carriageways, markings, the median barrier, guardrails, twin masts, gantries, billboards, the exit.
 * ---------------------------------------------------------------------------------------------------------------- */
const GANTRIES = [-1640, -1020, -880, -360];
function buildHighway(seed, bag, root, inst, vergeMat) {
	const { from, to } = HW;
	for (const s of [-1, 1]) {
		bag.add('asphalt', groundQuad(Math.min(s * 0.3, s * HW_EDGE), from, Math.max(s * 0.3, s * HW_EDGE), to + 2, 0.05, 8));
		// the banks: the roadside verge, its rows along the road
		const vg = groundQuad(Math.min(s * HW_EDGE, s * (HW_EDGE + HW.verge)), from, Math.max(s * HW_EDGE, s * (HW_EDGE + HW.verge)), to, 0.0, 4);
		vg.setAttribute('color', new THREE.Float32BufferAttribute(new Float32Array(vg.attributes.position.count * 3).fill(0.8), 3));
		const verge = new THREE.Mesh(vg, vergeMat);
		verge.name = `biome:${BIOMES.verge} rows:90`;
		verge.receiveShadow = true;
		root.add(verge);
		// edge lines, and the dashed lane lines (6 m dash, 12 m gap)
		for (const x of [HW.median / 2 + HW.inner - 0.075, HW.median / 2 + HW.inner + HW.lane * HW.lanes + 0.075]) bag.add('paint', groundQuad(s * x - 0.075, from, s * x + 0.075, to, 0.06));
		for (let i = 1; i < HW.lanes; i++) for (let z = from; z < to - 6; z += 18) inst.dash.push([s * (HW.median / 2 + HW.inner + HW.lane * i), 0.061, z + 3, 0.15, 6]);
	}
	bag.add('asphalt', groundQuad(-0.6, from, 0.6, to, 0.05, 8));
	// the median barrier: the accepted 4 m segments near the city (a gap at each gantry's leg), the same profile beyond
	const leg = (z) => GANTRIES.some((g) => Math.abs(z - g) < 3 || Math.abs(z - g - 60) < 3);
	for (let z = NEAR + 2; z < to - 2; z += 4) if (!leg(z)) useNode(root, H.jersey, 'seed=old', 0, 0, z, Math.PI / 2);
	const jersey = [[0, 0.81], [0.075, 0.81], [0.1, 0.33], [0.3, 0.08], [0.305, 0]];
	for (const s of [-1, 1]) bag.add('concrete', sweepZ(jersey, 0, from, NEAR, s), '#9a9890');
	// guardrails on the outer edges, the traffic side to the road; a gap where the exit leaves
	for (const s of [-1, 1]) {
		const x = s * (HW_EDGE + 0.45);
		const exitGap = (z) => s < 0 && z > EXIT.from - 6 && z < EXIT.from + 150;
		for (let z = NEAR + 2; z < to - 2; z += 4) if (!exitGap(z)) useNode(root, H.guardrail, 'seed=old', x, 0, z, s < 0 ? Math.PI / 2 : -Math.PI / 2);
		const beam = [[0, 0.55], [0.05, 0.6], [0, 0.66], [0.05, 0.72], [0, 0.77]];
		for (let z = from; z < NEAR; z += 40) {
			bag.add('steel', sweepZ(beam, x, z, Math.min(NEAR, z + 40), -s));
			for (let zz = z; zz < Math.min(NEAR, z + 40); zz += 2) inst.post.push([x + s * 0.1, 0.375, zz]);
		}
	}
	// twin light masts on the median every 50 m, their arms over both carriageways
	for (let z = from + 25; z < to; z += 50) if (!leg(z)) useNode(root, H.lamp, 'kind=2&seed=old', 0, 0, z, Math.PI / 2);
	// sign gantries over each carriageway (one leg in the median, one on the verge), the signs to the oncoming traffic
	for (const z of GANTRIES) {
		useNode(root, H.gantry, `seed=g${GANTRIES.indexOf(z) & 1}`, -11, 0, z, Math.PI);
		useNode(root, H.gantry, `seed=g${(GANTRIES.indexOf(z) + 1) & 1}`, 11, 0, z + 60, 0);
	}
	// billboards on the way in, faded posters to the traffic into the city
	for (const [x, z, k] of [[-31, -1180, 0], [32, -620, 1], [-32, -470, 2], [31, -250, 3]]) useNode(root, H.billboard, `lit=1&seed=old${k % 2}`, x, 0, z, x < 0 ? Math.PI * 0.92 : Math.PI * 1.08);
	// the exit: its carriageway and edge line, the frontage road
	const ep = exitPath();
	bag.add('asphalt', ribbon(ep, 7, 0.05));
	bag.add('paint', ribbon(ep.slice(0, 13), 0.15, 0.06, 3.3));
	for (let z = EXIT.bend; z < -170; z += 12) inst.dash.push([EXIT.x, 0.061, z + 1.5, 0.12, 3]);
	bag.add('asphalt', groundQuad(EXIT.x - 4, -160, EXIT.x + 4, -6, 0.05, 8));
}

/* ------------------------------------------------------------------------------------------------------------------
 * 12. The city: streets, sidewalks, crossings, signals, lamps, the blocks, the supermarket, the edge land.
 * ---------------------------------------------------------------------------------------------------------------- */
/** a block's buildings in its 80 × 80 m lot: [kind, dx, dz, yaw, values], each front (+z) to a street */
const BLOCK_PLANS = [
	[['slab', 0, 30, 0, 'length=60'], ['tower', -26, -12, Math.PI, ''], ['shops', 15, -32, Math.PI, '']],
	[['office', 0, 22, 0, ''], ['shops', 0, -30, Math.PI, '']],
	[['tower', -18, 14, 0, ''], ['tower', 18, -14, Math.PI, ''], ['slab', 18, 30, 0, 'length=36'], ['slab', -18, -30, Math.PI, 'length=36']],
	[['carpark', 0, 20, 0, ''], ['slab', 0, -28, Math.PI, 'length=60']],
	[['shops', 0, 32, 0, ''], ['slab', 0, -28, Math.PI, 'length=72'], ['tower', -26, 6, -Math.PI / 2, 'axes=5']]
