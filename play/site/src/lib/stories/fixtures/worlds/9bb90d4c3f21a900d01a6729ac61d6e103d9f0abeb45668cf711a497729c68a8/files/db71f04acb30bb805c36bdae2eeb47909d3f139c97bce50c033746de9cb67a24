	const B = BO.steel;
	bag.add('post', 'paint', cyl(B.r, B.r, B.band[0], 14), B.color, 0.7);
	bag.add('post', 'paint', cyl(B.r + 0.001, B.r + 0.001, B.band[1] - B.band[0], 14, [0, B.band[0], 0], null, true), '#e8e6dc', 0.5);
	bag.add('post', 'paint', cyl(B.r, B.r, B.h - B.band[1] - B.cap, 14, [0, B.band[1], 0], null, true), B.color, 0.6);
	const dome = new THREE.SphereGeometry(B.r, 14, 4, 0, Math.PI * 2, 0, Math.PI / 2);
	dome.scale(1, B.cap / B.r, 1);
	dome.translate(0, B.h - B.cap, 0);
	bag.add('post', 'paint', dome, B.color, 0.6);
	// the rusty foot: a ring of rust and scraped paint
	bag.add('post', 'paint', cyl(B.r + 0.0015, B.r + 0.002, 0.12, 14, [0, 0, 0], null, true), '#5a3a26', 0.8);
	bag.add('post', 'concrete', cyl(B.r + 0.05, B.r + 0.07, 0.02, 14), '#8c877c', 1);
}

function concreteBollard(bag) {
	const B = BO.concrete;
	const pts = [[0.001, 0], [B.r, 0], [B.r, 0], [B.r * 0.97, B.h - 0.12], [B.r * 0.8, B.h - 0.03], [B.r * 0.45, B.h], [0.001, B.h]];
	bag.add('post', 'concrete', turned(pts, 16), B.color, 0.85);
	// a chamfered groove near its top
	bag.add('post', 'concrete', cyl(B.r * 0.975, B.r * 0.975, 0.025, 16, [0, B.h - 0.22, 0], null, true), '#7f7a70', 0.8);
}

function flexibleBollard(bag) {
	const B = BO.flexible;
	bag.add('post', 'rubber', cyl(0.11, 0.12, 0.03, 12), '#2f2f2c', 0.8); // its base, bolted down
	for (const a of [0, Math.PI / 2, Math.PI, (3 * Math.PI) / 2]) bag.add('post', 'galvanised', cyl(0.012, 0.012, 0.035, 6, [Math.cos(a) * 0.085, 0, Math.sin(a) * 0.085]), '#77736b', 1);
	let y = 0.03;
	const parts = [[y, B.bands[0][0], B.color], [B.bands[0][0], B.bands[0][1], '#eeeeea'], [B.bands[0][1], B.bands[1][0], B.color], [B.bands[1][0], B.bands[1][1], '#eeeeea'], [B.bands[1][1], B.h - 0.02, B.color]];
	for (const [y0, y1, c] of parts) bag.add('post', 'plastic', cyl(B.r, B.r * (y0 < 0.1 ? 1.15 : 1), y1 - y0, 12, [0, y0, 0], null, true), c, c === B.color ? 0.6 : 0.45);
	const dome = new THREE.SphereGeometry(B.r, 12, 3, 0, Math.PI * 2, 0, Math.PI / 2);
	dome.scale(1, 0.5, 1);
	dome.translate(0, B.h - 0.02, 0);
	bag.add('post', 'plastic', dome, B.color, 0.6);
}

