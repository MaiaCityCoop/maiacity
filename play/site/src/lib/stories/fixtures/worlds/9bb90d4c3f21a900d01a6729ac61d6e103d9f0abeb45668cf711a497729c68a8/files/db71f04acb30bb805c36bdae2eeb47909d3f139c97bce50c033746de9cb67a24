const BO = {
	steel: { label: 'Steel', r: 0.057, h: 1.0, cap: 0.03, band: [0.85, 0.92], color: '#3f4440' },
	concrete: { label: 'Concrete', r: 0.15, h: 0.8, color: '#a7a297' },
