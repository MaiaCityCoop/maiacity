	'Bollards, the posts that keep cars off a pavement, in three kinds. Kind 0, Steel: a 114.3 mm steel tube 1.0 m out of the ground (the common street bollard: 0.9–1.0 m), domed cap, a white retroreflective band near the top, dark paint gone to rust at its scraped foot, a mortar collar. ' +
	'Kind 1, Concrete: a precast post Ø 300 mm, 0.8 m, its top rounded, a groove under it, stained. Kind 2, Flexible: a plastic delineator post Ø 80 mm, 0.8 m, orange-red with two white bands, on its bolted base. ' +
	'Each stands at the origin; stand them 1.2–1.5 m apart along a kerb (enough for a pram, too little for a car). Grime by its seed.';

function build(kind, seed) {
	const k = KINDS[kind ?? 0] ?? KINDS[0];
	const bag = new Bag(`${seed ?? 'maia'}`, 0.6);
	if (k === 'steel') steelBollard(bag);
	else if (k === 'concrete') concreteBollard(bag);
	else flexibleBollard(bag);
	return bag.build(`bollard:${k}`);
}

module.exports.recipe = function (id, v, variant) {
	if (variant) throw new Error(`no asset things/${id}@${v}:${variant} in this file`);
	return {
		meta: { group: 'things', id, version: v, label: 'Bollard', note: NOTE, params: JSON.parse(JSON.stringify(PARAMS)), world: { kinds: KINDS, spacing: [1.2, 1.5] } },
		build,
	};
};
module.exports.parts = { BO, steelBollard, concreteBollard, flexibleBollard, Bag, trianglesOf };

return module.exports.recipe("bollard", 2, null);
});
