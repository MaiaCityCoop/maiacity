/**
 * The grime of the old city on a colour at a place: soot and dust by noise, run-off streaks down from the top,
 * road splash near the ground. `dirt` 0 clean .. 1 very dirty; `seed` shifts the pattern per thing.
 */
function grimed(color, x, y, z, dirt, seed) {
	if (!dirt) return color;
	const o = seed * 17.31;
	const soot = fbm(x * 1.3 + o, y * 1.3, z * 1.3);
	const streak = noise3(x * 6 + o, y * 0.35, z * 6) * smooth(0.45, 0.8, noise3(x * 2.1 + o, 3.3, z * 2.1));
