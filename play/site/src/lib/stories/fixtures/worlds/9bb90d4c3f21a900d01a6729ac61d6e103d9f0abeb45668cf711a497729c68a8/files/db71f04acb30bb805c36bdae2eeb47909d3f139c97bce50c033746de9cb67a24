/**
 * Everything a thing is built of, by part and by material: each piece painted with its colour (weathered), then each
 * part's pieces merged per material into one mesh. A part of one material is one mesh, named as the part.
 */
class Bag {
	constructor(seed = 'maia', dirt = 0.6) {
		this.parts = new Map();
		this.seed = chance(seed, 'grime')();
		this.dirt = dirt;
	}
	/**
	 * Add a piece to a part, of a material, in a colour; `dirt` overrides the thing's own for this piece; `tint(x, y, z)`
	 * multiplies its colour at each point (a thing's own stains: tyre scuffs, rust, fading).
	 */
