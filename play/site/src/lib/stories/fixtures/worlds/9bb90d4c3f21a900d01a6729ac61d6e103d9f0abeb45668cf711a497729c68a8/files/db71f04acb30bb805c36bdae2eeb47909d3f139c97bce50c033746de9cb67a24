	 * signal's `head:1/lamp:red`), so a name the page drives (`lamp:red`) can stand once in each head. `special` makes
	 * a part's own material (a lens, a sign face), by the part's key or by the material's name.
	 */
	build(name, special = {}) {
		const root = new THREE.Group();
		root.name = name;
		const shared = new Map();
		const look = (m) => {
			if (!shared.has(m)) shared.set(m, new THREE.MeshStandardMaterial({ vertexColors: true, ...(LOOKS[m] ?? LOOKS.paint), name: m }));
			return shared.get(m);
		};
		const groups = new Map();
		const into = (key) => {
			const at = key.lastIndexOf('/');
			if (at < 0) return root;
			const gname = key.slice(0, at);
			if (!groups.has(gname)) {
				const g = new THREE.Group();
				g.name = gname;
				root.add(g);
				groups.set(gname, g);
			}
			return groups.get(gname);
		};
		for (const [key, byMat] of this.parts) {
			const part = key.slice(key.lastIndexOf('/') + 1);
			const meshes = [];
			for (const [m, list] of byMat) {
				const geo = list.length === 1 ? list[0] : mergeGeometries(list);
				if (list.length > 1) for (const g of list) g.dispose();
				const mat = special[key]?.(m) ?? special[part]?.(m) ?? special[m]?.(m) ?? look(m);
				const mesh = new THREE.Mesh(geo, mat);
				mesh.castShadow = mesh.receiveShadow = true;
				mesh.name = byMat.size === 1 ? part : `${part}/${m}`;
				meshes.push(mesh);
			}
			const parent = into(key);
			if (meshes.length === 1) parent.add(meshes[0]);
			else {
				const g = new THREE.Group();
				g.name = part;
				for (const m of meshes) g.add(m);
				parent.add(g);
			}
		}
		return root;
	}
}

/** how many triangles a built thing has */
function trianglesOf(o) {
	let n = 0;
	o.traverse((m) => {
		if (m.isMesh) n += (m.geometry.index ? m.geometry.index.count : m.geometry.getAttribute('position').count) / 3;
	});
	return Math.round(n);
}

/*
 * ============================================================================================================
 * PART 2 · BOLLARDS — the posts that keep cars off a pavement, in three kinds:
 *   - `steel`: a 114 mm steel tube, 1.0 m out of the ground, its domed cap, a white retroreflective band near the
 *     top, the paint chipped to rust at its foot (cars nudge them);
 *   - `concrete`: a precast concrete post, Ø 300 mm and 0.8 m, its top rounded, stained;
 *   - `flexible`: a plastic delineator post, Ø 80 mm and 0.8 m, orange-red with two white bands, on its base.
