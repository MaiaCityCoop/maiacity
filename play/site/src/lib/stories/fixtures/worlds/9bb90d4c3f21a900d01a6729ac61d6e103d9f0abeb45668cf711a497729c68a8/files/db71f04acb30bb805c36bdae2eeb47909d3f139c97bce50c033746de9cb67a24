	const c = color.clone().multiplyScalar(1 - dark);
	// soot is a warm grey: pull the colour a little toward it
	const grey = (c.r + c.g + c.b) / 3;
	return c.lerp(new THREE.Color(grey * 1.02, grey, grey * 0.96), clamp(dirt * 0.35));
