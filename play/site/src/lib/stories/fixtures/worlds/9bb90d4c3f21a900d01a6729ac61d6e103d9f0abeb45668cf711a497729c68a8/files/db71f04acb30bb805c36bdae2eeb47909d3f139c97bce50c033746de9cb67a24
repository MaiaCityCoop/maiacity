 * PART 3 · THE RECIPE
 * ------------------------------------------------------------------------------------------------------------ */

const PARAMS = [
	{ id: 'kind', label: 'Kind', type: 'integer', min: 0, max: KINDS.length - 1, value: 0, names: KINDS.map((k) => BO[k].label) },
	{ id: 'seed', label: 'Seed', type: 'string', value: 'maia', maxLength: 40 },
