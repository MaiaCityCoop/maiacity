/*
 * ============================================================================================================
 * PART 1 · THE STREET KIT — shared by the street and road things (traffic signal, lamps, barrier, guardrail,
 * gantry, billboard, bollards, pylon), carried in each recipe as it is.
 *
 * - 1 unit = 1 m, never scaled; the thing stands on y = 0, its front toward +z, lying along x where it is long.
 * - Built in named parts (`Bag.add(part, material, geometry, colour)`): every part's pieces are merged per material,
 *   so a thing is a handful of meshes and draw calls, and the world can stand it hundreds of times.
 * - Weathered as the old city is: each piece's colour is darkened by grime by its place (noise, run-off streaks,
 *   road splash near the ground), so two lamps a kilometre apart are not the same dirty, but one seed is always the
 *   same lamp.
 * - Lights are named for the page to drive (THE WORLD CONTRACT v1): a signal head's lenses `lamp:red`,
 *   `lamp:amber`, `lamp:green`, a lamp's glowing bowl `light:lamp`; each its own mesh and its own material.
 * ============================================================================================================
 */
const THREE = require('three');
const { mergeGeometries } = require('three/addons/utils/BufferGeometryUtils.js');

/** a stream of chance from a text: the same text, the same numbers */
