/** the kinds it is built as, in the order of its `kind` value */
const KINDS = [
	{ id: 'pole', label: 'Pole', make: polesignal },
	{ id: 'mast-arm', label: 'Mast arm', make: mastsignal },
];

const PARAMS = [
	{ id: 'kind', label: 'Kind', type: 'integer', min: 0, max: KINDS.length - 1, value: 0, names: KINDS.map((k) => k.label) },
	{ id: 'state', label: 'State', type: 'integer', min: 0, max: STATES.length - 1, value: 0, names: STATES },
	{ id: 'seed', label: 'Seed', type: 'string', value: 'maia', maxLength: 40 },
];

const NOTE =
	'A three-aspect vehicle traffic signal of the old city: 300 mm lenses (EN 12368 Ø300, ITE VTCSH 12 in) red over amber over green at 355 mm centres in a 400 × 1065 × 240 mm housing, cap visors, a 740 × 1400 mm black backplate with a 50 mm pale border, dark-green paint gone dull and sooty. ' +
	'Kind 0, Pole: one head on a 114 mm galvanised post 3.9 m high, its lowest lens at 2.6 m (head bottom about 2.4 m, over the 2.1–2.5 m kerbside minimum), a push button at 1.05 m facing +x. ' +
	'Kind 1, Mast arm: a tapered pole 330 → 240 mm and 7.4 m on a base plate and footing, its arm reaching 9 m toward −x at 6.6 m with a tie rod, two heads hung with 5.2 m clear under them (≥ 5.0–5.5 m over a carriageway), and a near-side head on the pole. ' +
	'Every head faces +z: for right-hand traffic stand it at the right kerb of the approach, the arm then reaching over the lanes. State: Off (the default: every lens dark, its OFF look, for the page to light), Red, Amber, Green, Red-amber for a still build. Each head (group head:1, head:2 …) has its lenses as meshes named lamp:red, lamp:amber, lamp:green, each its own material, for the page to drive by emissiveIntensity (lit 1.6, dark 0); userData.signal lists the heads. Grime by its seed.';

function build(kind, state, seed) {
	const k = KINDS[kind ?? 0] ?? KINDS[0];
	const bag = new Bag(`${seed ?? 'maia'}`, 0.55);
	const made = k.make(bag);
	const root = bag.build(`traffic-signal:${k.id}`, lensMaterials(state ?? 0));
	root.userData.signal = { kind: k.id, state: STATES[state ?? 0], heads: made.heads, lamps: { on: LAMP.on, off: LAMP.off, lit: SIG_C.lit } };
	return root;
}

