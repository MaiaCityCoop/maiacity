function polesignal(bag) {
	const P = SIG.post;
	bag.add('post', 'galvanised', cyl(P.r, P.r, P.h, 12), SIG_C.galv);
	bag.add('post', 'galvanised', cyl(P.r * 0.4, P.r + 0.01, 0.05, 12, [0, P.h, 0]), SIG_C.galv); // its cap
	bag.add('post', 'concrete', cyl(0.16, 0.18, 0.03, 12, [0, 0, 0]), SIG_C.concrete, 0.9); // its collar in the pavement
	const yMid = SIG.poleLens + SIG.pitch; // the amber's middle is the head's middle
	const back = P.r + 0.07;
	const head = signalHead(bag, 1, [0, yMid, back]);
	clamp2(bag, 'head:1/bracket', P.r, head.top - 0.18, back + 0.02, SIG_C.galv);
	clamp2(bag, 'head:1/bracket', P.r, head.bottom + 0.18, back + 0.02, SIG_C.galv);
	// the walkers' push button, facing the crossing (+x), at 1.05 m
	bag.add('button', 'paint', box(0.1, 0.18, 0.08, [P.r + 0.04, 1.05, 0]), SIG_C.button);
	bag.add('button', 'paint', box(0.004, 0.05, 0.05, [P.r + 0.082, 1.08, 0]), '#3a3a36');
	return { heads: [{ x: 0, y: yMid, z: head.front }], height: P.h };
}

/** the mast-arm signal: a tapered pole on its plate and footing, an arm out over the lanes, two hung heads and one near */
function mastsignal(bag) {
	const M = SIG.mast, A = SIG.arm;
	bag.add('footing', 'concrete', cyl(0.42, 0.45, 0.12, 14, [0, 0, 0]), SIG_C.concrete, 1);
	bag.add('pole', 'paint', box(0.62, 0.035, 0.62, [0, 0.135, 0]), SIG_C.mastPaint);
	for (const [bx, bz] of [[-1, -1], [1, -1], [-1, 1], [1, 1]]) bag.add('pole', 'galvanised', cyl(0.025, 0.025, 0.06, 6, [bx * 0.24, 0.15, bz * 0.24]), SIG_C.galv, 1);
	bag.add('pole', 'paint', cyl(M.rTop, M.rFoot, M.h - 0.15, 14, [0, 0.15, 0]), SIG_C.mastPaint);
	bag.add('pole', 'paint', cyl(0.02, M.rTop + 0.01, 0.06, 14, [0, M.h, 0]), SIG_C.mastPaint);
	bag.add('pole', 'paint', box(0.16, 0.3, 0.04, [0, 0.55, M.rFoot]), SIG_C.mastPaint); // the hand-hole cover
	// the arm: a clamp plate on the pole, then the tapered tube rising a little toward its tip at −x
	const rAt = M.rFoot + (M.rTop - M.rFoot) * (A.at / M.h);
	bag.add('arm', 'paint', box(0.06, 0.5, 0.42, [-rAt - 0.03, A.at, 0]), SIG_C.mastPaint);
	const tip = [-rAt - 0.06 - A.length, A.at + A.rise, 0];
	bag.add('arm', 'paint', rod([-rAt - 0.06, A.at, 0], tip, A.rFoot, A.rTip, 12), SIG_C.mastPaint);
	bag.add('arm', 'paint', disc(A.rTip, 12, tip, [0, -Math.PI / 2, 0]), SIG_C.mastPaint);
	// a tie rod above it, as long arms have, from the pole to two thirds out
	const tieTo = [-rAt - 0.06 - A.length * 0.62, A.at + A.rise * 0.62 + A.rFoot * 0.6, 0];
	bag.add('arm', 'galvanised', rod([-rAt, A.at + 0.75, 0], tieTo, 0.022, 0.022, 6), SIG_C.galv);
	const heads = [];
	SIG.heads.forEach((hx, i) => {
		const armY = A.at + A.rise * ((-hx - rAt) / A.length);
		const top = SIG.clear + SIG.housing[1];
		const yMid = SIG.clear + SIG.housing[1] / 2;
		const head = signalHead(bag, i + 1, [hx, yMid, 0.0]);
		// the hanger: a short tube from under the arm to the head's top, and a span plate
		bag.add(`head:${i + 1}/bracket`, 'galvanised', rod([hx, armY - A.rFoot * 0.7, 0.06], [hx, top, 0.06], 0.03, 0.03, 8), SIG_C.galv);
		bag.add(`head:${i + 1}/bracket`, 'galvanised', box(0.2, 0.03, 0.12, [hx, top + 0.015, 0.1]), SIG_C.galv);
		heads.push({ x: hx, y: yMid, z: head.front });
	});
	// the near-side head on the pole, for the drivers at the stop line
	const yNear = SIG.poleLens + SIG.pitch, back = M.rFoot + 0.07;
	const near = signalHead(bag, 3, [0, yNear, back]);
	const rNear = (y) => M.rFoot + (M.rTop - M.rFoot) * (y / M.h);
	clamp2(bag, 'head:3/bracket', rNear(near.top - 0.18), near.top - 0.18, back + 0.02, SIG_C.galv);
	clamp2(bag, 'head:3/bracket', rNear(near.bottom + 0.18), near.bottom + 0.18, back + 0.02, SIG_C.galv);
	heads.push({ x: 0, y: yNear, z: near.front });
	return { heads, height: M.h, reach: tip[0] - A.rTip };
}

