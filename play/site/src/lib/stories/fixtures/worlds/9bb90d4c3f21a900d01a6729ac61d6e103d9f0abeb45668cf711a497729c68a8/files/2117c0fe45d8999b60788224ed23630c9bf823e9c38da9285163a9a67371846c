			// the bottom face's zig-zag and the top's ties
			member(bag, k % 2 ? p.b[0] : p.b[1], k % 2 ? q.b[1] : q.b[0]);
			member(bag, q.b[0], q.b[1]);
			member(bag, q.t[0], q.t[1]);
		}
	}
}

/** one I-string of insulators hanging from (x, y) to its conductor clamp `PY.string` lower: caps of glass on a rod */
function insulator(bag, k, x, y) {
	const len = PY.string;
	bag.add('insulators', 'galvanised', rod([x, y, 0], [x, y - 0.35, 0], 0.03, 0.03, 6), PY_C.fitting, 0.3);
	// the string: a lathe of 6 sheds standing for its 20 caps (seen from the fields, not counted), five-sided
	const caps = 6, top = y - 0.35, bottom = y - len + 0.45, pitch = (top - bottom) / caps;
	const pts = [[0.02, 0]];
	for (let i = 0; i < caps; i++) {
		const b = i * pitch;
		pts.push([0.04, b + pitch * 0.1], [0.14, b + pitch * 0.45], [0.04, b + pitch * 0.8]);
	}
	pts.push([0.02, caps * pitch]);
	const g = new THREE.LatheGeometry(pts.map(([r, yy]) => new THREE.Vector2(r, yy)), 5);
	g.translate(x, bottom, 0);
	bag.add('insulators', 'glass', g, PY_C.glass, 0.25);
	// the yoke and the conductor clamp under it: a four-bundle spacer 450 mm square
	bag.add('insulators', 'galvanised', rod([x, bottom, 0], [x, y - len + 0.1, 0], 0.03, 0.03, 6), PY_C.fitting, 0.3);
	bag.add('insulators', 'galvanised', box(0.06, 0.06, 0.5, [x, y - len + 0.08, 0]), PY_C.fitting, 0.3);
	return [x, Math.round((y - len) * 1000) / 1000, 0];
}

function pylon(bag) {
	body(bag);
	crossarm(bag, PY.lowArm);
	crossarm(bag, PY.upArm);
	// the earth-wire arm across the peak
	const E = PY.earth;
	for (const s of [-1, 1]) {
		bag.add('arms', 'galvanised', bar([s * 0.3, PY.peak, -0.3], [s * E.half, PY.peak - 0.6, 0], 0.08), PY_C.steel, 0.35);
		bag.add('arms', 'galvanised', bar([s * 0.3, PY.peak, 0.3], [s * E.half, PY.peak - 0.6, 0], 0.08), PY_C.steel, 0.35);
		bag.add('arms', 'galvanised', bar([s * PY.top.w / 2, PY.top.y, 0], [s * E.half, PY.peak - 0.6, 0], 0.07), PY_C.steel, 0.35);
	}
	// the phases: two a side on the lower arm, one a side on the upper; their clamps where the conductors hang
	const attach = { conductors: [], earth: [] };
	let k = 0;
	for (const A of [PY.lowArm, PY.upArm])
		for (const s of [-1, 1])
			for (const px of A.phases) {
				const t = (px - bodyW(A.y) / 2) / (A.half - bodyW(A.y) / 2);
				const yArm = A.y; // hung from the arm's bottom chords
				attach.conductors.push({ circuit: s < 0 ? 1 : 2, at: insulator(bag, ++k, s * px, yArm - 0.02 * t), bundle: 4, spacing: 0.45 });
			}
	for (const s of [-1, 1]) {
		bag.add('insulators', 'galvanised', box(0.12, 0.25, 0.12, [s * E.half, PY.peak - 0.75, 0]), PY_C.fitting, 0.3);
		attach.earth.push({ at: [s * E.half, PY.peak - 0.85, 0] });
	}
	return attach;
}

/* ------------------------------------------------------------------------------------------------------------
 * PART 3 · THE RECIPE
 * ------------------------------------------------------------------------------------------------------------ */

const PARAMS = [{ id: 'seed', label: 'Seed', type: 'string', value: 'maia', maxLength: 40 }];
const NOTE =
	'A high-voltage lattice suspension tower of the Danube form, the kind that carries the 380/400 kV lines across the fields: two circuits of three phases on two crossarms (the lower 23 m wide, two phases a side; the upper 15 m, one a side) and an earth-wire arm on its peak, 42 m to its top. ' +
	'Galvanised steel angles in a square body tapering from 8.4 m at its feet to 2.4 m at the waist, X-braced panel by panel, plan-braced at the arm seats, on four concrete footings, with an anti-climbing guard at 3.5 m and a yellow danger plate. ' +
	'I-strings of glass cap-and-pin insulators 4.2 m long (their 20 caps drawn as 6 sheds) hang from the arms, each with a yoke for a four-conductor bundle (450 mm). The crossarms lie along x, so the lines run along ±z; userData.attach (and meta.world.attach) gives every conductor clamp (x, y, z) by circuit and both earth-wire points, for the world to string the spans from (380 kV spans run 300–450 m, sagging 10–15 m mid-span). Weathered zinc by its seed.';

function build(seed) {
	const bag = new Bag(`${seed ?? 'maia'}`, 0.35);
	const attach = pylon(bag);
	const root = bag.build('pylon');
	root.userData.attach = attach;
	return root;
}

/** where the lines hang, without building it */
function attachPoints() {
	const out = { conductors: [], earth: [] };
	for (const A of [PY.lowArm, PY.upArm])
		for (const s of [-1, 1])
			for (const px of A.phases) {
				const t = (px - bodyW(A.y) / 2) / (A.half - bodyW(A.y) / 2);
				out.conductors.push({ circuit: s < 0 ? 1 : 2, at: [s * px, Math.round((A.y - 0.02 * t - PY.string) * 1000) / 1000, 0] });
			}
	for (const s of [-1, 1]) out.earth.push({ at: [s * PY.earth.half, PY.peak - 0.85, 0] });
	return out;
}

module.exports.recipe = function (id, v, variant) {
	if (variant) throw new Error(`no asset things/${id}@${v}:${variant} in this file`);
	return {
		meta: { group: 'things', id, version: v, label: 'Power pylon', note: NOTE, params: JSON.parse(JSON.stringify(PARAMS)), world: { lines: '±z', span: [300, 450], attach: attachPoints() } },
		build,
	};
};
module.exports.parts = { PY, bodyW, pylon, attachPoints, Bag, trianglesOf };

return module.exports.recipe("pylon", 2, null);
