	build(origin = [0, 0, 0], parent = [0, 0, 0]) {
		const grp = new THREE.Group();
		grp.name = this.name;
		grp.position.set(origin[0] - parent[0], origin[1] - parent[1], origin[2] - parent[2]);
		const local = (g) => g.translate(-origin[0], -origin[1], -origin[2]);
		for (const [mat, list] of this.parts) {
			const mesh = new THREE.Mesh(local(mergeGeometries(list)), this.mats[mat]);
			mesh.name = `${this.name}:${mat}`;
			mesh.castShadow = true;
			mesh.receiveShadow = true;
			grp.add(mesh);
		}
		for (const [name, list] of this.lights) {
			const mesh = new THREE.Mesh(local(mergeGeometries(list)), (this.mats.lamps[name] ??= lampMaterial(name)));
			mesh.name = name;
			grp.add(mesh);
		}
		this.wheels.forEach((w, i) => {
			const pivot = new THREE.Group();
			pivot.name = `wheel:${w.id}`;
			pivot.position.set(w.at[0] - origin[0], w.at[1] - origin[1], w.at[2] - origin[2]);
			pivot.userData.radius = w.spec.D / 2;
			const mesh = new THREE.Mesh(wheelGeometry({ ...w.spec, out: Math.sign(w.at[0]) || 1, s: i }), this.mats.body);
			mesh.name = `wheel:${w.id}:tyre`;
			mesh.castShadow = true;
			pivot.add(mesh);
			grp.add(pivot);
		});
