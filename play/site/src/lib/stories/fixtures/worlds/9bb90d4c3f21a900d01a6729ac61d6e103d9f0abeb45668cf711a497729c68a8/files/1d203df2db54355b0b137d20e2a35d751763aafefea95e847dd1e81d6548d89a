/** the colours an old fleet runs in: each cab faded its own way, the reefer bodies all once-white */
const VARIANTS = {
	white: { label: 'Faded white', cab: '#b8b3a4', box: '#c4bfae' },
	red: { label: 'Faded red', cab: '#7a4034', box: '#c2bdad' },
	blue: { label: 'Faded blue', cab: '#3e5470', box: '#bfbcb0' },
	green: { label: 'Faded green', cab: '#4c5944', box: '#c0bcac' },
};

const FACTS = {
	length: 16.55, width: { body: 2.6, mirrors: 2.9 }, height: 4.0, unit: 'm',
	tractor: { length: 6.0, wheelbase: SEMI.WB, frontOverhang: SEMI.FO, fifthWheel: SEMI.fifth, cab: { depth: SEMI.CAB, roof: 3.3, deflector: 3.97 }, tyres: '315/70 R22.5 (twin on the drive axle)', mass: 7500, engine: 'diesel six, about 12 L, 300–330 kW (Euro III era)' },
	trailer: { length: SEMI.TL, kingpin: SEMI.KP, floor: SEMI.floor, axles: 3, axleSpread: 1.31, kingpinToAxles: 7.7, tyres: '385/65 R22.5 single', mass: 8500, pallets: 33, unit: 'a diesel refrigeration unit, −25 … +25 °C' },
	mass: { empty: 16000, laden: 40000, unit: 'kg' },
	speed: { limit: 80, unit: 'km/h' },
	articulation: 'the trailer pivots at the kingpin: the group `trailer` turns about y at its origin',
	sources: 'Directive (EU) 2015/719 amending 96/53/EC (lengths, widths, 40 t); ETRTO tyre sizes; UN R58 / R73 guards; trade data of 4×2 tractors and 13.6 m reefer semi-trailers',
};

function build(variant = 'white') {
	const V = VARIANTS[variant] ?? VARIANTS.white;
	const grime = grimePicture(variant);
	const m = materials(grime, { paint: V.cab, paint2: V.box });
	const t = tractor(m, variant);
	t.carry(reefer(m, variant), [0, SEMI.fifth, SEMI.zKP]);
	const root = t.build([0, 0, 0]);
	root.name = 'semi-truck';
	return root;
}

module.exports.recipe = function (id, v, variant) {
	const name = variant ?? 'white';
	if (!VARIANTS[name]) throw new Error(`no variant ${name} of machines/${id}@${v}`);
	return {
		meta: {
			group: 'machines',
			id,
			version: v,
			variant: name,
			label: `Semi-truck · reefer: ${VARIANTS[name].label}`,
			note: 'A worn 4×2 cab-over tractor unit and a 13.6 m refrigerated trailer, 16.55 × 2.60 × 4.00 m, the food lorry of the old world’s highway. Lights named for the page (light:head, tail, brake, indicator-l, indicator-r), wheels as pivots (wheel:<axle>-<l|r>), the trailer a pivot at its kingpin (trailer).',
			from: 'Old City: the highway',
			facts: JSON.parse(JSON.stringify(FACTS)),
			params: [],
		},
		build: () => build(name),
	};
};
module.exports.variants = Object.keys(VARIANTS);
module.exports.build = build;

return module.exports.recipe("semi-truck", 3, "blue");
});
