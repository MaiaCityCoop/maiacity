/** triangles of an object, for the budget */
function trianglesOf(root) {
	let n = 0;
	root.traverse((o) => {
		if (o.isMesh) n += (o.geometry.index ? o.geometry.index.count : o.geometry.attributes.position.count) / 3;
	});
	return Math.round(n);
}

/**
 * A cab-over-engine cab, as European lorries have them: its side profile pushed across, a face raked back about 5°,
 * the windscreen in its rubber, a sun visor, the grille and its slats, side windows, door seams and handles, mirrors
 * on two arms, steps behind the front wheel, its mudguard, the bumper with headlights and indicators in its corners,
 * side repeaters and roof markers. All of it in `b` (a Body), its face at z = zf.
