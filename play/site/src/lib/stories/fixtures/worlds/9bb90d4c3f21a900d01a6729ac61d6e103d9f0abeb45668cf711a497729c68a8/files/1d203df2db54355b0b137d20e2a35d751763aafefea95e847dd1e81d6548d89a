	const gm = (g0 + g1) / 2, gh = g1 - g0;
	b.add('rubber', box(2 * W - 0.19, gh + 0.08, 0.02, [0, gm, zAt(gm) + 0.006], { rx: rake, seg: 1 }));
	b.add('glass', box(2 * W - 0.29, gh, 0.02, [0, gm, zAt(gm) + 0.014], { rx: rake, seg: 1 }));
	b.add('plastic', box(2 * W - 0.15, 0.05, 0.26, [0, g1 + 0.1, zAt(g1 + 0.1) + 0.04], { rx: 0.25, seg: 1 }));
	// the grille between the bumper and the glass
	const gr0 = o.bumper + 0.12, gr1 = g0 - 0.2;
	b.add('plastic', box(2 * W - 0.55, gr1 - gr0, 0.03, [0, (gr0 + gr1) / 2, zf], { seg: 1 }));
	const n = Math.max(2, Math.round((gr1 - gr0) / 0.14));
	for (let i = 0; i < n; i++) b.add('chassis', box(2 * W - 0.65, 0.05, 0.03, [0, gr0 + 0.08 + (i * (gr1 - gr0 - 0.16)) / (n - 1), zf + 0.018], { seg: 1 }));
	for (const s of [1, -1]) {
		const wz = Math.min(0.9, depth - 0.75);
		b.add('glass', box(0.02, gh * 0.75, wz, [s * (W + 0.002), gm + 0.04, zf - 0.23 - wz / 2], { seg: 1 }));
		b.add('chassis', box(0.012, roof - bottom - 0.4, 0.012, [s * (W + 0.004), (roof + bottom) / 2 - 0.1, zf - 1.2], { seg: 1 }));
		b.add('plastic', box(0.03, 0.04, 0.2, [s * (W + 0.01), g0 + 0.05, zf - 1.05], { seg: 1 }));
		// mirrors on their arms
		b.add('steel', rod([s * W, g1 + 0.07, zf - 0.22], [s * (W + 0.18), g1 + 0.07, zf - 0.08], 0.018, 6));
		b.add('steel', rod([s * W, g0 + 0.3, zf - 0.22], [s * (W + 0.18), g0 + 0.3, zf - 0.08], 0.018, 6));
		b.add('plastic', box(0.07, 0.52, 0.24, [s * (W + 0.2), g1 - 0.28, zf - 0.08], { seg: 1 }));
		// the steps behind the front wheel and the arch's mudguard
		const zw = zFA - wheelR - 0.03;
		b.add('plastic', span([s * (W - 0.24), 0.42, zb + 0.03], [s * (W - 0.04), 0.47, Math.min(zw, zb + 0.3)]));
		b.add('plastic', span([s * (W - 0.24), 0.78, zb + 0.03], [s * (W - 0.04), 0.83, Math.min(zw, zb + 0.3)]));
		b.add('rubber', span([s * (W - 0.4), 0.2, zw - 0.03], [s * W, bottom - 0.1, zw]));
		b.add('plastic', span([s * (W - 0.42), bottom - 0.12, zw], [s * W, bottom + 0.01, zFA + wheelR * 0.75]));
		b.lamp(s > 0 ? 'light:indicator-l' : 'light:indicator-r', box(0.02, 0.05, 0.1, [s * (W + 0.01), bottom + 0.16, zf - 0.55], { seg: 1 }));
		b.add('lensAmber', box(0.08, 0.04, 0.05, [s * (W - 0.3), roof + 0.01, zf - 0.6], { seg: 1 }));
	}
	// the bumper, its headlights and indicators in its top corners, the air dam under it
	const bt = o.bumper;
	b.add('plastic', span([-(W - 0.01), 0.42, zf - 0.4], [W - 0.01, bt, zf + 0.04]));
	b.add('chassis', span([-(W - 0.35), 0.3, zf - 0.35], [W - 0.35, 0.42, zf - 0.05]));
	pair(b, 'light:head', W - 0.42, bt - 0.16, zf + 0.045, 0.4, 0.16, 0.02);
	b.lamp('light:indicator-l', box(0.13, 0.13, 0.02, [W - 0.12, bt - 0.16, zf + 0.045], { seg: 1 }));
	b.lamp('light:indicator-r', box(0.13, 0.13, 0.02, [-(W - 0.12), bt - 0.16, zf + 0.045], { seg: 1 }));
	return zb;
}

/* ============================================================================================================
 * PART 2 · THE SEMI-TRUCK — a European 4×2 cab-over tractor unit and a 13.6 m tri-axle refrigerated trailer, as the
 * old world runs them: food on the long highway into the city, the paint chalky, the box streaked, the chassis black
 * with road film, soot at the stack.
 *
 * Measures (the EU's own and the trade's; every one in metres):
 *   the combination 16.55 long (EU limit 16.50, its reefer unit allowed beyond), 2.60 wide over the trailer's body
 *     (2.55 for others, 2.60 for a refrigerated body: Directive 96/53/EC as amended), 4.00 high, mirrors 2.90 across;
 *   the tractor: front overhang 1.45, wheelbase 3.60, the fifth wheel 0.50 ahead of the drive axle at 1.15 high;
 *     a sleeper cab 2.25 deep, its roof 3.30 and its deflector up to 3.97 to meet the trailer's roof;
 *     tyres 315/70 R22.5 (1.01 across), twin on the drive axle, the front track 2.05;
 *   the trailer: 13.60 long, its kingpin 1.60 behind its front wall, its floor 1.25 up, its body 2.75 high (2.60 inside),
 *     three axles 1.31 apart, the middle one 7.70 behind the kingpin, tyres 385/65 R22.5 (1.07 across) single,
 *     a diesel refrigeration unit 0.42 deep on its front wall, landing legs 1.30 behind the kingpin,
 *     side guards and a rear underrun guard (UN R73, R58).
 *   Masses: tractor about 7.5 t, the reefer trailer about 8.5 t empty, 40 t laden (EU), 33 pallets.
 * ============================================================================================================ */

const SEMI = {
	FO: 1.45, WB: 3.6, LEAD: 0.5, KP: 1.6, TL: 13.6, CAB: 2.25,
	fifth: 1.15, floor: 1.25, roof: 4.0, half: 1.3,
	tyreF: { D: 1.012, W: 0.315, rim: 0.5715 },
	tyreR: { D: 1.012, W: 0.315, rim: 0.5715, dual: true },
	tyreT: { D: 1.072, W: 0.385, rim: 0.5715 },
};
// where everything is along z, the combination's middle at 0, its front toward +z
SEMI.L = SEMI.FO + SEMI.WB - SEMI.LEAD - SEMI.KP + SEMI.TL;
SEMI.zF = SEMI.L / 2; // the cab's face
SEMI.zFA = SEMI.zF - SEMI.FO; // front axle
SEMI.zRA = SEMI.zFA - SEMI.WB; // drive axle
SEMI.zKP = SEMI.zRA + SEMI.LEAD; // kingpin
SEMI.zCB = SEMI.zF - SEMI.CAB; // the cab's back
SEMI.zTF = SEMI.zKP + SEMI.KP; // the trailer's front wall
SEMI.zTR = SEMI.zTF - SEMI.TL; // its doors
SEMI.zT = [SEMI.zKP - 7.7 + 1.31, SEMI.zKP - 7.7, SEMI.zKP - 7.7 - 1.31]; // its three axles

/** the tractor unit: cab, chassis, tanks, stack, fifth wheel, its four wheel ends */
function tractor(m, seed) {
	const S = SEMI, zf = S.zF, zb = S.zCB;
	const b = new Body('tractor', seed, m, {
		wear: { soot: (p) => smooth(3.1, 3.85, p.y) * smooth(0.35, 0.05, Math.hypot(p.x - 0.98, p.z - (zb - 0.18))) },
	});
	const W = 2.49 / 2;

	// the cab: its side profile pushed across, a raked face, a medium roof, the deflector over it
	b.add('paint', profile([[zf - 0.02, 1.12], [zf, 1.9], [zf - 0.1, 2.88], [zf - 0.3, 3.2], [zf - 0.55, 3.3], [zb, 3.3], [zb, 1.12]], -W, W, 0.04));
	b.add('paint', profile([[zf - 0.6, 3.28], [zf - 1.25, 3.72], [zb + 0.06, 3.97], [zb + 0.06, 3.28]], -1.12, 1.12, 0.02));
	// the windscreen in its rubber, leaning back with the face (4.8°)
	const rake = -Math.atan2(0.1, 0.98), zAt = (y) => zf - (0.1 * (y - 1.9)) / 0.98;
	b.add('rubber', box(2.3, 0.92, 0.02, [0, 2.42, zAt(2.42) + 0.006], { rx: rake, seg: 1 }));
	b.add('glass', box(2.2, 0.84, 0.02, [0, 2.42, zAt(2.42) + 0.014], { rx: rake, seg: 1 }));
	b.add('plastic', box(2.34, 0.05, 0.26, [0, 2.93, zAt(2.93) + 0.04], { rx: 0.25, seg: 1 })); // sun visor
	// the grille and its slats, the step of the face under it
	b.add('plastic', box(1.95, 0.6, 0.03, [0, 1.52, zf + 0.0], { seg: 1 }));
	for (let i = 0; i < 4; i++) b.add('chassis', box(1.85, 0.05, 0.03, [0, 1.3 + i * 0.14, zf + 0.018], { seg: 1 }));
	// the side windows and the doors' seams and handles, both sides
	for (const s of [1, -1]) {
		b.add('glass', box(0.02, 0.72, 0.9, [s * (W + 0.002), 2.46, zf - 0.68], { seg: 1 }));
		b.add('glass', box(0.02, 0.42, 0.22, [s * (W + 0.002), 2.62, zf - 0.08 - 0.06], { seg: 1 }));
		b.add('chassis', box(0.012, 1.75, 0.012, [s * (W + 0.004), 2.03, zf - 1.2], { seg: 1 }));
		b.add('plastic', box(0.03, 0.04, 0.2, [s * (W + 0.01), 1.95, zf - 1.05], { seg: 1 }));
		// mirrors on their arms
		b.add('steel', rod([s * W, 2.95, zf - 0.22], [s * 1.42, 2.95, zf - 0.08], 0.018, 6));
		b.add('steel', rod([s * W, 2.2, zf - 0.22], [s * 1.42, 2.2, zf - 0.08], 0.018, 6));
		b.add('plastic', box(0.07, 0.52, 0.24, [s * 1.44, 2.6, zf - 0.08], { seg: 1 }));
		b.add('glass', box(0.012, 0.46, 0.2, [s * 1.44, 2.6, zf - 0.08 + 0.004 * 0], { seg: 1 }));
		// the steps behind the front wheel and the arch's mudguard
		b.add('plastic', span([s * 1.0, 0.42, zf - 2.22], [s * 1.2, 0.47, zf - 1.98]));
		b.add('plastic', span([s * 1.0, 0.78, zf - 2.22], [s * 1.2, 0.83, zf - 1.98]));
		b.add('rubber', span([s * 0.85, 0.2, zf - 2.0], [s * 1.24, 0.95, zf - 1.97]));
		b.add('plastic', span([s * 0.82, 1.0, zf - 2.0], [s * 1.24, 1.13, zf - 0.85]));
		// a side repeater
		b.lamp(s > 0 ? 'light:indicator-l' : 'light:indicator-r', box(0.02, 0.05, 0.1, [s * (W + 0.01), 1.28, zf - 0.55], { seg: 1 }));
		// roof markers
		b.add('lensAmber', box(0.08, 0.04, 0.05, [s * 0.95, 3.31, zf - 0.6], { seg: 1 }));
	}
	// the bumper, its headlights and indicators in its top corners
	b.add('plastic', span([-1.24, 0.42, zf - 0.4], [1.24, 1.08, zf + 0.04]));
	b.add('chassis', span([-0.9, 0.3, zf - 0.35], [0.9, 0.42, zf - 0.05])); // the air dam
	pair(b, 'light:head', 0.82, 0.92, zf + 0.045, 0.42, 0.16, 0.02);
	b.lamp('light:indicator-l', box(0.13, 0.13, 0.02, [1.13, 0.92, zf + 0.045], { seg: 1 }));
	b.lamp('light:indicator-r', box(0.13, 0.13, 0.02, [-1.13, 0.92, zf + 0.045], { seg: 1 }));

	// the chassis: two rails, the axles, crossmembers, the back
	for (const s of [1, -1]) b.add('chassis', span([s * 0.36, 0.8, S.zRA - 0.95], [s * 0.45, 1.08, zf - 0.38]));
	b.add('chassis', rod([-0.95, 0.506, S.zFA], [0.95, 0.506, S.zFA], 0.07, 8));
	b.add('chassis', rod([-0.98, 0.506, S.zRA], [0.98, 0.506, S.zRA], 0.09, 8));
	b.add('chassis', box(0.42, 0.42, 0.38, [0, 0.52, S.zRA], { seg: 1 })); // the differential
	b.add('chassis', rod([0, 0.62, S.zRA + 0.2], [0, 0.78, S.zFA - 0.9], 0.05, 6)); // the propshaft
	b.add('chassis', span([-0.85, 0.82, S.zRA - 1.0], [0.85, 1.05, S.zRA - 0.92])); // the end crossmember
	b.add('chassis', span([-0.55, 0.65, S.zFA - 1.4], [0.55, 1.1, zb + 0.15])); // the engine's sump and gearbox under the cab
	// the fuel tank on the right, batteries and air tanks on the left, the exhaust silencer
	b.add('steel', rod([-0.86, 0.72, S.zRA + 0.72], [-0.86, 0.72, S.zRA + 2.0], 0.3, 12));
	b.add('chassis', span([0.55, 0.45, S.zRA + 0.8], [1.15, 0.95, S.zRA + 1.45]));
	b.add('steel', rod([0.8, 0.6, S.zRA + 1.55], [0.8, 0.6, S.zRA + 2.1], 0.11, 8));
	b.add('steel', rod([0.6, 0.6, zb - 0.1], [0.6, 0.6, S.zRA + 0.75], 0.07, 6));
	// the stack behind the cab, sooted at its tip; the air intake's snorkel on the other side
	b.add('steel', rod([0.98, 1.05, zb - 0.18], [0.98, 3.85, zb - 0.18], 0.065, 10));
	b.add('plastic', rod([-1.02, 1.6, zb - 0.16], [-1.02, 3.45, zb - 0.16], 0.12, 10));
	// the catwalk and the fifth wheel
	b.add('steel', span([-0.62, 1.1, S.zKP + 0.75], [0.62, 1.14, zb - 0.05]));
	b.add('chassis', span([-0.45, 1.05, S.zKP - 0.45], [0.45, S.fifth, S.zKP + 0.45]));
	// mudguards over the twin wheels
	for (const s of [1, -1]) {
		b.add('plastic', span([s * 0.6, 1.1, S.zRA - 0.62], [s * 1.28, 1.15, S.zRA + 0.62]));
		b.add('rubber', span([s * 0.6, 0.28, S.zRA - 0.66], [s * 1.28, 1.1, S.zRA - 0.63]));
	}
	// its own rear lamps on the end crossmember (under the trailer's nose)
	pair(b, 'light:tail', 0.7, 0.98, S.zRA - 1.02, 0.12, 0.08, 0.03);
	pair(b, 'light:brake', 0.55, 0.98, S.zRA - 1.02, 0.12, 0.08, 0.03);

	b.wheel('1-l', [1.025, S.tyreF.D / 2, S.zFA], { ...S.tyreF, rimColour: [0.42, 0.42, 0.4] });
	b.wheel('1-r', [-1.025, S.tyreF.D / 2, S.zFA], { ...S.tyreF, rimColour: [0.42, 0.42, 0.4] });
	b.wheel('2-l', [0.92, S.tyreR.D / 2, S.zRA], { ...S.tyreR, rimColour: [0.42, 0.42, 0.4] });
	b.wheel('2-r', [-0.92, S.tyreR.D / 2, S.zRA], { ...S.tyreR, rimColour: [0.42, 0.42, 0.4] });
	return b;
}

/** the refrigerated trailer: its insulated box, the unit on its front, the underframe, legs, guards, axles and lamps */
function reefer(m, seed) {
	const S = SEMI, H = S.half, y0 = S.floor, y1 = S.roof, zA = S.zTF, zR = S.zTR;
	const b = new Body('trailer', seed, m, { wear: { spray: 0.6 } });

	// the box: one insulated body, its corner posts and rails in aluminium
	b.add('paint2', box(2 * H, y1 - y0, zA - zR, [0, (y0 + y1) / 2, (zA + zR) / 2], { seg: 6 }));
	for (const s of [1, -1]) {
		b.add('steel', span([s * (H - 0.02), y0, zR - 0.01], [s * (H + 0.012), y0 + 0.14, zA + 0.01])); // bottom rail
		b.add('steel', span([s * (H - 0.02), y1 - 0.06, zR - 0.01], [s * (H + 0.012), y1 + 0.005, zA + 0.01])); // top rail
		for (const z of [zR, zA]) b.add('steel', span([s * (H - 0.06), y0, z - 0.04], [s * (H + 0.014), y1, z + 0.04]));
		// amber side markers along the bottom rail
		for (let z = zR + 1.0; z < zA - 0.5; z += 2.9) b.add('lensAmber', box(0.02, 0.05, 0.1, [s * (H + 0.02), y0 + 0.07, z], { seg: 1 }));
		// red and white markers on the front and rear top corners
		b.lamp('light:tail', box(0.06, 0.06, 0.03, [s * (H - 0.08), y1 - 0.08, zR - 0.03], { seg: 1 }));
	}
	// the rear doors: two leaves, their seam, four lock bars, the hinges
	b.add('chassis', box(0.02, y1 - y0 - 0.12, 0.012, [0, (y0 + y1) / 2, zR - 0.006], { seg: 1 }));
	for (const x of [-0.95, -0.35, 0.35, 0.95]) {
		b.add('steel', rod([x, y0 + 0.12, zR - 0.04], [x, y1 - 0.1, zR - 0.04], 0.018, 6));
		for (const y of [y0 + 0.5, y1 - 0.5]) b.add('steel', box(0.07, 0.06, 0.05, [x, y, zR - 0.04], { seg: 1 }));
	}
	for (const s of [1, -1]) for (const y of [y0 + 0.4, (y0 + y1) / 2, y1 - 0.4]) b.add('steel', box(0.08, 0.1, 0.05, [s * (H - 0.04), y, zR - 0.03], { seg: 1 }));
	// the refrigeration unit on the front wall: its housing, the condenser grille and its two fans
	b.add('plastic', box(2.04, 2.0, 0.42, [0, 2.95, zA + 0.21], { seg: 3 }));
	b.add('chassis', box(1.6, 0.75, 0.02, [0, 3.35, zA + 0.425], { seg: 1 }));
	for (const x of [-0.42, 0.42]) b.add('chassis', rod([x, 3.35, zA + 0.42], [x, 3.35, zA + 0.445], 0.3, 14));
	b.add('chassis', box(1.6, 0.5, 0.02, [0, 2.45, zA + 0.425], { seg: 1 }));

	// the underframe: two beams, crossmembers, the kingpin's plate
	for (const s of [1, -1]) b.add('chassis', span([s * 0.42, 0.92, zR + 0.15], [s * 0.52, y0, zA - 0.2]));
	for (let z = zR + 0.6; z < zA - 0.2; z += 1.6) b.add('chassis', span([-1.2, 1.1, z - 0.04], [1.2, y0, z + 0.04]));
	b.add('chassis', span([-1.1, S.fifth, S.zKP - 1.1], [1.1, y0, zA - 0.05]));
	// the landing legs and their crank
	const zL = S.zKP - 1.3;
	for (const s of [1, -1]) {
		b.add('chassis', span([s * 0.78, 0.28, zL - 0.07], [s * 0.92, 1.1, zL + 0.07]));
		b.add('chassis', span([s * 0.74, 0.22, zL - 0.16], [s * 0.96, 0.27, zL + 0.16]));
	}
	b.add('chassis', rod([-0.92, 0.85, zL], [0.92, 0.85, zL], 0.03, 6));
	b.add('steel', span([0.92, 0.8, zL - 0.03], [1.12, 0.84, zL + 0.03]));
	// the reefer's fuel tank under the floor
	b.add('steel', span([-1.15, 0.6, zL - 2.3], [-0.6, 1.1, zL - 1.4]));
	// the axles on their air springs
	for (const z of S.zT) {
		b.add('chassis', rod([-0.98, S.tyreT.D / 2, z], [0.98, S.tyreT.D / 2, z], 0.07, 8));
		for (const s of [1, -1]) {
			b.add('rubber', rod([s * 0.47, 0.62, z - 0.25], [s * 0.47, 0.9, z - 0.25], 0.13, 8));
			b.add('chassis', span([s * 0.42, 0.45, z - 0.45], [s * 0.52, 0.92, z + 0.12]));
		}
	}
	// the side guards between the legs and the wheels, the mudguards over the wheels, the flaps behind them
	const zG0 = S.zT[0] + 0.62, zG1 = zL - 0.25;
	for (const s of [1, -1]) {
		for (const y of [0.5, 0.82]) b.add('steel', span([s * (H - 0.08), y, zG0], [s * (H - 0.02), y + 0.1, zG1]));
		for (let z = zG0 + 0.4; z < zG1; z += 1.5) b.add('chassis', span([s * 0.55, y0 - 0.1, z - 0.03], [s * (H - 0.08), 0.92, z + 0.03]));
		b.add('plastic', span([s * 0.78, 1.15, S.zT[2] - 0.62], [s * (H - 0.03), 1.2, S.zT[0] + 0.62]));
		b.add('rubber', span([s * 0.78, 0.25, S.zT[2] - 0.66], [s * 1.22, 1.15, S.zT[2] - 0.63]));
	}
	// the rear underrun guard and the lamp bar: tail, brake and indicator in each cluster
	b.add('steel', span([-1.15, 0.42, zR + 0.08], [1.15, 0.58, zR + 0.2]));
	for (const s of [1, -1]) b.add('chassis', span([s * 0.6, 0.58, zR + 0.12], [s * 0.66, y0, zR + 0.18]));
	b.add('chassis', span([-1.25, 0.88, zR + 0.0], [1.25, 1.12, zR + 0.12]));
	pair(b, 'light:tail', 0.78, 1.0, zR - 0.005, 0.15, 0.13, 0.02);
	pair(b, 'light:brake', 0.94, 1.0, zR - 0.005, 0.15, 0.13, 0.02);
	b.lamp('light:indicator-l', box(0.15, 0.13, 0.02, [1.1, 1.0, zR - 0.005], { seg: 1 }));
	b.lamp('light:indicator-r', box(0.15, 0.13, 0.02, [-1.1, 1.0, zR - 0.005], { seg: 1 }));
	b.add('lensRed', box(0.5, 0.06, 0.012, [0.6, 0.45, zR + 0.075], { seg: 1 })); // reflectors on the guard
	b.add('lensRed', box(0.5, 0.06, 0.012, [-0.6, 0.45, zR + 0.075], { seg: 1 }));

	for (const [i, z] of S.zT.entries()) {
		b.wheel(`${i + 3}-l`, [1.02, S.tyreT.D / 2, z], { ...S.tyreT, rimColour: [0.5, 0.5, 0.48] });
		b.wheel(`${i + 3}-r`, [-1.02, S.tyreT.D / 2, z], { ...S.tyreT, rimColour: [0.5, 0.5, 0.48] });
	}
	return b;
}

