	lamp(name, geo) {
		const g = geo.index ? geo.toNonIndexed() : geo;
		for (const k of Object.keys(g.attributes)) if (!['position', 'normal'].includes(k)) g.deleteAttribute(k);
		if (!this.lights.has(name)) this.lights.set(name, []);
		this.lights.get(name).push(g);
		return this;
