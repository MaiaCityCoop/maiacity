	if (variant) throw new Error(`no asset things/${id}@${v}:${variant} in this file`);
	return {
		meta: { group: 'things', id, version: v, label: 'W-beam guardrail', note: NOTE, params: JSON.parse(JSON.stringify(PARAMS)), world: { segment: WB.length, axis: 'x', faces: '+z', posts: WB.post.at } },
		build,
	};
};
