			cap.setAttribute('position', new THREE.Float32BufferAttribute(p, 3));
			cap.setAttribute('normal', new THREE.Float32BufferAttribute(nn, 3));
			cap.setAttribute('uv', new THREE.Float32BufferAttribute(u, 2));
