const box = (w, h, d, at, rot) => place(new THREE.BoxGeometry(w, h, d), at, rot);
/** an upright cylinder (radius at its top and foot, height), its foot at `at`; `open` without its end caps */
function cyl(rTop, rFoot, h, seg, at = [0, 0, 0], rot, open = false) {
	const g = new THREE.CylinderGeometry(rTop, rFoot, h, seg, 1, open);
	g.translate(0, h / 2, 0);
