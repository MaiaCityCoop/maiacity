const disc = (r, seg, at, rot) => place(new THREE.CircleGeometry(r, seg), at, rot);
/** a flat rectangle w × h facing +z, its middle at `at`; its uv 0..1 */
const plate = (w, h, at, rot) => place(new THREE.PlaneGeometry(w, h), at, rot);

/**
 * A profile swept straight along x from x0 to x1: `profile` its points [z, y] in order round it (a point given twice is
 * a sharp corner), closed; with its two end faces when `caps`; cut every `step` metres along x (so the grime, painted
 * on its points, can vary along it). UVs in metres (u along x, v round the profile).
 */
function sweepX(profile, x0, x1, caps = true, step = 0) {
	const n = profile.length;
	const at = [0];
	for (let i = 1; i <= n; i++) {
		const [z0, y0] = profile[i - 1], [z1, y1] = profile[i % n];
		at.push(at[i - 1] + Math.hypot(z1 - z0, y1 - y0));
	}
	const cuts = step > 0 ? Math.max(1, Math.round((x1 - x0) / step)) : 1;
	const parts = [];
	for (let c = 0; c < cuts; c++) parts.push(smoothedAlong(profile, x0 + ((x1 - x0) * c) / cuts, x0 + ((x1 - x0) * (c + 1)) / cuts, at, x0));
	if (caps) {
		// the end faces: the profile without its doubled corners, each triangle turned to face out
		const ring = profile.filter((p, i) => i === 0 || Math.hypot(p[0] - profile[i - 1][0], p[1] - profile[i - 1][1]) > 1e-9);
		const tris = THREE.ShapeUtils.triangulateShape(ring.map(([z, y]) => new THREE.Vector2(z, y)), []);
		for (const [x, s] of [[x0, -1], [x1, 1]]) {
			const p = [], u = [], nn = [];
			for (const t of tris) {
				const [a, b, c] = t.map((k) => ring[k]);
				// the triangle's turn in (z, y): seen from +x, counter-clockwise faces +x
				const turn = (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0]);
				// seen from +x, z runs to the left: a counter-clockwise turn in (z, y) faces -x
				const order = (turn < 0) === s > 0 ? [a, b, c] : [a, c, b];
				for (const [z, y] of order) p.push(x, y, z), u.push(z, y), nn.push(s, 0, 0);
			}
