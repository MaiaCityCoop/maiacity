/** the sweep's sides with normals smoothed round the profile except where a point is given twice */
function smoothedAlong(profile, x0, x1, at, u0 = x0) {
	const n = profile.length;
	const same = (a, b) => Math.abs(a[0] - b[0]) < 1e-9 && Math.abs(a[1] - b[1]) < 1e-9;
	// each edge's outward normal in (z, y)
	const edgeN = [];
	for (let i = 0; i < n; i++) {
		const [z0, y0] = profile[i], [z1, y1] = profile[(i + 1) % n];
		const l = Math.hypot(z1 - z0, y1 - y0) || 1;
		edgeN.push([(y1 - y0) / l, -(z1 - z0) / l]);
