	galvanised: { roughness: 0.7, metalness: 0.45 }, // weathered zinc: dull, little mirror left
	paint: { roughness: 0.62, metalness: 0.15 },
	plastic: { roughness: 0.5, metalness: 0 },
	rubber: { roughness: 0.9, metalness: 0 },
	glass: { roughness: 0.25, metalness: 0 },
