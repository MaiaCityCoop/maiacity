const WB_C = { zinc: '#9ea19c', post: '#8f928d', bolt: '#7d7a72', rust: [0.62, 0.42, 0.3] };

/** the W's line: its front at height y (from the rail's middle), z out toward the traffic from the valley at 0 */
const wLine = (y) => (WB.crest / 2) * (1 - Math.cos((2 * Math.PI * y) / (WB.depth * 0.513)));

/** the rail's section, [z, y] counter-clockwise: its front face up, its back face down, the edges sharp */
function wProfile() {
	const n = 14, half = WB.depth / 2;
	const front = [], back = [];
	for (let i = 0; i <= n; i++) {
		const y = -half + (WB.depth * i) / n;
		// the edges bend back a little toward the posts
		const lip = smooth(half - 0.02, half, Math.abs(y)) * 0.012;
		front.push([wLine(y) - lip + WB.t, y]);
		back.push([wLine(y) - lip, y]);
	}
	// counter-clockwise in (z, y): up the front (larger z), then down the back; its four corners sharp
	return [front[0], ...front, front[n], back[n], ...back.slice().reverse(), back[0]];
}

/** zinc gone patchy: white rust and dull blotches, rust bleeding below the bolts, by the seed */
function weathering(seed, bolts) {
	const o = chance(seed, 'zinc')() * 50;
	return (x, y, z) => {
		const patch = fbm(x * 2.2 + o, y * 9, z * 2) - 0.5;
		let m = 1 + patch * 0.35;
		for (const [bx, by] of bolts) {
			const below = smooth(0.18, 0, by - y) * smooth(0.0, 0.02, by - y + 0.02);
			m *= 1 - 0.3 * below * smooth(0.05, 0, Math.abs(x - bx));
		}
		return m;
	};
}

function guardrail(bag, seed) {
	const yMid = WB.top - WB.depth / 2;
	const postZ = -WB.spacer.d; // the posts' face toward the rail
	const bolts = [];
	for (const px of WB.post.at) bolts.push([px, yMid]);
	for (const s of [-1, 1]) for (const dx of [0.05, 0.13]) for (const dy of [-0.06, 0.06]) bolts.push([s * (WB.length / 2 - dx), yMid + dy]);
	// the rail, cut every 0.25 m so its weathering varies along it
	const rail = sweepX(wProfile(), -WB.length / 2, WB.length / 2, false, 0.25); // its 2.67 mm ends open: the next segment's rail meets them
	rail.translate(0, yMid, 0);
	bag.add('rail', 'galvanised', rail, WB_C.zinc, 0.55, weathering(seed, bolts));
	// the posts: a C, its web toward the rail, its flanges back; and the spacer block (a short C) in front of it
	const P = WB.post, S = WB.spacer;
	for (const px of P.at) {
		const zw = postZ - P.t / 2;
		bag.add('posts', 'galvanised', box(P.w, P.h, P.t, [px, P.h / 2, zw]), WB_C.post, 0.7);
		for (const s of [-1, 1]) bag.add('posts', 'galvanised', box(P.t, P.h, P.d, [px + s * (P.w / 2 - P.t / 2), P.h / 2, postZ - P.d / 2]), WB_C.post, 0.7);
		const ys = yMid;
		bag.add('posts', 'galvanised', box(S.w * 0.8, S.h, P.t, [px, ys, -P.t / 2 - 0.004]), WB_C.post, 0.6); // its face plate on the rail's valley
		for (const s of [-1, 1]) bag.add('posts', 'galvanised', box(P.t, S.h, S.d, [px + s * (S.w * 0.4), ys, -S.d / 2]), WB_C.post, 0.6);
	}
	// bolt heads: one through each post, four each side of each splice (the next segment's meet them)
	for (const [bx, by] of bolts) {
		const z = wLine(by - yMid) + WB.t;
		bag.add('bolts', 'galvanised', cyl(0.012, 0.015, 0.008, 8, [bx, by, z], [Math.PI / 2, 0, 0]), WB_C.bolt, 0.9);
	}
}

/* ------------------------------------------------------------------------------------------------------------
 * PART 3 · THE RECIPE
 * ------------------------------------------------------------------------------------------------------------ */

const PARAMS = [{ id: 'seed', label: 'Seed', type: 'string', value: 'maia', maxLength: 40 }];
const NOTE =
	'One segment of a steel W-beam safety fence: a galvanised W-beam rail 310 mm deep, 83 mm from valley to crest, of 2.67 mm steel (EN 1317 A-profile, AASHTO M180), bolted through 150 mm spacer blocks to C posts (Sigma 100) every 2 m, its top 750 mm over the road. ' +
	'It lies along x with the traffic on +z, and TILES END TO END AT EXACTLY 4.000 m: the rail runs x ±2.000, the posts stand at x ±1.000 (so one every 2 m along a run), the splice bolts at each end meet the next segment\'s. ' +
	'Zinc gone dull and patchy with white rust, rust bleeding below the bolts, road grime low, by its seed.';

function build(seed) {
	const bag = new Bag(`${seed ?? 'maia'}`, 0.55);
	guardrail(bag, `${seed ?? 'maia'}`);
	const root = bag.build('guardrail');
	root.userData.segment = { length: WB.length, axis: 'x', from: -WB.length / 2, to: WB.length / 2, posts: WB.post.at };
	return root;
}

