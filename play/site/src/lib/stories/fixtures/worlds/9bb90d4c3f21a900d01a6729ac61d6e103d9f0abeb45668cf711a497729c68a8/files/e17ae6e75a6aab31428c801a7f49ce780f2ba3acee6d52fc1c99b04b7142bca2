/**
 * A piece placed: moved to `at` and turned by `rot` (radians about x, y, z, in that order).
 * @param {THREE.BufferGeometry} g @param {number[]} [at] @param {number[]} [rot]
 */
function place(g, at = [0, 0, 0], rot) {
