/**
 * Everything a thing is built of, by part and by material: each piece painted with its colour (weathered), then each
 * part's pieces merged per material into one mesh. A part of one material is one mesh, named as the part.
 */
class Bag {
	constructor(seed = 'maia', dirt = 0.6) {
		this.parts = new Map();
		this.seed = chance(seed, 'grime')();
		this.dirt = dirt;
	}
	/**
	 * Add a piece to a part, of a material, in a colour; `dirt` overrides the thing's own for this piece; `tint(x, y, z)`
	 * multiplies its colour at each point (a thing's own stains: tyre scuffs, rust, fading).
	 */
	add(part, material, geo, color, dirt, tint) {
		const g = geo.index ? geo.toNonIndexed() : geo;
		if (geo.index) geo.dispose();
		if (!g.getAttribute('normal')) g.computeVertexNormals();
		if (!g.getAttribute('uv')) g.setAttribute('uv', new THREE.Float32BufferAttribute(new Float32Array(g.getAttribute('position').count * 2), 2));
		const base = new THREE.Color(color);
		const p = g.getAttribute('position');
		const cols = new Float32Array(p.count * 3);
		const d = dirt ?? this.dirt;
		for (let i = 0; i < p.count; i++) {
			const c = grimed(base, p.getX(i), p.getY(i), p.getZ(i), d, this.seed);
			if (tint) c.multiplyScalar(tint(p.getX(i), p.getY(i), p.getZ(i)));
			cols.set([c.r, c.g, c.b], i * 3);
		}
		g.setAttribute('color', new THREE.Float32BufferAttribute(cols, 3));
		for (const k of Object.keys(g.attributes)) if (!['position', 'normal', 'uv', 'color'].includes(k)) g.deleteAttribute(k);
		if (!this.parts.has(part)) this.parts.set(part, new Map());
		const byMat = this.parts.get(part);
		if (!byMat.has(material)) byMat.set(material, []);
		byMat.get(material).push(g);
		return this;
	}
	/**
	 * The thing: a group named `name`, a child per part. A part keyed `group/part` goes into a group of that name (a
	 * signal's `head:1/lamp:red`), so a name the page drives (`lamp:red`) can stand once in each head. `special` makes
	 * a part's own material (a lens, a sign face), by the part's key or by the material's name.
	 */
	build(name, special = {}) {
		const root = new THREE.Group();
		root.name = name;
		const shared = new Map();
		const look = (m) => {
			if (!shared.has(m)) shared.set(m, new THREE.MeshStandardMaterial({ vertexColors: true, ...(LOOKS[m] ?? LOOKS.paint), name: m }));
			return shared.get(m);
		};
		const groups = new Map();
		const into = (key) => {
			const at = key.lastIndexOf('/');
			if (at < 0) return root;
			const gname = key.slice(0, at);
			if (!groups.has(gname)) {
				const g = new THREE.Group();
				g.name = gname;
				root.add(g);
				groups.set(gname, g);
			}
			return groups.get(gname);
		};
		for (const [key, byMat] of this.parts) {
			const part = key.slice(key.lastIndexOf('/') + 1);
			const meshes = [];
			for (const [m, list] of byMat) {
				const geo = list.length === 1 ? list[0] : mergeGeometries(list);
				if (list.length > 1) for (const g of list) g.dispose();
				const mat = special[key]?.(m) ?? special[part]?.(m) ?? special[m]?.(m) ?? look(m);
				const mesh = new THREE.Mesh(geo, mat);
				mesh.castShadow = mesh.receiveShadow = true;
				mesh.name = byMat.size === 1 ? part : `${part}/${m}`;
				meshes.push(mesh);
			}
			const parent = into(key);
			if (meshes.length === 1) parent.add(meshes[0]);
			else {
				const g = new THREE.Group();
				g.name = part;
				for (const m of meshes) g.add(m);
				parent.add(g);
			}
		}
		return root;
	}
}

/** how many triangles a built thing has */
function trianglesOf(o) {
	let n = 0;
	o.traverse((m) => {
		if (m.isMesh) n += (m.geometry.index ? m.geometry.index.count : m.geometry.getAttribute('position').count) / 3;
	});
	return Math.round(n);
}

/*
 * ============================================================================================================
 * PART 2 · THE GUARDRAIL — one segment of a steel W-beam safety fence: a galvanised W-beam rail (310 mm deep,
 * 83 mm from valley to crest, 2.67 mm steel; EN 1317 "A-profile" / AASHTO M180) bolted through spacer blocks to C
 * posts every 2 m, its top 750 mm over the road. It lies along x, the traffic on +z, and tiles end to end at exactly
 * 4.000 m: the rail runs x ±2.000, the posts stand at x ±1.000 (so every 2 m along a run), the splice bolts at each
 * end meet the next segment's. Zinc gone dull and patchy, white rust, rust bleeding from the bolts, road grime low.
 * ============================================================================================================
 */

/** the measures, in metres */
const WB = {
	length: 4.0, // the pitch it tiles at (EU rails 4 m between splices; AASHTO 12 ft 6 in = 3.81 m)
	depth: 0.31, // the rail's height (across its W)
	crest: 0.083, // from its valley to its crests
	t: 0.00267, // its steel
	top: 0.75, // its top over the road
	post: { at: [-1.0, 1.0], w: 0.1, d: 0.055, t: 0.004, h: 0.72 }, // C posts (Sigma 100), 2 m apart, 720 mm out of the ground
	spacer: { d: 0.15, h: 0.31, w: 0.1 }, // the spacer block between rail and post
