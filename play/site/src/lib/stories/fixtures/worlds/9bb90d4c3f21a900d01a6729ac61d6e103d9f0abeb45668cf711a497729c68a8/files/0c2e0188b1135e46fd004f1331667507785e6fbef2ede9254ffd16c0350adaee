		// the section, inside to outside: bead, sidewall bulge, shoulder, tread, shoulder, sidewall, bead
		const h = R - r, w = W / 2;
		const pts = [
			[r + 0.01, -w * 0.82], [r + h * 0.45, -w], [R - h * 0.12, -w * 0.94], [R, -w * 0.72],
			[R, w * 0.72], [R - h * 0.12, w * 0.94], [r + h * 0.45, w], [r + 0.01, w * 0.82],
		].map(([a, b]) => new THREE.Vector2(a, b + x0));
