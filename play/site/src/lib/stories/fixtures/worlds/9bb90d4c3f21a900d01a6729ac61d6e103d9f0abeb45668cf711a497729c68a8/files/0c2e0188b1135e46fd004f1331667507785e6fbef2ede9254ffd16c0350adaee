	carry(body, origin) {
		this.bodies.push({ body, origin });
		return this;
	}
	/** the group, pivoting at `origin` (vehicle coordinates); `parent` the origin of the body it hangs on */
	build(origin = [0, 0, 0], parent = [0, 0, 0]) {
		const grp = new THREE.Group();
		grp.name = this.name;
		grp.position.set(origin[0] - parent[0], origin[1] - parent[1], origin[2] - parent[2]);
		const local = (g) => g.translate(-origin[0], -origin[1], -origin[2]);
		for (const [mat, list] of this.parts) {
			const mesh = new THREE.Mesh(local(mergeGeometries(list)), this.mats[mat]);
			mesh.name = `${this.name}:${mat}`;
			mesh.castShadow = true;
			mesh.receiveShadow = true;
			grp.add(mesh);
		}
		for (const [name, list] of this.lights) {
			const mesh = new THREE.Mesh(local(mergeGeometries(list)), (this.mats.lamps[name] ??= lampMaterial(name)));
			mesh.name = name;
			grp.add(mesh);
		}
		this.wheels.forEach((w, i) => {
			const pivot = new THREE.Group();
			pivot.name = `wheel:${w.id}`;
			pivot.position.set(w.at[0] - origin[0], w.at[1] - origin[1], w.at[2] - origin[2]);
			pivot.userData.radius = w.spec.D / 2;
			const mesh = new THREE.Mesh(wheelGeometry({ ...w.spec, out: Math.sign(w.at[0]) || 1, s: i }), this.mats.body);
			mesh.name = `wheel:${w.id}:tyre`;
			mesh.castShadow = true;
			pivot.add(mesh);
			grp.add(pivot);
		});
		for (const b of this.bodies) grp.add(b.body.build(b.origin, origin));
		return grp;
	}
}

/** both lamps of a pair at once: a box of w × h × d at [±x, y, z] */
function pair(body, name, x, y, z, w, h, d) {
	body.lamp(name, box(w, h, d, [x, y, z], { seg: 1 }));
	body.lamp(name, box(w, h, d, [-x, y, z], { seg: 1 }));
}

/** triangles of an object, for the budget */
function trianglesOf(root) {
	let n = 0;
	root.traverse((o) => {
		if (o.isMesh) n += (o.geometry.index ? o.geometry.index.count : o.geometry.attributes.position.count) / 3;
	});
	return Math.round(n);
}

/**
 * A cab-over-engine cab, as European lorries have them: its side profile pushed across, a face raked back about 5°,
 * the windscreen in its rubber, a sun visor, the grille and its slats, side windows, door seams and handles, mirrors
 * on two arms, steps behind the front wheel, its mudguard, the bumper with headlights and indicators in its corners,
 * side repeaters and roof markers. All of it in `b` (a Body), its face at z = zf.
 *   o: { zf, depth, half (half its width), bottom, glass: [y0, y1], roof, deflector (its top, or 0), zFA, wheelR, bumper (its top) }
