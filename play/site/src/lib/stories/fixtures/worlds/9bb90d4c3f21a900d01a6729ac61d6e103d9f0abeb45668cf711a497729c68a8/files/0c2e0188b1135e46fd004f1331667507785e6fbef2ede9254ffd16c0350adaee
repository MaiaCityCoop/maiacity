/**
 * Wear by where a vertex is (vehicle coordinates, before any articulation is taken out): road spray dark and brown up
 * to about 1.4 m, heaviest on what faces back or down; dust on what faces up; a slow patchiness of fade; diesel soot
 * where `soot` says (a stack's tip, an exhaust's lip).
 */
function wearAt(p, n, seed, o = {}) {
	const s = o.s ?? 0;
	// the wheels throw it up to about 1.9 m on the sides; the back, in the wake's swirl, is dirty to well over 2.5 m
	const back = clamp(-n.z * 1.6 - 0.6);
