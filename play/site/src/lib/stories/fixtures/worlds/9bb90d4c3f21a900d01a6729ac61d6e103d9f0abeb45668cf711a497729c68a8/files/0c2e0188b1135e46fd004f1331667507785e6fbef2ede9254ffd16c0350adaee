	parts.push([disc(dual ? out * (W + gap) / 2 : 0), rimColour]);
	// the lugs: two rows of bars across the tread, each leaning 25° from the axis, the rows half a pitch apart (a chevron)
	for (const x0 of xs)
		for (let i = 0; i < lugs; i++)
			for (const side of [-1, 1]) parts.push([lugGeometry(R + lug * 0.3, lug, W, x0, side, ((i + (side > 0 ? 0.5 : 0)) / lugs) * Math.PI * 2), [0.075, 0.072, 0.07]]);
