	'light:tail': { lens: '#6e1510', glow: '#ff2414', on: 0 },
	'light:brake': { lens: '#7d1612', glow: '#ff1a0e', on: 0 },
	'light:indicator-l': { lens: '#b9741a', glow: '#ff9a10', on: 0 },
