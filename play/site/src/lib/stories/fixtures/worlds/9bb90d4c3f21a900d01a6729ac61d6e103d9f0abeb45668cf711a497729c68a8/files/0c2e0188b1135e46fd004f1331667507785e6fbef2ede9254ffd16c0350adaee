	if (o.deflector) b.add('paint', profile([[zf - 0.6, roof - 0.02], [zf - 1.2, roof + 0.6 * (o.deflector - roof)], [zb + 0.06, o.deflector], [zb + 0.06, roof - 0.02]], -(W - 0.13), W - 0.13, 0.02));
	const gm = (g0 + g1) / 2, gh = g1 - g0;
	b.add('rubber', box(2 * W - 0.19, gh + 0.08, 0.02, [0, gm, zAt(gm) + 0.006], { rx: rake, seg: 1 }));
	b.add('glass', box(2 * W - 0.29, gh, 0.02, [0, gm, zAt(gm) + 0.014], { rx: rake, seg: 1 }));
	b.add('plastic', box(2 * W - 0.15, 0.05, 0.26, [0, g1 + 0.1, zAt(g1 + 0.1) + 0.04], { rx: 0.25, seg: 1 }));
	// the grille between the bumper and the glass
	const gr0 = o.bumper + 0.12, gr1 = g0 - 0.2;
	b.add('plastic', box(2 * W - 0.55, gr1 - gr0, 0.03, [0, (gr0 + gr1) / 2, zf], { seg: 1 }));
	const n = Math.max(2, Math.round((gr1 - gr0) / 0.14));
	for (let i = 0; i < n; i++) b.add('chassis', box(2 * W - 0.65, 0.05, 0.03, [0, gr0 + 0.08 + (i * (gr1 - gr0 - 0.16)) / (n - 1), zf + 0.018], { seg: 1 }));
	for (const s of [1, -1]) {
		const wz = Math.min(0.9, depth - 0.75);
		b.add('glass', box(0.02, gh * 0.75, wz, [s * (W + 0.002), gm + 0.04, zf - 0.23 - wz / 2], { seg: 1 }));
		b.add('chassis', box(0.012, roof - bottom - 0.4, 0.012, [s * (W + 0.004), (roof + bottom) / 2 - 0.1, zf - 1.2], { seg: 1 }));
		b.add('plastic', box(0.03, 0.04, 0.2, [s * (W + 0.01), g0 + 0.05, zf - 1.05], { seg: 1 }));
		// mirrors on their arms
		b.add('steel', rod([s * W, g1 + 0.07, zf - 0.22], [s * (W + 0.18), g1 + 0.07, zf - 0.08], 0.018, 6));
		b.add('steel', rod([s * W, g0 + 0.3, zf - 0.22], [s * (W + 0.18), g0 + 0.3, zf - 0.08], 0.018, 6));
		b.add('plastic', box(0.07, 0.52, 0.24, [s * (W + 0.2), g1 - 0.28, zf - 0.08], { seg: 1 }));
		// the steps behind the front wheel and the arch's mudguard
		const zw = zFA - wheelR - 0.03;
		b.add('plastic', span([s * (W - 0.24), 0.42, zb + 0.03], [s * (W - 0.04), 0.47, Math.min(zw, zb + 0.3)]));
		b.add('plastic', span([s * (W - 0.24), 0.78, zb + 0.03], [s * (W - 0.04), 0.83, Math.min(zw, zb + 0.3)]));
		b.add('rubber', span([s * (W - 0.4), 0.2, zw - 0.03], [s * W, bottom - 0.1, zw]));
		b.add('plastic', span([s * (W - 0.42), bottom - 0.12, zw], [s * W, bottom + 0.01, zFA + wheelR * 0.75]));
		b.lamp(s > 0 ? 'light:indicator-l' : 'light:indicator-r', box(0.02, 0.05, 0.1, [s * (W + 0.01), bottom + 0.16, zf - 0.55], { seg: 1 }));
		b.add('lensAmber', box(0.08, 0.04, 0.05, [s * (W - 0.3), roof + 0.01, zf - 0.6], { seg: 1 }));
	}
	// the bumper, its headlights and indicators in its top corners, the air dam under it
	const bt = o.bumper;
	b.add('plastic', span([-(W - 0.01), 0.42, zf - 0.4], [W - 0.01, bt, zf + 0.04]));
	b.add('chassis', span([-(W - 0.35), 0.3, zf - 0.35], [W - 0.35, 0.42, zf - 0.05]));
	pair(b, 'light:head', W - 0.42, bt - 0.16, zf + 0.045, 0.4, 0.16, 0.02);
	b.lamp('light:indicator-l', box(0.13, 0.13, 0.02, [W - 0.12, bt - 0.16, zf + 0.045], { seg: 1 }));
	b.lamp('light:indicator-r', box(0.13, 0.13, 0.02, [-(W - 0.12), bt - 0.16, zf + 0.045], { seg: 1 }));
	return zb;
}

/* ============================================================================================================
 * PART 2 · THE CITY BUS — a worn 12 m two-axle low-floor city bus, three double doors on its right, its engine in its
 * back: the old city's packed bus, its two-tone livery chalked by the sun, black with road film up to its windows.
 *
 * Measures (EU 96/53/EC and the trade's data of 12 m low-floor buses; metres):
 *   12.00 long, 2.55 wide (2.99 over the mirrors hung from the roof), 2.95 to the roof and 3.20 over the air
 *   conditioning; front overhang 2.70, wheelbase 5.90, rear overhang 3.40; floor 0.34 at the doors, the body's skirt
 *   0.28 up; three double doors 1.20 wide on the right (ahead of the front axle, between the axles, behind the rear
 *   axle); windows from 1.10 to 2.45; tyres 275/70 R22.5 (0.96 across), twin at the rear.
 *   Masses: about 11.5 t empty, 18 t laden; 30 seated, about 100 in all.
 * ============================================================================================================ */

const BUS = {
	L: 12.0, FO: 2.7, WB: 5.9, half: 1.275, roof: 2.95, skirt: 0.28,
	win: [1.1, 2.45],
	tyre: { D: 0.956, W: 0.275, rim: 0.5715 },
};
BUS.zF = BUS.L / 2;
BUS.zR = -BUS.L / 2;
BUS.zFA = BUS.zF - BUS.FO;
BUS.zRA = BUS.zFA - BUS.WB;
BUS.arch = BUS.tyre.D / 2 + 0.08; // the wheel arches' radius
// the doors on the right side (−x), each [z0, z1]
BUS.doors = [[BUS.zFA + BUS.arch + 0.35, BUS.zFA + BUS.arch + 1.55], [-0.75, 0.45], [BUS.zRA - BUS.arch - 1.3, BUS.zRA - BUS.arch - 0.1]];

/** the side profile [z, y] round the body, front to back over the roof, the arches cut out of its bottom */
function busProfile() {
	const B = BUS, r = B.arch, y0 = B.skirt;
	const archAt = (zc) => {
		const pts = [];
		for (let i = 0; i <= 8; i++) {
			const a = (Math.PI * i) / 8; // front of the arch to its back, over its top
			pts.push([zc + r * Math.cos(a), B.tyre.D / 2 + r * Math.sin(a)]);
		}
		return pts;
	};
	const bottom = [[B.zF - 0.05, y0], ...archAt(B.zFA), ...archAt(B.zRA), [B.zR + 0.08, y0]];
	return [
		[B.zR, y0 + 0.12], [B.zR, B.roof - 0.15], [B.zR + 0.15, B.roof], [B.zF - 0.22, B.roof], [B.zF - 0.04, B.roof - 0.18],
		[B.zF, 0.9], [B.zF - 0.02, y0 + 0.08],
		...bottom,
	];
}

function bus(m, seed) {
	const B = BUS, W = B.half, zF = B.zF, zR = B.zR, R = B.tyre.D / 2;
	const [w0, w1] = B.win;
	const b = new Body('bus', seed, m, {
		wear: { spray: 0.65, soot: (p) => smooth(-5.6, -6.0, p.z) * smooth(1.2, 0.3, p.y) * smooth(0.7, 0.2, Math.abs(p.x + 0.8)) },
	});

	// the body: its profile pushed across, the wheelhouses inside the arches
	b.add('paint', profile(busProfile(), -W, W, 0.035));
	for (const zc of [B.zFA, B.zRA]) b.add('chassis', span([-W + 0.04, R - 0.1, zc - B.arch], [W - 0.04, R + B.arch - 0.02, zc + B.arch]));

	// what stands out of each side: the window band, pillars, the skirt's livery band, doors
	const side = (s) => {
		const x = s * (W + 0.004);
		const doors = s < 0 ? B.doors : [];
		const inDoor = (z) => doors.some(([a, c]) => z > a - 0.05 && z < c + 0.05);
		// the windows from behind the driver to the back, cut where a door is, a pillar every 1.3 m
		const zs = [zR + 0.5, ...doors.flatMap(([a, c]) => [a - 0.04, c + 0.04]), zF - 0.55].sort((p, q) => p - q);
		for (let i = 0; i + 1 < zs.length; i += 2) {
			const [a, c] = [zs[i], zs[i + 1]];
			if (c - a < 0.2) continue;
			b.add('glass', box(0.02, w1 - w0, c - a, [x, (w0 + w1) / 2, (a + c) / 2], { seg: 1 }));
			for (let z = a + 1.3; z < c - 0.3; z += 1.3) b.add('chassis', box(0.024, w1 - w0, 0.08, [x, (w0 + w1) / 2, z], { seg: 1 }));
		}
		// the livery band along the skirt, broken at the arches and doors
		const cuts = [[B.zFA - B.arch, B.zFA + B.arch], [B.zRA - B.arch, B.zRA + B.arch], ...doors];
		const edges = [zR + 0.04, ...cuts.flat(), zF - 0.08].sort((p, q) => p - q);
		for (let i = 0; i + 1 < edges.length; i += 2) {
			const [a, c] = [edges[i] + 0.02, edges[i + 1] - 0.02];
			if (c - a > 0.1) b.add('paint2', box(0.012, 0.62, c - a, [s * (W + 0.006), B.skirt + 0.31 + 0.02, (a + c) / 2], { seg: 2 }));
		}
		// a band under the windows of the second colour
		b.add('paint2', box(0.012, 0.1, zF - zR - 0.6, [s * (W + 0.006), w0 - 0.12, (zF + zR) / 2 + 0.05], { seg: 1 }));
		// the doors: two glass leaves in their black frames, a seam between them
		for (const [a, c] of doors) {
			b.add('rubber', box(0.024, 2.3, c - a, [x, 0.34 + 1.15, (a + c) / 2], { seg: 1 }));
			b.add('glass', box(0.03, 1.9, (c - a) / 2 - 0.1, [x, 0.34 + 1.2, a + (c - a) / 4], { seg: 1 }));
			b.add('glass', box(0.03, 1.9, (c - a) / 2 - 0.1, [x, 0.34 + 1.2, c - (c - a) / 4], { seg: 1 }));
		}
		// the driver's window on the left, the amber side markers, the repeaters
		if (s > 0) b.add('glass', box(0.02, w1 - w0 + 0.1, 0.8, [x, (w0 + w1) / 2 + 0.05, zF - 0.95], { seg: 1 }));
		for (let z = zR + 1.0; z < zF - 1; z += 2.6) if (!inDoor(z)) b.add('lensAmber', box(0.02, 0.04, 0.08, [s * (W + 0.012), 0.45, z], { seg: 1 }));
		b.lamp(s > 0 ? 'light:indicator-l' : 'light:indicator-r', box(0.02, 0.06, 0.12, [s * (W + 0.01), 0.75, B.zFA + B.arch + 0.15], { seg: 1 }));
		// the mirror hung forward from the roof's corner on its arm
		b.add('steel', rod([s * (W - 0.1), B.roof - 0.1, zF - 0.15], [s * (W + 0.02), B.roof - 0.25, zF + 0.32], 0.02, 6));
		b.add('steel', rod([s * (W + 0.02), B.roof - 0.25, zF + 0.32], [s * (W + 0.1), 2.25, zF + 0.32], 0.02, 6));
		b.add('plastic', box(0.24, 0.42, 0.06, [s * (W + 0.1), 2.05, zF + 0.32], { seg: 1 }));
	};
	side(1), side(-1);

	// the face: the big windscreen, the destination display over it, the grille, the bumper, the lamps in its corners
	b.add('rubber', box(2 * W - 0.1, 1.85, 0.02, [0, 1.88, zF - 0.02 + 0.012], { seg: 1 }));
	b.add('glass', box(2 * W - 0.2, 1.6, 0.02, [0, 1.8, zF - 0.02 + 0.022], { seg: 1 }));
	b.add('chassis', box(2 * W - 0.4, 0.22, 0.02, [0, 2.75, zF - 0.03 + 0.024], { seg: 1 }));
	b.add('lensAmber', box(1.2, 0.12, 0.012, [0.2, 2.75, zF - 0.03 + 0.036], { seg: 1 })); // the destination, faded
	b.add('chassis', box(0.8, 0.04, 0.4, [-0.4, 1.0, zF - 0.1], { seg: 1 })); // the wiper's arm, parked
	b.add('plastic', span([-W + 0.02, B.skirt + 0.02, zF - 0.1], [W - 0.02, 0.62, zF + 0.05]));
	b.add('plastic', box(1.1, 0.2, 0.02, [0, 0.78, zF + 0.002], { seg: 1 }));
	pair(b, 'light:head', W - 0.32, 0.78, zF + 0.002, 0.42, 0.16, 0.025);
	b.lamp('light:indicator-l', box(0.13, 0.12, 0.025, [W - 0.06, 0.78, zF - 0.003], { seg: 1 }));
	b.lamp('light:indicator-r', box(0.13, 0.12, 0.025, [-(W - 0.06), 0.78, zF - 0.003], { seg: 1 }));
	for (const s of [1, -1]) b.add('lensAmber', box(0.06, 0.04, 0.03, [s * (W - 0.15), B.roof - 0.06, zF - 0.02], { seg: 1 }));

	// the back: the engine's grille and its lid, the small rear window, the lamp clusters up its corners, the bumper
	b.add('glass', box(2 * W - 0.5, 0.6, 0.02, [0, 2.3, zR - 0.012], { seg: 1 }));
	b.add('chassis', box(2 * W - 0.6, 0.5, 0.02, [0, 1.3, zR - 0.012], { seg: 1 }));
	for (let i = 0; i < 5; i++) b.add('plastic', box(2 * W - 0.7, 0.03, 0.02, [0, 1.1 + i * 0.1, zR - 0.024], { seg: 1 }));
	b.add('plastic', span([-W + 0.02, B.skirt + 0.02, zR - 0.06], [W - 0.02, 0.62, zR + 0.1]));
	b.add('chassis', box(1.2, 0.1, 0.02, [0, 1.75, zR - 0.012], { seg: 1 }));
	for (const s of [1, -1]) {
		b.lamp('light:tail', box(0.14, 0.3, 0.02, [s * (W - 0.12), 1.15, zR - 0.012], { seg: 1 }));
		b.lamp('light:brake', box(0.14, 0.18, 0.02, [s * (W - 0.12), 0.88, zR - 0.012], { seg: 1 }));
		b.lamp(s > 0 ? 'light:indicator-l' : 'light:indicator-r', box(0.14, 0.15, 0.02, [s * (W - 0.12), 1.42, zR - 0.012], { seg: 1 }));
		b.lamp('light:brake', box(0.06, 0.06, 0.02, [s * 0.2, B.roof - 0.1, zR - 0.012], { seg: 1 }));
	}
	b.add('steel', rod([-0.85, 0.3, zR + 0.4], [-0.85, 0.3, zR - 0.02], 0.05, 8)); // the tailpipe, sooted

	// the roof: the air-conditioning pod over the middle, the roof hatches
	b.add('plastic', span([-1.0, B.roof - 0.02, -1.3], [1.0, 3.2, 1.6]));
	b.add('chassis', box(1.6, 0.02, 2.4, [0, 3.205, 0.15], { seg: 1 }));
	for (const z of [3.2, -3.0]) b.add('plastic', span([-0.45, B.roof - 0.02, z - 0.45], [0.45, B.roof + 0.06, z + 0.45]));

	// the axles under it, the wheels
	b.add('chassis', rod([-0.9, R, B.zFA], [0.9, R, B.zFA], 0.07, 8));
	b.add('chassis', rod([-0.9, R, B.zRA], [0.9, R, B.zRA], 0.09, 8));
	const rim = [0.5, 0.5, 0.48];
	b.wheel('1-l', [1.03, R, B.zFA], { ...B.tyre, rimColour: rim });
	b.wheel('1-r', [-1.03, R, B.zFA], { ...B.tyre, rimColour: rim });
	b.wheel('2-l', [0.9, R, B.zRA], { ...B.tyre, dual: true, rimColour: rim });
	b.wheel('2-r', [-0.9, R, B.zRA], { ...B.tyre, dual: true, rimColour: rim });
	return b;
}

/* ============================================================================================================
 * PART 3 · THE RECIPE
 * ============================================================================================================ */

/** municipal liveries, faded: `body` over the whole, `band` the skirt and the line under the windows */
const VARIANTS = {
	cream: { label: 'Cream and red', body: '#c8bea0', band: '#7c3a2f' },
	yellow: { label: 'Faded yellow', body: '#b9a254', band: '#4a4a46' },
	green: { label: 'Faded green', body: '#6f7f63', band: '#c2bba2' },
	blue: { label: 'Blue and white', body: '#c7c6bd', band: '#3a4f6b' },
};

const FACTS = {
	length: BUS.L, width: { body: 2.55, mirrors: 2.99 }, height: { roof: BUS.roof, airConditioning: 3.2 }, unit: 'm',
	frontOverhang: BUS.FO, wheelbase: BUS.WB, rearOverhang: 3.4, floor: 0.34,
	doors: { count: 3, side: 'right (−x)', width: 1.2, at: BUS.doors },
	tyres: '275/70 R22.5, twin at the rear',
	mass: { empty: 11500, laden: 18000, unit: 'kg' },
	passengers: { seated: 30, total: 100 },
	engine: 'diesel six, about 7.7 L, 210–260 kW, at the back',
	sources: 'Directive 96/53/EC (12 m, 2.55 m, 18 t two-axle); UN R107 (buses); ETRTO tyre sizes; trade data of 12 m two-axle low-floor city buses',
};

function build(variant = 'cream') {
	const V = VARIANTS[variant] ?? VARIANTS.cream;
	const m = materials(grimePicture(variant), { paint: V.body, paint2: V.band });
	const root = bus(m, variant).build([0, 0, 0]);
	root.name = 'city-bus';
	return root;
}

module.exports.recipe = function (id, v, variant) {
	const name = variant ?? 'cream';
	if (!VARIANTS[name]) throw new Error(`no variant ${name} of machines/${id}@${v}`);
	return {
		meta: {
			group: 'machines',
			id,
			version: v,
			variant: name,
			label: `City bus: ${VARIANTS[name].label}`,
			note: 'A worn 12 m low-floor city bus, 12.0 × 2.55 × 3.2 m, three doors on its right, its engine in its back. Lights named for the page (light:head, tail, brake, indicator-l, indicator-r), wheels as pivots (wheel:<axle>-<l|r>).',
			from: 'Old City: the streets',
			facts: JSON.parse(JSON.stringify(FACTS)),
			params: [],
		},
		build: () => build(name),
	};
};
module.exports.variants = Object.keys(VARIANTS);
module.exports.build = build;

return module.exports.recipe("city-bus", 3, "yellow");
});
