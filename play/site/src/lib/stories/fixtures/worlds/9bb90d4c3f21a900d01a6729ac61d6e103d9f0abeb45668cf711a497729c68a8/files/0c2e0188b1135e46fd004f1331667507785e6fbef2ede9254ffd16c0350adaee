		const uv = new Float32Array(pos.count * 2);
		for (let i = 0; i < pos.count; i++) (uv[i * 2] = pos.getZ(i) / GRIME_TILE), (uv[i * 2 + 1] = pos.getY(i) / GRIME_TILE);
