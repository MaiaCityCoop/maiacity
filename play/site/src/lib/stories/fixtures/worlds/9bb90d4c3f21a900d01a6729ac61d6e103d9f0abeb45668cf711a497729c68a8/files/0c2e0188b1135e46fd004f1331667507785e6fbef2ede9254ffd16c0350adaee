/** one lug in the lathe's frame (its axis y): a bar standing `h` out of the carcass at radius rho, across half the tread, leaning */
function lugGeometry(rho, h, W, x0, side, a) {
	const g = new THREE.BoxGeometry(h * 1.4, W * 0.5, 0.075); // radial (x) × across the tread (y) × round it (z)
	g.rotateX(side * 0.44);
	g.translate(rho, x0 + side * W * 0.25, 0);
	g.rotateY(a);
	return g;
}

/* ------------------------------------------------------------------ the body: everything merged per material - */

/**
 * One rigid body of a vehicle (the tractor, the trailer, a boom): its parts merged per material, its lights per name,
 * its wheels each a pivot. `add` takes a shape in vehicle coordinates; the body becomes a group pivoting at `origin`.
 */
class Body {
	constructor(name, seed, mats, o = {}) {
		Object.assign(this, { name, seed, mats, wear: o.wear ?? {}, parts: new Map(), lights: new Map(), wheels: [], bodies: [] });
	}
	/** one shape of a material; its UVs remade in metres (laid on by the face's main direction) and its wear in its colours */
	add(mat, geo, wear) {
		const g = geo.index ? geo.toNonIndexed() : geo;
		// glass stays glass; everything else is the one body material, its own colour baked in
		const tint = mat === 'glass' ? new THREE.Color(1, 1, 1) : this.mats.tint[mat];
		if (!tint) throw new Error(`no colour for ${mat}`);
		mat = mat === 'glass' ? 'glass' : 'body';
		const pos = g.attributes.position, nor = g.attributes.normal;
		const uv = new Float32Array(pos.count * 2), col = new Float32Array(pos.count * 3);
		const p = new THREE.Vector3(), n = new THREE.Vector3();
		for (let i = 0; i < pos.count; i++) {
			p.fromBufferAttribute(pos, i), n.fromBufferAttribute(nor, i);
			const ax = Math.abs(n.x), ay = Math.abs(n.y), az = Math.abs(n.z);
			const [a, b] = ax >= ay && ax >= az ? [p.z, p.y] : az >= ay ? [p.x, p.y] : [p.x, p.z];
			uv[i * 2] = a / GRIME_TILE, uv[i * 2 + 1] = b / GRIME_TILE;
			const c = wearAt(p, n, this.seed, { ...this.wear, ...(wear ?? {}) });
			col.set([c[0] * tint.r, c[1] * tint.g, c[2] * tint.b], i * 3);
		}
		g.setAttribute('uv', new THREE.BufferAttribute(uv, 2));
		g.setAttribute('color', new THREE.BufferAttribute(col, 3));
		for (const k of Object.keys(g.attributes)) if (!['position', 'normal', 'uv', 'color'].includes(k)) g.deleteAttribute(k);
		if (!this.parts.has(mat)) this.parts.set(mat, []);
		this.parts.get(mat).push(g);
		return this;
	}
