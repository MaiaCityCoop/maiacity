"compositions": {"ebe34fd385c63959181d95d7249dfdc6e715cc7b80e58b47ec9c62aa9e36d26e": "<!doctype html>\n<html\n  lang=\"en\"\n  data-composition-variables='[{\"id\":\"subs\",\"type\":\"boolean\",\"label\":\"Burn in the subtitles (review copy only; play draws them itself)\",\"default\":false}]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1080, height=1080\" />\n    <title>How small can a city start?</title>\n    <style>\n      :root {\n        --ground: #f4eada;\n        --ink: #3d3833;\n        --gold: #d9a548;\n        --font-ui: sans-serif;\n      }\n      * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      html,\n      body {\n        width: 1080px;\n        height: 1080px;\n        overflow: hidden;\n        background: var(--ground);\n      }\n      #root {\n        position: relative;\n        width: 100%;\n        height: 100%;\n        overflow: hidden;\n        background: var(--ground);\n        font-family: var(--font-ui);\n      }\n      #cam {\n        position: absolute;\n        left: 0;\n        top: 0;\n        width: 1080px;\n        height: 1080px;\n      }\n      #world {\n        display: block;\n        overflow: visible;\n      }\n      /* the game's HUD: resource chips in a cream pill, the speed buttons beside it */\n      #hud {\n        position: absolute;\n        left: 0;\n        right: 0;\n        top: 26px;\n        height: 64px;\n      }\n      #pill {\n        position: absolute;\n        left: 150px;\n        top: 0;\n        width: 640px;\n        height: 60px;\n        display: flex;\n        align-items: center;\n        justify-content: space-around;\n        padding: 0 14px;\n        background: #fbf5ea;\n        border: 2px solid #dcc8a6;\n        border-radius: 16px;\n        box-shadow: 0 3px 0 #e6d6bb, 0 8px 18px rgb(90 70 40 / 0.12);\n      }\n      .chip {\n        display: flex;\n        align-items: center;\n        gap: 6px;\n        width: 82px;\n      }\n      .chip svg {\n        width: 30px;\n        height: 30px;\n        flex: none;\n      }\n      .num {\n        display: block;\n        width: 44px;\n        font-size: 22px;\n        font-weight: 700;\n        color: #4a433b;\n        font-variant-numeric: tabular-nums;\n      }\n      #speed {\n        position: absolute;\n        left: 818px;\n        top: 4px;\n        width: 166px;\n        height: 52px;\n        display: flex;\n        gap: 9px;\n      }\n      .btn {\n        width: 50px;\n        height: 50px;\n        background: #fbf5ea;\n        border: 2px solid #dcc8a6;\n        border-radius: 13px;\n        box-shadow: 0 3px 0 #e6d6bb;\n        display: grid;\n        place-items: center;\n      }\n      .btn svg {\n        width: 24px;\n        height: 24px;\n      }\n      .btn.on {\n        background: #f3e3c3;\n        border-color: #c99a4e;\n      }\n      /* review copy only: the subtitles as play's Stories player draws them */\n      #subs {\n        position: absolute;\n        left: 3%;\n        right: 3%;\n        bottom: 9%;\n        height: 200px;\n      }\n      .sub {\n        position: absolute;\n        left: 0;\n        right: 0;\n        bottom: 0;\n        display: flex;\n        justify-content: center;\n        align-items: flex-end;\n      }\n      .sub span {\n        display: block;\n        font-size: 60px;\n        font-weight: 700;\n        line-height: 1.2;\n        color: #fff;\n        background: rgb(10 10 8 / 0.5);\n        padding: 0.18em 0.45em;\n        border-radius: 0.3em;\n        text-shadow: 0 1px 4px rgb(0 0 0 / 0.7);\n      }\n      .sub.em span {\n        font-size: 104px;\n        font-weight: 800;\n        line-height: 1;\n        letter-spacing: 0.02em;\n        color: #ffd76a;\n        background: none;\n        padding: 0;\n        text-shadow: 0 2px 10px rgb(0 0 0 / 0.75), 0 0 2px rgb(0 0 0 / 0.9);\n      }\n      #fade {\n        position: absolute;\n        inset: 0;\n        background: var(--ground);\n        opacity: 0;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root\"\n      data-composition-id=\"main\"\n      data-start=\"0\"\n      data-duration=\"10\"\n      data-width=\"1080\"\n      data-height=\"1080\"\n    >\n      <div id=\"cam\">\n        <svg id=\"world\" xmlns=\"http://www.w3.org/2000/svg\" width=\"1080\" height=\"1080\" viewBox=\"0 0 1080 1080\">\n          <defs id=\"defs\"></defs>\n          <g id=\"l-mountains\"></g>\n          <g id=\"l-ghosts\"></g>\n          <g id=\"l-river\"></g>\n          <g id=\"l-plots\"></g>\n          <g id=\"l-flats\"></g>\n          <g id=\"l-bound\"></g>\n          <g id=\"l-tokens\"></g>\n          <g id=\"l-objects\"></g>\n        </svg>\n      </div>\n\n      <div id=\"hud\">\n        <div id=\"pill\">\n          <div class=\"chip\">\n            <svg viewBox=\"0 0 30 30\"><g stroke=\"#3d3833\" stroke-width=\"1.4\" stroke-linejoin=\"round\"><rect x=\"4\" y=\"12\" width=\"20\" height=\"7\" rx=\"3.5\" fill=\"#9c6b45\" transform=\"rotate(-18 14 15)\"/><circle cx=\"23.2\" cy=\"12\" r=\"3.6\" fill=\"#d4a673\"/><rect x=\"6\" y=\"17\" width=\"19\" height=\"7\" rx=\"3.5\" fill=\"#8a5c3a\" transform=\"rotate(10 15 20)\"/></g></svg>\n            <span class=\"num\" id=\"n-wood\">0</span>\n          </div>\n          <div class=\"chip\">\n            <svg viewBox=\"0 0 30 30\"><g stroke=\"#3d3833\" stroke-width=\"1.4\" stroke-linejoin=\"round\"><polygon points=\"5,21 9,11 17,7 25,12 26,20 18,25\" fill=\"#b9b6ae\"/><polygon points=\"17,7 25,12 26,20 18,15\" fill=\"#9d9a93\"/></g></svg>\n            <span class=\"num\" id=\"n-stone\">0</span>\n          </div>\n          <div class=\"chip\">\n            <svg viewBox=\"0 0 30 30\"><g stroke=\"#3d3833\" stroke-width=\"1.4\" stroke-linejoin=\"round\"><circle cx=\"15\" cy=\"17\" r=\"9\" fill=\"#d9663f\"/><path d=\"M15 17 L22 11 A9 9 0 0 1 22 23 Z\" fill=\"#b8512f\"/><path d=\"M15 8 Q18 3 22 5 Q19 9 15 8 Z\" fill=\"#7f9b62\"/></g></svg>\n            <span class=\"num\" id=\"n-food\">0</span>\n          </div>\n          <div class=\"chip\">\n            <svg viewBox=\"0 0 30 30\"><path d=\"M15 4 C19 10 23 14 23 19 A8 8 0 0 1 7 19 C7 14 11 10 15 4 Z\" fill=\"#5e9fc9\" stroke=\"#3d3833\" stroke-width=\"1.4\" stroke-linejoin=\"round\"/></svg>\n            <span class=\"num\" id=\"n-water\">0</span>\n          </div>\n          <div class=\"chip\">\n            <svg viewBox=\"0 0 30 30\"><path d=\"M17 3 L7 17 H14 L12 27 L23 12 H16 Z\" fill=\"#e8b84a\" stroke=\"#3d3833\" stroke-width=\"1.4\" stroke-linejoin=\"round\"/></svg>\n            <span class=\"num\" id=\"n-energy\">0</span>\n          </div>\n          <div class=\"chip\">\n            <svg viewBox=\"0 0 30 30\"><g stroke=\"#3d3833\" stroke-width=\"1.4\"><circle cx=\"15\" cy=\"15\" r=\"10\" fill=\"#e3b54e\"/><circle cx=\"15\" cy=\"15\" r=\"6\" fill=\"#f0cf7a\"/></g></svg>\n            <span class=\"num\" id=\"n-coins\">0</span>\n          </div>\n          <div class=\"chip\">\n            <svg viewBox=\"0 0 30 30\"><g stroke=\"#3d3833\" stroke-width=\"1.4\" stroke-linejoin=\"round\"><circle cx=\"20\" cy=\"10\" r=\"4\" fill=\"#8fb0b8\"/><path d=\"M13 25 Q14 16 20 16 Q26 16 27 25 Z\" fill=\"#6f939c\"/><circle cx=\"11\" cy=\"11\" r=\"4.4\" fill=\"#a9c4ca\"/><path d=\"M3 26 Q4 17 11 17 Q18 17 19 26 Z\" fill=\"#86a7ae\"/></g></svg>\n            <span class=\"num\" id=\"n-people\">0</span>\n          </div>\n        </div>\n        <div id=\"speed\">\n          <div class=\"btn\"><svg viewBox=\"0 0 24 24\"><g fill=\"#4a433b\"><rect x=\"6\" y=\"5\" width=\"4\" height=\"14\" rx=\"1\"/><rect x=\"14\" y=\"5\" width=\"4\" height=\"14\" rx=\"1\"/></g></svg></div>\n          <div class=\"btn on\"><svg viewBox=\"0 0 24 24\"><path d=\"M8 5 L19 12 L8 19 Z\" fill=\"#4a433b\"/></svg></div>\n          <div class=\"btn\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 6 L11 12 L3 18 Z M12 6 L20 12 L12 18 Z\" fill=\"#4a433b\"/></svg></div>\n        </div>\n      </div>\n\n      <div id=\"subs\">\n        <div id=\"sub-question\" class=\"sub clip\" data-start=\"0.3\" data-duration=\"1.8\"><span>How small can a city start?</span></div>\n        <div id=\"sub-one\" class=\"sub clip\" data-start=\"2.1\" data-duration=\"3.0\"><span>One hex.</span></div>\n        <div id=\"sub-six\" class=\"sub clip\" data-start=\"5.1\" data-duration=\"3.4\"><span>Add six…</span></div>\n        <div id=\"sub-village\" class=\"sub em clip\" data-start=\"8.5\" data-duration=\"1.5\"><span>7 hexes = 1 village</span></div>\n      </div>\n\n      <div id=\"fade\"></div>\n    </div>\n\n    <script>\n      // ---------- the world: one hex, six around it, on cream ground ----------\n      const NS = \"http://www.w3.org/2000/svg\";\n      const INK = \"#3d3833\";\n      const CX = 575, CY = 560, SQ = 0.56, R = 165, RD = R * 0.93;\n      const PHI = (15 * Math.PI) / 180;\n      const D = Math.sqrt(3) * R;\n      const f = (n) => Math.round(n * 10) / 10;\n      const pt = (p) => f(p[0]) + \" \" + f(p[1]);\n      const plan = (u, v) => [CX + u, CY + v * SQ];\n\n      // a seeded random, so every frame is the same every time\n      let seed = 20261107;\n      const rnd = () => {\n        seed |= 0; seed = (seed + 0x6d2b79f5) | 0;\n        let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);\n        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n      };\n\n      const hexPts = (hu, hv, r) => {\n        const out = [];\n        for (let k = 0; k < 6; k++) {\n          const a = PHI + (k * Math.PI) / 3;\n          out.push(plan(hu + r * Math.cos(a), hv + r * Math.sin(a)));\n        }\n        return out;\n      };\n      const roundPath = (pts, t = 0.24) => {\n        const n = pts.length;\n        let d = \"\";\n        for (let i = 0; i < n; i++) {\n          const p = pts[(i - 1 + n) % n], v = pts[i], q = pts[(i + 1) % n];\n          const a = [v[0] + (p[0] - v[0]) * t, v[1] + (p[1] - v[1]) * t];\n          const b = [v[0] + (q[0] - v[0]) * t, v[1] + (q[1] - v[1]) * t];\n          d += (i ? \"L\" : \"M\") + pt(a) + \" Q\" + pt(v) + \" \" + pt(b) + \" \";\n        }\n        return d + \"Z\";\n      };\n      const scalePts = (pts, c, s) => pts.map((p) => [c[0] + (p[0] - c[0]) * s, c[1] + (p[1] - c[1]) * s]);\n\n      // the six neighbours, by direction, and the ring beyond them (the city that could be)\n      const dirs = [];\n      for (let k = 0; k < 6; k++) {\n        const a = PHI + Math.PI / 6 + (k * Math.PI) / 3;\n        dirs.push([D * Math.cos(a), D * Math.sin(a)]);\n      }\n      const ring1 = dirs.map((d) => d.slice());\n      const ring2 = [];\n      for (let k = 0; k < 6; k++) {\n        ring2.push([dirs[k][0] * 2, dirs[k][1] * 2]);\n        const n = dirs[(k + 1) % 6];\n        ring2.push([dirs[k][0] + n[0], dirs[k][1] + n[1]]);\n      }\n\n      const el = (tag, attrs, parent) => {\n        const e = document.createElementNS(NS, tag);\n        for (const k in attrs) e.setAttribute(k, attrs[k]);\n        if (parent) parent.appendChild(e);\n        return e;\n      };\n      const L = (id) => document.getElementById(id);\n      let uid = 0;\n\n      // ---------- ground: low-poly hills in the corners, tufts ----------\n      const mountains = [\n        [\"#efe3d0\", \"-320,-300 380,-300 250,40 60,210 -320,260\"],\n        [\"#e9dbc5\", \"-320,-300 180,-300 40,90 -320,120\"],\n        [\"#ece0cc\", \"60,210 250,40 330,-60 110,-300 380,-300 420,-120 280,140\"],\n        [\"#eadcc6\", \"760,-300 1420,-300 1420,250 1180,140 1000,40 880,-60\"],\n        [\"#e6d6bd\", \"1000,40 1180,140 1420,250 1420,-60 1220,-120\"],\n        [\"#efe4d2\", \"880,-60 1000,40 1080,-300\"],\n        [\"#ebdec9\", \"880,1300 1420,1300 1420,800 1200,880 1020,1010\"],\n        [\"#e6d7be\", \"1200,880 1420,800 1420,1040 1260,1000\"],\n        [\"#eee3d0\", \"-320,1300 380,1300 260,1080 40,980 -320,940\"],\n        [\"#e8dac3\", \"-320,940 40,980 -60,1120 -320,1160\"],\n      ];\n      for (const [fill, points] of mountains) el(\"polygon\", { points, fill }, L(\"l-mountains\"));\n\n      const tuft = (x, y, parent) =>\n        el(\"path\", { d: `M${f(x - 3)} ${f(y)} L${f(x - 1.6)} ${f(y - 5)} M${f(x)} ${f(y)} L${f(x)} ${f(y - 6.5)} M${f(x + 3)} ${f(y)} L${f(x + 1.6)} ${f(y - 5)}`, stroke: \"#8f8a6c\", \"stroke-width\": 1.2, \"stroke-linecap\": \"round\", fill: \"none\" }, parent);\n      for (let i = 0; i < 70; i++) tuft(-200 + rnd() * 1500, -120 + rnd() * 1300, L(\"l-mountains\"));\n\n      // ---------- the ghost grid: empty plots, the city that isn't there yet ----------\n      const ghosts = { c: [], r1: [], r2: [] };\n      const ghost = (hu, hv, bucket) => {\n        const g = el(\"g\", {}, L(\"l-ghosts\"));\n        el(\"path\", { d: roundPath(hexPts(hu, hv, RD)), fill: \"rgb(236 223 198 / 0.35)\", stroke: \"#cdbb9c\", \"stroke-width\": 2.2, \"stroke-dasharray\": \"8 8\", \"stroke-linecap\": \"round\" }, g);\n        const c = plan(hu, hv);\n        el(\"path\", { d: `M${f(c[0] - 9)} ${f(c[1])} H${f(c[0] + 9)} M${f(c[0])} ${f(c[1] - 9)} V${f(c[1] + 9)}`, stroke: \"#c4b08e\", \"stroke-width\": 2, \"stroke-linecap\": \"round\" }, g);\n        bucket.push(g);\n      };\n      ghost(0, 0, ghosts.c);\n      ring1.forEach((d) => ghost(d[0], d[1], ghosts.r1));\n      ring2.forEach((d) => ghost(d[0], d[1], ghosts.r2));\n\n      // ---------- the river (drawn in once the village is whole) ----------\n      const riverD = \"M 270 -120 C 240 110, 108 230, 88 400 C 72 540, 118 650, 92 800 C 78 905, 28 1010, -40 1160\";\n      const riverBank = el(\"path\", { d: riverD, fill: \"none\", stroke: \"#24575a\", \"stroke-width\": 44, \"stroke-linecap\": \"butt\" }, L(\"l-river\"));\n      const riverWater = el(\"path\", { d: riverD, fill: \"none\", stroke: \"#2f6f73\", \"stroke-width\": 34, \"stroke-linecap\": \"butt\" }, L(\"l-river\"));\n      const riverLight = el(\"path\", { d: riverD, fill: \"none\", stroke: \"#4b8d8f\", \"stroke-width\": 6, \"stroke-linecap\": \"butt\", transform: \"translate(-7 0)\" }, L(\"l-river\"));\n\n      // ---------- the plots ----------\n      const plotOf = (hu, hv) => {\n        const c = plan(hu, hv);\n        const pts = hexPts(hu, hv, RD);\n        const g = el(\"g\", {}, L(\"l-plots\"));\n        el(\"path\", { d: roundPath(pts), fill: \"#ecdfc6\", stroke: \"#d9c8aa\", \"stroke-width\": 10, \"stroke-linejoin\": \"round\" }, g);\n        el(\"path\", { d: roundPath(pts), fill: \"none\", stroke: \"#faf4ea\", \"stroke-width\": 6, \"stroke-linejoin\": \"round\" }, g);\n        const gold = el(\"path\", { d: roundPath(scalePts(pts, c, 0.88)), fill: \"none\", stroke: \"#d9a548\", \"stroke-width\": 3.2, \"stroke-linejoin\": \"round\", opacity: 0 }, g);\n        return { g, gold, c, hu, hv };\n      };\n      const center = plotOf(0, 0);\n      // the six, in the order they join: wind (N), solar (E), quarry (SE), pond (S), timber (W), food forest (NW)\n      const byName = {};\n      const order = [\n        [\"wind\", 4], [\"solar\", 5], [\"quarry\", 0], [\"pond\", 1], [\"timber\", 2], [\"forest\", 3],\n      ];\n      for (const [name, k] of order) byName[name] = plotOf(ring1[k][0], ring1[k][1]);\n\n      // ---------- the drawings, each standing on its base at (0,0) ----------\n      const objects = [];\n      const place = (x, y, draw, opts = {}) => {\n        const outer = el(\"g\", { transform: `translate(${f(x)} ${f(y)})` });\n        const pop = el(\"g\", {}, outer);\n        draw(pop);\n        objects.push({ y: y + (opts.dy || 0), outer, pop });\n        return pop;\n      };\n      const shadow = (p, rx, ry, dx = 0, dy = 0) => el(\"ellipse\", { cx: f(dx), cy: f(dy), rx: f(rx), ry: f(ry), fill: \"#6b5640\", opacity: 0.14 }, p);\n      const line = (p, d, w = 1.6, color = INK, extra = {}) => el(\"path\", Object.assign({ d, fill: \"none\", stroke: color, \"stroke-width\": w, \"stroke-linejoin\": \"round\", \"stroke-linecap\": \"round\" }, extra), p);\n      const poly = (p, pts, fill, stroke = INK, w = 1.6) =>\n        el(\"polygon\", { points: pts.map(pt).join(\" \").replace(/ (?=-?\\d)/g, (m, i, s) => m), fill, stroke, \"stroke-width\": w, \"stroke-linejoin\": \"round\" }, p);\n      const polyPts = (pts) => pts.map((q) => f(q[0]) + \",\" + f(q[1])).join(\" \");\n      const P = (p, pts, fill, stroke = INK, w = 1.6) => el(\"polygon\", { points: polyPts(pts), fill, stroke, \"stroke-width\": w, \"stroke-linejoin\": \"round\" }, p);\n\n      // a geodesic dome: a hemisphere of triangles, shaded on the right, a door on the left\n      const dome = (r, light, shade, opts = {}) => (p) => {\n        const ry = r * 0.5;\n        const id = \"dc\" + uid++;\n        shadow(p, r * 1.18, ry * 1.05, r * 0.32, ry * 0.32);\n        const body = `M ${f(-r)} 0 A ${f(r)} ${f(r)} 0 0 1 ${f(r)} 0 A ${f(r)} ${f(ry)} 0 0 1 ${f(-r)} 0 Z`;\n        const cp = el(\"clipPath\", { id }, L(\"defs\"));\n        el(\"path\", { d: body }, cp);\n        el(\"path\", { d: body, fill: light }, p);\n        const inner = el(\"g\", { \"clip-path\": `url(#${id})` }, p);\n        P(inner, [[r * 0.18, -r * 1.2], [r * 1.2, -r * 1.2], [r * 1.2, ry * 1.3], [r * 0.4, ry * 1.3]], shade, \"none\", 0);\n        if (opts.glass) P(inner, [[-r * 0.75, -r * 0.2], [-r * 0.2, -r * 0.92], [r * 0.05, -r * 0.7], [-r * 0.5, -r * 0.05]], \"rgb(255 255 255 / 0.35)\", \"none\", 0);\n        const hs = [0, 0.36, 0.68, 0.9];\n        const rings = hs.map((h) => {\n          const rx = Math.sqrt(Math.max(r * r - h * h * r * r, 0));\n          return { h: h * r, rx, ry: rx * 0.5 };\n        });\n        const ringPt = (ri, a) => [rings[ri].rx * Math.cos(a), -rings[ri].h + rings[ri].ry * Math.sin(a)];\n        let d = \"\";\n        for (let i = 1; i < rings.length; i++) {\n          const g = rings[i];\n          d += `M ${f(-g.rx)} ${f(-g.h)} A ${f(g.rx)} ${f(g.ry)} 0 0 0 ${f(g.rx)} ${f(-g.h)} `;\n        }\n        const ns = [8, 6, 4];\n        for (let i = 0; i < 3; i++) {\n          const n = ns[i];\n          for (let j = 0; j <= n; j++) {\n            const a0 = (Math.PI * j) / n;\n            const a1 = (Math.PI * (j + 0.5)) / n;\n            const a2 = (Math.PI * (j - 0.5)) / n;\n            const lo = ringPt(i, a0);\n            if (a1 <= Math.PI) { const up = ringPt(i + 1, a1); d += `M ${pt(lo)} L ${pt(up)} `; }\n            if (a2 >= 0) { const up = ringPt(i + 1, a2); d += `M ${pt(lo)} L ${pt(up)} `; }\n          }\n        }\n        for (let j = 0; j <= 4; j++) { const q = ringPt(3, (Math.PI * (j + 0.5)) / 4); if ((Math.PI * (j + 0.5)) / 4 <= Math.PI) d += `M ${pt(q)} L 0 ${f(-r)} `; }\n        line(inner, d, 1, INK, { opacity: 0.38 });\n        el(\"path\", { d: body, fill: \"none\", stroke: INK, \"stroke-width\": 2, \"stroke-linejoin\": \"round\" }, p);\n        // the door, a short tunnel at the front left\n        const x0 = -r * 0.42, y0 = ry * Math.sqrt(1 - (x0 / r) ** 2) - 1, w = r * 0.3, h = r * 0.2;\n        el(\"path\", { d: `M ${f(x0 - w / 2)} ${f(y0 + 3)} L ${f(x0 - w / 2)} ${f(y0 - h)} A ${f(w / 2)} ${f(w / 2)} 0 0 1 ${f(x0 + w / 2)} ${f(y0 - h)} L ${f(x0 + w / 2)} ${f(y0 + 3)} Z`, fill: opts.door || \"#d8cfc0\", stroke: INK, \"stroke-width\": 1.5 }, p);\n        el(\"path\", { d: `M ${f(x0 - w / 4)} ${f(y0 + 3)} L ${f(x0 - w / 4)} ${f(y0 - h * 0.6)} A ${f(w / 4)} ${f(w / 4)} 0 0 1 ${f(x0 + w / 4)} ${f(y0 - h * 0.6)} L ${f(x0 + w / 4)} ${f(y0 + 3)} Z`, fill: \"#5c4e43\" }, p);\n      };\n\n      // a round tree: a low-poly crown in three tones\n      const tree = (s, opts = {}) => (p) => {\n        shadow(p, 11 * s, 4.5 * s, 4 * s, 1.5 * s);\n        P(p, [[-2.2 * s, 0], [2.2 * s, 0], [1.6 * s, -12 * s], [-1.6 * s, -12 * s]], \"#7b5b40\", INK, 1.3);\n        const cy = -21 * s, n = 7, pts = [];\n        const rot = rnd() * Math.PI;\n        for (let i = 0; i < n; i++) {\n          const a = rot + (i * 2 * Math.PI) / n;\n          const rr = 12.5 * s * (0.86 + rnd() * 0.22);\n          pts.push([Math.cos(a) * rr, cy + Math.sin(a) * rr * 0.95]);\n        }\n        P(p, pts, opts.c1 || \"#7f9b62\", \"none\", 0);\n        const right = pts.filter((q) => q[0] > 1.5 * s || q[1] > cy + 6 * s);\n        right.sort((a, b) => Math.atan2(a[1] - cy, a[0]) - Math.atan2(b[1] - cy, b[0]));\n        P(p, [[0.5 * s, cy - 1.5 * s], ...right], opts.c2 || \"#64804d\", \"none\", 0);\n        const left = pts.filter((q) => q[0] < -2 * s && q[1] < cy + 2 * s);\n        if (left.length) P(p, [[-1 * s, cy - 2 * s], ...left], opts.c3 || \"#98b276\", \"none\", 0);\n        el(\"polygon\", { points: polyPts(pts), fill: \"none\", stroke: INK, \"stroke-width\": 1.6, \"stroke-linejoin\": \"round\" }, p);\n        if (opts.fruit) {\n          for (let i = 0; i < 5; i++) {\n            const a = rnd() * Math.PI * 2, rr = rnd() * 8 * s;\n            el(\"circle\", { cx: f(Math.cos(a) * rr), cy: f(cy + Math.sin(a) * rr * 0.8), r: f(1.9 * s), fill: i % 2 ? \"#e8a13a\" : \"#d9573b\", stroke: INK, \"stroke-width\": 0.8 }, p);\n          }\n        }\n      };\n\n      // a conifer: two-tone cone\n      const conifer = (h, w) => (p) => {\n        shadow(p, w * 0.7, w * 0.28, w * 0.25, 1);\n        line(p, `M 0 0 L 0 ${f(-h * 0.12)}`, 2.2, \"#6b4d36\");\n        P(p, [[0, -h], [-w / 2, -h * 0.12], [0, -h * 0.07]], \"#4d7257\", \"none\", 0);\n        P(p, [[0, -h], [w / 2, -h * 0.15], [0, -h * 0.07]], \"#34523f\", \"none\", 0);\n        el(\"polygon\", { points: polyPts([[0, -h], [-w / 2, -h * 0.12], [0, -h * 0.07], [w / 2, -h * 0.15]]), fill: \"none\", stroke: INK, \"stroke-width\": 1.4, \"stroke-linejoin\": \"round\" }, p);\n      };\n\n      // a wind turbine: white tower, gold foot, three blades that turn\n      const blades = [];\n      const turbine = (H) => (p) => {\n        shadow(p, 10, 4, 3, 1);\n        P(p, [[-3.4, 0], [3.4, 0], [1.7, -H], [-1.7, -H]], \"#f3f0ea\", INK, 1.4);\n        P(p, [[0, 0], [3.4, 0], [1.7, -H], [0, -H]], \"#d9d4cb\", \"none\", 0);\n        P(p, [[-3.4, 0], [3.4, 0], [3.0, -H * 0.22], [-3.0, -H * 0.22]], \"#e0a24c\", INK, 1.4);\n        el(\"rect\", { x: -3.5, y: f(-H - 4), width: 10, height: 6.5, rx: 2, fill: \"#f3f0ea\", stroke: INK, \"stroke-width\": 1.3 }, p);\n        const hub = el(\"g\", { transform: `translate(0 ${f(-H)})` }, p);\n        const b = el(\"g\", {}, hub);\n        const Lb = H * 0.42;\n        el(\"circle\", { cx: 0, cy: 0, r: f(Lb + 1), fill: \"none\", stroke: \"none\" }, b);\n        for (const a of [0, 120, 240]) {\n          el(\"polygon\", { points: polyPts([[0, -2.2], [Lb * 0.28, -3.4], [Lb, -0.2], [Lb * 0.3, 1.8], [0, 2.2]]), transform: `rotate(${a - 90})`, fill: \"#f8f6f1\", stroke: INK, \"stroke-width\": 1.2, \"stroke-linejoin\": \"round\" }, b);\n        }\n        el(\"circle\", { cx: 0, cy: 0, r: 3.4, fill: \"#e9e5de\", stroke: INK, \"stroke-width\": 1.3 }, b);\n        blades.push(b);\n      };\n\n      // a solar panel on short legs, tilted to the sky\n      const U = [Math.cos(PHI), Math.sin(PHI) * SQ];\n      const V = [Math.cos(PHI + Math.PI / 2), Math.sin(PHI + Math.PI / 2) * SQ];\n      const panel = () => (p) => {\n        const a = 40, b = 24, tilt = 12;\n        const p0 = [0, 0], p1 = [a * U[0], a * U[1]];\n        // the back edge lies away from us (against V) and is raised: the panel faces the sky and the viewer\n        const p2 = [p1[0] - b * V[0], p1[1] - b * V[1] - tilt];\n        const p3 = [-b * V[0], -b * V[1] - tilt];\n        const lift = 9;\n        const up = (q) => [q[0], q[1] - lift];\n        shadow(p, 26, 9, 18, -4);\n        line(p, `M ${pt(p0)} L ${pt(up(p0))} M ${pt(p1)} L ${pt(up(p1))}`, 1.6);\n        P(p, [up(p0), up(p1), up(p2), up(p3)], \"#4e7ec2\", INK, 1.5);\n        let d = \"\";\n        for (let i = 1; i < 4; i++) { const t = i / 4; const s0 = [up(p0)[0] + (up(p1)[0] - up(p0)[0]) * t, up(p0)[1] + (up(p1)[1] - up(p0)[1]) * t]; const s1 = [up(p3)[0] + (up(p2)[0] - up(p3)[0]) * t, up(p3)[1] + (up(p2)[1] - up(p3)[1]) * t]; d += `M ${pt(s0)} L ${pt(s1)} `; }\n        const m0 = [(up(p0)[0] + up(p3)[0]) / 2, (up(p0)[1] + up(p3)[1]) / 2], m1 = [(up(p1)[0] + up(p2)[0]) / 2, (up(p1)[1] + up(p2)[1]) / 2];\n        d += `M ${pt(m0)} L ${pt(m1)}`;\n        line(p, d, 1, \"#a9c4ea\");\n        P(p, [up(p3), up(p2), [up(p2)[0] - 2, up(p2)[1] - 2], [up(p3)[0] - 2, up(p3)[1] - 2]], \"#7da4da\", \"none\", 0);\n      };\n\n      // a terracotta rock spire\n      const spire = (H, w) => (p) => {\n        shadow(p, w * 0.9, w * 0.35, w * 0.4, 2);\n        const j = () => (rnd() - 0.5) * w * 0.25;\n        const Lb = [-w / 2, -2], M = [w * 0.05, 3], Rb = [w / 2, -3];\n        const TL = [-w / 2 + w * 0.15 + j(), -H + 4], TM = [w * 0.08 + j(), -H - 3], TR = [w / 2 - w * 0.12 + j(), -H + 8 + rnd() * 6];\n        P(p, [Lb, M, TM, TL], \"#c96d50\", \"none\", 0);\n        P(p, [M, Rb, TR, TM], \"#a6533b\", \"none\", 0);\n        P(p, [TL, TM, TR, [TM[0], TM[1] + 6]], \"#d98b6b\", \"none\", 0);\n        el(\"polygon\", { points: polyPts([Lb, M, Rb, TR, TM, TL]), fill: \"none\", stroke: INK, \"stroke-width\": 1.6, \"stroke-linejoin\": \"round\" }, p);\n        line(p, `M ${pt(M)} L ${pt(TM)}`, 1.1, INK, { opacity: 0.6 });\n      };\n      const pebble = (s) => (p) => {\n        P(p, [[-5 * s, 0], [-3 * s, -5 * s], [3 * s, -6 * s], [6 * s, -1 * s], [2 * s, 2 * s]], \"#b9644a\", INK, 1.2);\n      };\n\n      // a pile of logs\n      const logs = () => (p) => {\n        shadow(p, 24, 7, 4, 3);\n        const one = (x, y) => {\n          const g = el(\"g\", { transform: `translate(${x} ${y}) rotate(8.5)` }, p);\n          el(\"rect\", { x: -17, y: -8, width: 34, height: 8, rx: 4, fill: \"#9c6b45\", stroke: INK, \"stroke-width\": 1.3 }, g);\n          el(\"ellipse\", { cx: 16, cy: -4, rx: 3.6, ry: 4.3, fill: \"#d4a673\", stroke: INK, \"stroke-width\": 1.2 }, g);\n        };\n        one(-6, 2); one(4, 6); one(-1, -5);\n      };\n\n      // a construction site: a dashed ring and a small crane\n      const crane = () => (p) => {\n        el(\"ellipse\", { cx: 16, cy: 2, rx: 32, ry: 15, fill: \"rgb(255 255 255 / 0.3)\", stroke: \"#8e8170\", \"stroke-width\": 1.4, \"stroke-dasharray\": \"3 4\" }, p);\n        P(p, [[6, 4], [14, -8], [26, -6], [30, 6]], \"#e3d6bf\", \"#8e8170\", 1.1);\n        line(p, \"M -3 0 L -3 -62 M 3 0 L 3 -62 M -3 -6 L 3 -14 L -3 -22 L 3 -30 L -3 -38 L 3 -46 L -3 -54 L 3 -62\", 1.5, \"#c48a36\");\n        line(p, \"M -14 -62 L 42 -62 M -3 -70 L 3 -62 M 3 -70 L 3 -62 M -3 -70 L 3 -70 M -3 -70 L -14 -62 M 3 -70 L 42 -62\", 1.5, \"#c48a36\");\n        el(\"rect\", { x: -16, y: -63, width: 8, height: 6, fill: \"#6e655b\", stroke: INK, \"stroke-width\": 1 }, p);\n        line(p, \"M 34 -62 L 34 -38\", 1, INK);\n        P(p, [[30, -38], [38, -38], [38, -32], [30, -32]], \"#c48a36\", INK, 1);\n      };\n\n      // a walker carrying a crate\n      const walker = el(\"g\", {});\n      const walkerBob = el(\"g\", {}, walker);\n      ((p) => {\n        shadow(p, 7, 2.6, 1, 1);\n        line(p, \"M -2 0 L -1 -7 M 2 0 L 1 -7\", 1.6, \"#39404d\");\n        P(p, [[-5, -6], [5, -6], [3, -18], [-3, -18]], \"#39404d\", INK, 1.2);\n        el(\"circle\", { cx: 0, cy: -22, r: 4.6, fill: \"#4e8c9b\", stroke: INK, \"stroke-width\": 1.2 }, p);\n        el(\"rect\", { x: 2, y: -16, width: 8, height: 7, fill: \"#c98b4f\", stroke: INK, \"stroke-width\": 1.1 }, p);\n      })(walkerBob);\n\n      // ---------- who stands where ----------\n      const pops = { center: [], wind: [], solar: [], quarry: [], pond: [], timber: [], forest: [] };\n      const at = (plot, du, dv) => [plot.c[0] + du, plot.c[1] + dv];\n\n      // the first settlement\n      {\n        const c = center;\n        pops.center.push(place(...at(c, -18, 16), dome(40, \"#f4f1ea\", \"#d6d2c9\")));\n        pops.center.push(place(...at(c, 50, 30), dome(27, \"#f4f1ea\", \"#d6d2c9\")));\n        pops.center.push(place(...at(c, 22, -14), dome(24, \"#f4f1ea\", \"#d6d2c9\")));\n        for (const [du, dv, s] of [[62, -36, 1.0], [86, -22, 0.9], [40, -48, 0.85], [100, 2, 0.95], [76, -50, 0.8]]) pops.center.push(place(...at(c, du, dv), tree(s)));\n        pops.center.push(place(...at(c, -92, -18), crane()));\n      }\n      // wind (N)\n      for (const [du, dv, H] of [[-52, 6, 118], [4, -22, 136], [56, 14, 112]]) pops.wind.push(place(...at(byName.wind, du, dv), turbine(H)));\n      pops.wind.push(place(...at(byName.wind, -96, 30), conifer(30, 13)));\n      // solar (E)\n      for (let j = 0; j < 2; j++) for (let i = 0; i < 3; i++) {\n        const base = at(byName.solar, -84, -32);\n        pops.solar.push(place(base[0] + i * 46 * U[0] + j * 34 * V[0], base[1] + i * 46 * U[1] + j * 34 * V[1], panel(), { dy: 14 }));\n      }\n      pops.solar.push(place(...at(byName.solar, 62, 34), dome(26, \"#a9c8e6\", \"#7fa6cf\", { glass: true, door: \"#c9d9e8\" })));\n      // quarry (SE)\n      for (const [du, dv, H, w] of [[22, -6, 96, 26], [52, -16, 124, 30], [74, 10, 82, 24], [40, 26, 56, 22]]) pops.quarry.push(place(...at(byName.quarry, du, dv), spire(H, w)));\n      pops.quarry.push(place(...at(byName.quarry, -50, 22), dome(28, \"#c9c6bf\", \"#a8a49c\")));\n      for (const [du, dv, s] of [[-8, 34, 0.9], [96, 30, 0.7], [6, 44, 0.6]]) pops.quarry.push(place(...at(byName.quarry, du, dv), pebble(s)));\n      // timber (W)\n      pops.timber.push(place(...at(byName.timber, 6, 6), dome(32, \"#d9ae6a\", \"#bb8f4f\", { door: \"#e9cf9f\" })));\n      pops.timber.push(place(...at(byName.timber, -64, 30), logs()));\n      pops.timber.push(place(...at(byName.timber, 62, 40), logs()));\n      for (const [du, dv, h] of [[-40, -36, 40], [-18, -48, 46], [40, -40, 38], [-70, -10, 34]]) pops.timber.push(place(...at(byName.timber, du, dv), conifer(h, 16)));\n      // food forest (NW)\n      {\n        const spots = [[-80, -14, 1.0], [-46, -36, 1.1], [-8, -48, 0.95], [30, -36, 1.05], [64, -18, 0.9], [-58, 14, 0.95], [-20, -6, 1.15], [20, 2, 1.0], [56, 20, 0.95], [-26, 32, 0.9], [14, 38, 0.85]];\n        spots.forEach(([du, dv, s], i) => pops.forest.push(place(...at(byName.forest, du, dv), tree(s, { fruit: i % 3 !== 1, c1: i % 2 ? \"#7f9b62\" : \"#86a165\", c2: \"#62804b\" }))));\n      }\n      // pond (S): flat water, reeds and two trees\n      const pondG = el(\"g\", {}, L(\"l-flats\"));\n      {\n        const c = at(byName.pond, -6, 6);\n        const pts = [];\n        for (let i = 0; i < 10; i++) {\n          const a = (i / 10) * Math.PI * 2;\n          const rr = 1 + (rnd() - 0.5) * 0.22;\n          pts.push([c[0] + Math.cos(a) * 82 * rr, c[1] + Math.sin(a) * 38 * rr]);\n        }\n        const smooth = (ps, k = 1) => {\n          let d = \"\";\n          const n = ps.length;\n          for (let i = 0; i < n; i++) {\n            const a = ps[i], b = ps[(i + 1) % n];\n            const m = [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2];\n            d += (i ? \" Q\" + pt(a) + \" \" : \"M\" + pt(m) + \" Q\" + pt(a) + \" \") + pt(m);\n          }\n          return d;\n        };\n        // first midpoint path fix: start at midpoint of last->first\n        const n = pts.length, last = pts[n - 1], first = pts[0];\n        const m0 = [(last[0] + first[0]) / 2, (last[1] + first[1]) / 2];\n        let d = \"M\" + pt(m0);\n        for (let i = 0; i < n; i++) { const a = pts[i], b = pts[(i + 1) % n]; d += \" Q\" + pt(a) + \" \" + pt([(a[0] + b[0]) / 2, (a[1] + b[1]) / 2]); }\n        d += \" Z\";\n        el(\"path\", { d, fill: \"#a9cbb8\", stroke: \"none\", transform: `translate(0 4)` }, pondG);\n        el(\"path\", { d, fill: \"#5e9ea0\", stroke: \"#2f6164\", \"stroke-width\": 2.4 }, pondG);\n        el(\"path\", { d: `M ${f(c[0] - 40)} ${f(c[1] - 8)} Q ${f(c[0] - 10)} ${f(c[1] - 18)} ${f(c[0] + 26)} ${f(c[1] - 12)}`, fill: \"none\", stroke: \"#8fc0c0\", \"stroke-width\": 3, \"stroke-linecap\": \"round\" }, pondG);\n        for (const [dx, dy] of [[-84, -6], [-76, 12], [80, 4], [70, -16]]) line(pondG, `M ${f(c[0] + dx)} ${f(c[1] + dy)} l -2 -12 M ${f(c[0] + dx + 4)} ${f(c[1] + dy)} l 1 -14 M ${f(c[0] + dx + 8)} ${f(c[1] + dy)} l 3 -10`, 1.5, \"#5f7a45\");\n      }\n      for (const [du, dv, s] of [[-96, -22, 0.95], [96, 28, 0.9], [70, -36, 0.8]]) pops.pond.push(place(...at(byName.pond, du, dv), tree(s)));\n\n      // environment conifers (the world around, there from the start)\n      const envTrees = [];\n      for (const [x0, y0, n, sx, sy] of [[300, 236, 9, 130, 70], [-10, 150, 6, 70, 170], [880, 300, 8, 150, 80], [150, 840, 7, 150, 60], [960, 780, 5, 90, 70]]) {\n        for (let i = 0; i < n; i++) envTrees.push(place(x0 + rnd() * sx, y0 + rnd() * sy, conifer(30 + rnd() * 18, 13 + rnd() * 4)));\n      }\n\n      // the walker starts at the first settlement\n      const wStart = at(center, -60, 34);\n      // the place lives on the outer group; GSAP moves only the inner one, which has no transform of its own\n      const walkerOuter = el(\"g\", { transform: `translate(${f(wStart[0])} ${f(wStart[1])})` });\n      walkerOuter.appendChild(walker);\n      objects.push({ y: wStart[1], outer: walkerOuter, pop: walker });\n\n      // back to front\n      objects.sort((a, b) => a.y - b.y).forEach((o) => L(\"l-objects\").appendChild(o.outer));\n\n      // ---------- dotted paths from the first hex to each new one ----------\n      const pathDots = {};\n      for (const [name] of order) {\n        const a = center.c, b = byName[name].c;\n        const len = Math.hypot(b[0] - a[0], b[1] - a[1]);\n        const dots = [];\n        for (let s = 44; s < len - 36; s += 13) {\n          const t = s / len;\n          dots.push(el(\"circle\", { cx: f(a[0] + (b[0] - a[0]) * t), cy: f(a[1] + (b[1] - a[1]) * t), r: 2.4, fill: \"#d49a4e\" }, L(\"l-flats\")));\n        }\n        pathDots[name] = dots;\n      }\n\n      // ---------- the village line: one outline around all seven ----------\n      const outline = [];\n      for (const d of ring1) for (const q of hexPts(d[0], d[1], R)) {\n        const dist = Math.hypot(q[0] - CX, (q[1] - CY) / SQ);\n        if (dist > 1.9 * R && !outline.some((o) => Math.hypot(o[0] - q[0], o[1] - q[1]) < 2)) outline.push(q);\n      }\n      outline.sort((a, b) => Math.atan2((a[1] - CY) / SQ, a[0] - CX) - Math.atan2((b[1] - CY) / SQ, b[0] - CX));\n      const bound = el(\"path\", { d: roundPath(scalePts(outline, [CX, CY], 1.035), 0.18), fill: \"none\", stroke: \"#d9a548\", \"stroke-width\": 4.5, \"stroke-linejoin\": \"round\" }, L(\"l-bound\"));\n      const boundGlow = el(\"path\", { d: roundPath(scalePts(outline, [CX, CY], 1.035), 0.18), fill: \"none\", stroke: \"#f2d48f\", \"stroke-width\": 12, \"stroke-linejoin\": \"round\", opacity: 0 }, L(\"l-bound\"));\n      L(\"l-bound\").insertBefore(boundGlow, bound);\n\n      // ---------- resources moving between the hexes: the village working as one ----------\n      const tokenColors = { wind: \"#e8b84a\", solar: \"#e8b84a\", quarry: \"#b9b6ae\", pond: \"#5e9fc9\", timber: \"#9c6b45\", forest: \"#d9663f\" };\n      const tokens = [];\n      order.forEach(([name], k) => {\n        for (let trip = 0; trip < 2; trip++) {\n          const from = byName[name].c;\n          const tk = el(\"circle\", { cx: f(from[0]), cy: f(from[1]), r: 6.5, fill: tokenColors[name], stroke: INK, \"stroke-width\": 1.4, opacity: 0 }, L(\"l-tokens\"));\n          tokens.push({ tk, dx: CX - from[0], dy: CY - from[1], k, trip });\n        }\n      });\n\n      // ---------- review copy: subtitles only when asked ----------\n      let subsOn = false;\n      try { subsOn = !!(window.__hyperframes && window.__hyperframes.getVariables().subs); } catch (e) {}\n      if (!subsOn) L(\"subs\").remove();\n\n      // ---------- one paused timeline ----------\n      const tl = gsap.timeline({ paused: true });\n      const cam = L(\"cam\");\n      const camAt = (s, fx, fy) => ({ scale: s, x: 540 - s * fx, y: 540 - s * fy });\n      const camKeys = [\n        [0, camAt(0.64, 575, 560)],\n        [1.9, camAt(0.7, 575, 560), \"sine.inOut\"],\n        [3.1, camAt(1.62, 590, 560), \"power3.inOut\"],\n        [4.85, camAt(1.72, 585, 556), \"sine.inOut\"],\n        [5.85, camAt(0.97, 575, 548), \"power3.inOut\"],\n        [8.4, camAt(1.03, 575, 548), \"sine.inOut\"],\n        [9.3, camAt(0.9, 575, 545), \"power2.inOut\"],\n        [10, camAt(0.88, 575, 545), \"none\"],\n      ];\n      gsap.set(cam, Object.assign({ transformOrigin: \"0 0\" }, camKeys[0][1]));\n      for (let i = 1; i < camKeys.length; i++) {\n        const [t0, a] = camKeys[i - 1], [t1, b, ease] = camKeys[i];\n        tl.fromTo(cam, Object.assign({}, a), Object.assign({ duration: t1 - t0, ease, immediateRender: false }, b), t0);\n      }\n\n      // 0–2 s: \"How small can a city start?\" the empty grid, ring by ring\n      tl.fromTo(ghosts.c, { opacity: 0 }, { opacity: 1, duration: 0.4, ease: \"power1.out\" }, 0.05);\n      tl.fromTo(ghosts.r1, { opacity: 0 }, { opacity: 1, duration: 0.45, stagger: 0.05, ease: \"power1.out\" }, 0.25);\n      tl.fromTo(ghosts.r2, { opacity: 0 }, { opacity: 1, duration: 0.45, stagger: 0.035, ease: \"power1.out\" }, 0.5);\n\n      // 2–5 s: \"One hex.\" everything else goes, the first plot is claimed and a settlement stands\n      tl.fromTo(ghosts.r2, { opacity: 1 }, { opacity: 0, duration: 0.35, stagger: 0.015, ease: \"power1.in\", immediateRender: false }, 1.85);\n      tl.fromTo(ghosts.r1, { opacity: 1 }, { opacity: 0, duration: 0.35, stagger: 0.02, ease: \"power1.in\", immediateRender: false }, 2.0);\n      tl.fromTo(center.g, { opacity: 0, scale: 0.85, transformOrigin: \"50% 50%\" }, { opacity: 1, scale: 1, duration: 0.45, ease: \"back.out(1.6)\" }, 2.15);\n      tl.fromTo(ghosts.c, { opacity: 1 }, { opacity: 0, duration: 0.25, immediateRender: false }, 2.25);\n      const goldLen = center.gold.getTotalLength();\n      center.gold.style.strokeDasharray = goldLen;\n      tl.fromTo(center.gold, { opacity: 1, strokeDashoffset: goldLen }, { strokeDashoffset: 0, duration: 0.6, ease: \"power2.inOut\" }, 2.35);\n      const popIn = (els, t, stagger = 0.08, dur = 0.45) =>\n        tl.fromTo(els, { scale: 0, opacity: 0, transformOrigin: \"50% 100%\" }, { scale: 1, opacity: 1, duration: dur, ease: \"back.out(1.9)\", stagger }, t);\n      popIn(pops.center.slice(0, 3), 2.62, 0.2);\n      popIn(pops.center.slice(3, 8), 3.05, 0.07);\n      popIn(pops.center.slice(8), 3.35);\n      popIn([walker], 3.55, 0, 0.35);\n      tl.fromTo(walker, { x: 0, y: 0 }, { x: 54, y: 18, duration: 1.25, ease: \"none\" }, 3.65);\n      tl.fromTo(walkerBob, { y: 0 }, { y: -2.2, duration: 0.15, ease: \"sine.inOut\", yoyo: true, repeat: 7 }, 3.65);\n\n      // the HUD arrives with the first settlement\n      tl.fromTo(\"#pill\", { y: -100, opacity: 0 }, { y: 0, opacity: 1, duration: 0.55, ease: \"power3.out\" }, 2.4);\n      tl.fromTo(\"#speed\", { y: -100, opacity: 0 }, { y: 0, opacity: 1, duration: 0.55, ease: \"power3.out\" }, 2.5);\n      const count = (id, from, to, t, dur) =>\n        // never rendered ahead of its time: a later segment must not write its start value at build time\n        tl.fromTo(\"#\" + id, { innerText: from }, { innerText: to, snap: { innerText: 1 }, duration: dur, ease: \"none\", immediateRender: false }, t);\n      count(\"n-people\", 0, 12, 2.75, 0.9);\n\n      // 5–8.5 s: \"Add six…\" pull back; the six plots join one after another, each with its work\n      const lands = { wind: 5.1, solar: 5.4, quarry: 5.7, pond: 6.0, timber: 6.3, forest: 6.6 };\n      for (const [name] of order) {\n        const p = byName[name], t = lands[name];\n        const back = [(CX - p.c[0]) * 0.45, (CY - p.c[1]) * 0.45];\n        tl.fromTo(p.g, { opacity: 0, scale: 0.55, x: back[0], y: back[1], transformOrigin: \"50% 50%\" }, { opacity: 1, scale: 1, x: 0, y: 0, duration: 0.55, ease: \"power3.out\" }, t);\n        tl.fromTo(p.gold, { opacity: 0 }, { opacity: 1, duration: 0.15 }, t + 0.25);\n        tl.fromTo(p.gold, { opacity: 1 }, { opacity: 0, duration: 0.5, immediateRender: false }, t + 0.75);\n        tl.fromTo(pathDots[name], { scale: 0, opacity: 0, transformOrigin: \"50% 50%\" }, { scale: 1, opacity: 1, duration: 0.14, stagger: 0.022, ease: \"back.out(2)\" }, t + 0.15);\n        popIn(pops[name], t + 0.3, name === \"forest\" ? 0.035 : 0.06, 0.42);\n      }\n      tl.fromTo(pondG, { opacity: 0, scale: 0.3, transformOrigin: \"50% 50%\" }, { opacity: 1, scale: 1, duration: 0.5, ease: \"back.out(1.5)\" }, 6.25);\n\n      // the blades turn from the moment they stand\n      blades.forEach((b, i) => tl.fromTo(b, { rotation: i * 37, transformOrigin: \"50% 50%\" }, { rotation: i * 37 + 520, duration: 10 - 5.4, ease: \"none\" }, 5.4));\n\n      // the river draws itself in along the west\n      for (const r of [riverBank, riverWater, riverLight]) {\n        const len = r.getTotalLength();\n        r.style.strokeDasharray = len;\n        tl.fromTo(r, { strokeDashoffset: len }, { strokeDashoffset: 0, duration: 1.5, ease: \"power2.inOut\" }, 6.0);\n      }\n\n      // the counters climb as each joins, then together\n      count(\"n-energy\", 0, 3, 5.4, 0.35);\n      count(\"n-energy\", 3, 9, 5.75, 0.35);\n      count(\"n-stone\", 0, 8, 6.0, 0.35);\n      count(\"n-water\", 0, 6, 6.3, 0.35);\n      count(\"n-wood\", 0, 12, 6.6, 0.35);\n      count(\"n-food\", 0, 10, 6.9, 0.35);\n      count(\"n-people\", 12, 84, 5.2, 3.2);\n      count(\"n-energy\", 9, 16, 7.1, 1.3);\n      count(\"n-stone\", 8, 15, 7.1, 1.3);\n      count(\"n-water\", 6, 11, 7.1, 1.3);\n      count(\"n-wood\", 12, 24, 7.1, 1.3);\n      count(\"n-food\", 10, 22, 7.3, 1.1);\n      count(\"n-coins\", 0, 7, 7.3, 1.1);\n\n      // and resources travel to the heart of it\n      tokens.forEach(({ tk, dx, dy, k, trip }) => {\n        const t = 6.95 + k * 0.11 + trip * 0.72;\n        tl.fromTo(tk, { x: 0, y: 0 }, { x: dx, y: dy, duration: 0.8, ease: \"sine.inOut\" }, t);\n        tl.fromTo(tk, { opacity: 0 }, { opacity: 1, duration: 0.12 }, t);\n        tl.fromTo(tk, { opacity: 1 }, { opacity: 0, duration: 0.14, immediateRender: false }, t + 0.66);\n      });\n      tl.fromTo(walker, { x: 54, y: 18 }, { x: 170, y: 72, duration: 1.6, ease: \"none\", immediateRender: false }, 6.8);\n      tl.fromTo(walkerBob, { y: 0 }, { y: -2.2, duration: 0.16, ease: \"sine.inOut\", yoyo: true, repeat: 9, immediateRender: false }, 6.8);\n\n      // 8.5–10 s: \"7 hexes = 1 village\" one line around all seven\n      const bLen = bound.getTotalLength();\n      bound.style.strokeDasharray = bLen;\n      tl.fromTo(bound, { strokeDashoffset: bLen, opacity: 1 }, { strokeDashoffset: 0, duration: 0.85, ease: \"power2.inOut\" }, 8.45);\n      tl.fromTo(boundGlow, { opacity: 0 }, { opacity: 0.55, duration: 0.3, ease: \"power1.out\" }, 9.2);\n      tl.fromTo(boundGlow, { opacity: 0.55 }, { opacity: 0.2, duration: 0.4, ease: \"power1.in\", immediateRender: false }, 9.5);\n      tl.fromTo(center.gold, { opacity: 1 }, { opacity: 0, duration: 0.4, immediateRender: false }, 8.5);\n\n      // out to cream, so the loop starts where it ends\n      tl.fromTo(\"#fade\", { opacity: 0 }, { opacity: 1, duration: 0.45, ease: \"power1.in\" }, 9.55);\n\n      window.__timelines[\"main\"] = tl;\n      tl.seek(0);\n    </script>\n  </body>\n</html>\n"}
