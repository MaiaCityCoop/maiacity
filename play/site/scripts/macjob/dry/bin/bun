#!/usr/bin/env bash
# The dry run's `bun` (intent cb52fbd9): `bun install` in a job's tree links this checkout's node_modules (as the census
# does for `--at`); a script, bun with the CPU page for playwright; everything else is bun.
if [ "${1:-}" = install ] || [ "${1:-}" = i ]; then
  [ -e node_modules ] || ln -s "$DRY_SITE/node_modules" node_modules
  exit 0
fi
# a script run by bun (a .ts or .js file) gets the CPU page for playwright, as `node` gives it (../preload.ts)
case "${1:-}" in *.ts|*.js|*.mjs) exec "$DRY_BUN" --preload "$DRY_HOME/preload.ts" "$@" ;; esac
exec "$DRY_BUN" "$@"
