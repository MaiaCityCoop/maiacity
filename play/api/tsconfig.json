{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": ["bun"]
  },
  "include": ["src", "import", "migrations", "test"],
  "exclude": ["import/legacy/sources"]
}
