{
  "label": "Schema",
  "type": "schema",
  "name": "schema/1",
  "note": "The meta-schema: what every schema is, itself included (play/SPEC.md \"Version control\"). A schema names the documents it describes by their id's prefix (`type`), keeps its old name (`name`, only shown) and its `node`: the JSON Schema subset play validates every edit against, with Loro's hints (\"x-loro\": \"text\").",
  "node": {
    "type": "object",
    "required": ["label", "type", "name", "node"],
    "properties": {
      "label": { "type": "string", "minLength": 1, "maxLength": 200 },
      "type": { "type": "string", "pattern": "^[a-z][a-z_]{0,31}$" },
      "name": { "type": "string", "minLength": 1, "maxLength": 100 },
      "note": { "type": "string", "maxLength": 20000, "x-loro": "text" },
      "node": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["object", "array", "string", "number", "integer", "boolean", "null"] },
          "enum": { "type": "array", "minItems": 1, "maxItems": 1000 },
          "properties": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": true } },
          "required": { "type": "array", "maxItems": 1000, "items": { "type": "string" } },
          "items": { "type": "object", "additionalProperties": true },
          "minItems": { "type": "integer", "minimum": 0 },
          "maxItems": { "type": "integer", "minimum": 0 },
          "minimum": { "type": "number" },
          "maximum": { "type": "number" },
          "minLength": { "type": "integer", "minimum": 0 },
          "maxLength": { "type": "integer", "minimum": 0 },
          "pattern": { "type": "string", "maxLength": 1000 },
          "x-loro": { "type": "string", "enum": ["text"] }
        },
        "additionalProperties": true
      }
    },
    "additionalProperties": false
  }
}
