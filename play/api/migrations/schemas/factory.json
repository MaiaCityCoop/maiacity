{
  "label": "Factory",
  "type": "factory",
  "name": "factory/1",
  "note": "A production line and its bill of process (play/SPEC.md §4.7).",
  "node": {
    "type": "object",
    "required": [
      "schema",
      "label",
      "line",
      "parts"
    ],
    "properties": {
      "schema": {
        "const": "factory/1"
      },
      "label": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "note": {
        "type": "string",
        "maxLength": 20000,
        "x-loro": "text"
      },
      "from": {
        "type": "string",
        "maxLength": 2000
      },
      "builds": {
        "type": "string",
        "maxLength": 200
      },
      "line": {
        "type": "object",
        "required": [
          "product",
          "demand",
          "calendar",
          "stations"
        ],
        "properties": {
          "product": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": true
          },
          "demand": {
            "type": "object",
            "required": [
              "perDay"
            ],
            "properties": {
              "perDay": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": true
          },
          "calendar": {
            "type": "object",
            "additionalProperties": true
          },
          "stations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "machine"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "machine": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
                },
                "ct": {
                  "type": "number",
                  "minimum": 0
                },
                "cv": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                },
                "buffer": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "reserve": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "operators": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "yield": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "after": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
                  }
                },
                "what": {
                  "type": "string",
                  "maxLength": 4000
                },
                "rate": {
                  "type": "string",
                  "maxLength": 4000
                }
              },
              "additionalProperties": true
            }
          },
          "stages": {
            "type": "object",
            "additionalProperties": true
          },
          "layout": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "stock": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": [
            "label"
          ],
          "additionalProperties": true
        }
      },
      "assemblies": {
        "type": "array",
        "maxItems": 200,
        "items": {
          "type": "object",
          "required": [
            "id",
            "label"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
            },
            "label": {
              "type": "string",
              "maxLength": 200
            }
          },
          "additionalProperties": true
        }
      },
      "parts": {
        "type": "array",
        "maxItems": 5000,
        "items": {
          "type": "object",
          "required": [
            "id",
            "label",
            "qty",
            "ops"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "assembly": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
            },
            "qty": {
              "type": "number",
              "minimum": 0
            },
            "raw": {
              "type": "object",
              "additionalProperties": true
            },
            "ops": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "object",
                "required": [
                  "at",
                  "s"
                ],
                "properties": {
                  "at": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
                  },
                  "s": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10000000
                  },
                  "what": {
                    "type": "string",
                    "maxLength": 2000
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      },
      "handling": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": [
              "at",
              "s"
            ],
            "properties": {
              "at": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
              },
              "s": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000000
              },
              "what": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "additionalProperties": true
  }
}
