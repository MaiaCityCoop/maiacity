{
  "label": "Rules",
  "type": "rules",
  "name": "rules/1",
  "note": "The auto-accept rules (play/SPEC.md §4.12 \"Auto-accept rules\", intent de24f1c5, Samuel 2026-11-07): the rules in order, the first that matches an intent at a gate it names deciding it there with no person. A rule names only the fields below, each a condition that holds or doesn't; at approve the accept fields are not looked at. An intent whose work changes the rules or this schema is never matched (play/api/src/rules.ts): the rules are always a person's.",
  "node": {
    "type": "object",
    "required": ["schema", "label", "rules"],
    "properties": {
      "schema": { "const": "rules/1" },
      "label": { "type": "string", "minLength": 1, "maxLength": 200 },
      "note": { "type": "string", "maxLength": 20000, "x-loro": "text" },
      "rules": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": ["id", "label", "gates", "match", "reason"],
          "properties": {
            "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "label": { "type": "string", "minLength": 1, "maxLength": 200 },
            "gates": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "enum": ["approve", "accept"] } },
            "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "match": {
              "type": "object",
              "properties": {
                "kind": { "type": "array", "minItems": 1, "items": { "enum": ["idea", "fix", "improve"] } },
                "via": { "type": "array", "minItems": 1, "items": { "enum": ["web", "mcp"] } },
                "author": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" } },
                "work_kind": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|code)$" } },
                "proposed_by": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" } },
                "proposed_via": { "type": "array", "minItems": 1, "items": { "enum": ["web", "mcp"] } },
                "schemas": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" } },
                "code": { "type": "boolean" },
                "new_only": { "type": "boolean" },
                "max_documents": { "type": "integer", "minimum": 0 },
                "max_edits": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  }
}
