# avenBOX's PostgreSQL, said once: setup.sh, up.sh and gate.sh source it, and so does play-checks.yml for CI's
# container; intent.ts reads BOX_DATABASE_URL from the checkout it runs the checks in (its --root).
# shellcheck shell=bash disable=SC2034
PG_VERSION=17
PG_PORT=5432
PG_PASSWORD=play
# room for the API's tests in parallel (intent aa59f248): each test file's pool and each play-api a test starts take up
# to 20 connections, and 100 (the default) left a play-api started by a test without one ("too many clients")
PG_MAX_CONNECTIONS=500
BOX_DATABASE_URL=postgres://postgres:$PG_PASSWORD@127.0.0.1:$PG_PORT/postgres
